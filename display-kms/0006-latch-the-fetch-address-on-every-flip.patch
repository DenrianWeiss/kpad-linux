@@ -472,12 +491,42 @@ static void sample_video(struct turner_host *ctx, const struct drm_display_mode
 			k->retiring = -1;
 			if (k->pending >= 0) {
 				const dma_addr_t *next = k->slot[k->pending].addr;
+
+				/* The OEM writes the 34-bit address as low word plus the
+				 * four high bits on every frame; the high write makes the
+				 * new fetch address take effect.
+				 */
 				writel(lower_32_bits(next[0]), path->block[FETCH_L].base+0xf40);
-				writel(lower_32_bits(next[1]+TURNER_RIGHT_X*sizeof(u32)), path->block[FETCH_R].base+0xf40);
+				writel(GENMASK(3, 0) & upper_32_bits(next[0]),
