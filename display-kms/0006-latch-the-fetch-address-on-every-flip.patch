@@ -499,6 +548,17 @@ static void sample_video(struct turner_host *ctx, const struct drm_display_mode
 			dev_notice(ctx->host.dev, "paired scan frames=%u/%u backlight enabled=%u\n",
 				   frame[0], frame[1], panel->enabled);
 		}
+		if (ktime_to_ms(ktime_get()) - last_status >= 2000) {
