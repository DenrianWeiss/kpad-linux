+#include <drm/drm_probe_helper.h>
+#include <drm/drm_vblank.h>
+#include <drm/drm_vblank_helper.h>
+
+struct turner_slot {
+	void *cpu;
+	dma_addr_t addr[2];
+	struct sg_table table;
+	bool mapped;
+};
+struct turner_kms {
+	struct drm_device drm;
+	struct drm_plane plane;
+	struct drm_crtc crtc;
+	struct drm_encoder encoder;
+	struct drm_connector connector;
+	struct turner_slot slot[2];
+	struct device *right;
+	struct mutex flip_lock;
+	wait_queue_head_t flip_wait;
+	int front, pending, retiring;
+	bool running, finished;
+	struct work_struct shutdown;
+	unsigned int hz;
+	unsigned int sequence;
+};
+
+#define TURNER_PITCH (1880U * 4)
+#define TURNER_BYTES (TURNER_PITCH * 3008U)
+static inline struct turner_kms *to_kms(struct drm_device *drm)
+{
+	return container_of(drm, struct turner_kms, drm);
+}
+
+static int turner_plane_check(struct drm_plane *plane, struct drm_atomic_commit *state)
+{
+	struct drm_plane_state *ps = drm_atomic_get_new_plane_state(state, plane);
+	struct drm_crtc_state *cs = ps->crtc ? drm_atomic_get_new_crtc_state(state, ps->crtc) : NULL;
+
+	if (ps->fb && (ps->src_x || ps->src_y || ps->fb->width != 1880 || ps->fb->height != 3008))
+		return -EINVAL;
+	return drm_atomic_helper_check_plane_state(ps, cs, DRM_PLANE_NO_SCALING,
+						  DRM_PLANE_NO_SCALING, false, false);
+}
+
+static void turner_plane_update(struct drm_plane *plane, struct drm_atomic_commit *state)
+{
+	struct turner_kms *kms = to_kms(plane->dev);
+	struct drm_plane_state *ps = drm_atomic_get_new_plane_state(state, plane);
+	struct drm_shadow_plane_state *shadow = to_drm_shadow_plane_state(ps);
+	struct drm_framebuffer *fb = ps->fb;
+	unsigned int y;
+	int idx, back;
+	struct turner_slot *slot;
+
+	if (!fb || !ps->visible || !drm_dev_enter(plane->dev, &idx))
+		return;
+	mutex_lock(&kms->flip_lock);
+	while (kms->pending >= 0 || kms->retiring >= 0) {
+		mutex_unlock(&kms->flip_lock);
+		if (!wait_event_timeout(kms->flip_wait,
+					READ_ONCE(kms->pending) < 0 && READ_ONCE(kms->retiring) < 0,
+					msecs_to_jiffies(500))) {
+			drm_err(plane->dev, "scan buffer retirement timed out\n");
+			goto out;
+		}
+		mutex_lock(&kms->flip_lock);
+	}
+	back = 1 - kms->front;
+	slot = &kms->slot[back];
+	if (!drm_gem_fb_begin_cpu_access(fb, DMA_FROM_DEVICE)) {
+		dma_sync_sgtable_for_cpu(kms->right, &slot->table, DMA_TO_DEVICE);
+		for (y = 0; y < 3008; y++)
+			iosys_map_memcpy_from(slot->cpu + y * TURNER_PITCH, &shadow->data[0],
+					      y * fb->pitches[0], TURNER_PITCH);
+		dma_wmb();
+		dma_sync_sgtable_for_device(kms->right, &slot->table, DMA_TO_DEVICE);
+		drm_gem_fb_end_cpu_access(fb, DMA_FROM_DEVICE);
+		if (kms->running)
+			kms->pending = back;
+		else
+			kms->front = back;
+		WRITE_ONCE(kms->sequence, kms->sequence + 1);
+	}
+	mutex_unlock(&kms->flip_lock);
+out:
+	drm_dev_exit(idx);
+}
+
+static const struct drm_plane_funcs turner_plane_funcs = {
+	.update_plane = drm_atomic_helper_update_plane,
+	.disable_plane = drm_atomic_helper_disable_plane,
+	.destroy = drm_plane_cleanup,
+	DRM_GEM_SHADOW_PLANE_FUNCS
+};
+static const struct drm_plane_helper_funcs turner_plane_helpers = {
+	DRM_GEM_SHADOW_PLANE_HELPER_FUNCS,
+	.atomic_check = turner_plane_check,
+	.atomic_update = turner_plane_update,
+};
