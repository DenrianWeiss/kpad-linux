@@ -0,0 +1,274 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6991_DSI_CMDQ_H
+#define MT6991_DSI_CMDQ_H
+
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/unaligned.h>
+#include <drm/drm_mipi_dsi.h>
+#include <video/mipi_display.h>
+
+#define MT6991_DSI_RX_BYTES	10
+
+static inline bool mt6991_dsi_is_read(u8 type)
+{
+	return type == MIPI_DSI_DCS_READ ||
+	       type == MIPI_DSI_GENERIC_READ_REQUEST_0_PARAM ||
+	       type == MIPI_DSI_GENERIC_READ_REQUEST_1_PARAM ||
+	       type == MIPI_DSI_GENERIC_READ_REQUEST_2_PARAM;
+}
+
+/* CPU command queue, while the host is idle in command mode.
+ * The caller holds the host lock, supplies the verified queue capacity,
+ * and owns start, completion and restoration of the video stream.
+ */
+static inline int mt6991_dsi_queue_write(void __iomem *regs, unsigned int capacity,
+					 const struct mipi_dsi_msg *msg)
+{
+	const u8 *data = msg->tx_buf;
+	void __iomem *queue = regs + 0x400;
+	size_t len = msg->tx_len, offset;
+	u32 header, value, size;
+
+	if (msg->channel || (msg->flags & ~MIPI_DSI_MSG_USE_LPM))
+		return -EOPNOTSUPP;
+	if (mt6991_dsi_is_read(msg->type) != !!msg->rx_len ||
+	    (msg->rx_len && !msg->rx_buf))
+		return -EINVAL;
+	if (len && !data)
+		return -EINVAL;
+	switch (msg->type) {
+	case MIPI_DSI_GENERIC_READ_REQUEST_0_PARAM:
+	case MIPI_DSI_GENERIC_SHORT_WRITE_0_PARAM:
+		if (len)
+			return -EINVAL;
+		break;
+	case MIPI_DSI_GENERIC_READ_REQUEST_1_PARAM:
+	case MIPI_DSI_DCS_READ:
+	case MIPI_DSI_GENERIC_SHORT_WRITE_1_PARAM:
+	case MIPI_DSI_DCS_SHORT_WRITE:
+		if (len != 1)
+			return -EINVAL;
+		break;
+	case MIPI_DSI_GENERIC_READ_REQUEST_2_PARAM:
+	case MIPI_DSI_SET_MAXIMUM_RETURN_PACKET_SIZE:
+	case MIPI_DSI_GENERIC_SHORT_WRITE_2_PARAM:
+	case MIPI_DSI_DCS_SHORT_WRITE_PARAM:
+		if (len != 2)
+			return -EINVAL;
+		break;
+	case MIPI_DSI_DCS_LONG_WRITE:
+	case MIPI_DSI_GENERIC_LONG_WRITE:
+		if (len < 3)
+			return -EINVAL;
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+
+	/* One header and at most 254 payload words fit the size field. */
+	if (len > 254 * 4)
+		return -EMSGSIZE;
+	size = len > 2 ? 1 + DIV_ROUND_UP(len, 4) : 1;
+	if (size > capacity)
+		return -EMSGSIZE;
+
+	header = (msg->type << 8) | (msg->rx_len ? BIT(2) : 0);
+	if (len <= 2) {
+		if (len)
+			header |= (u32)data[0] << 16;
+		if (len == 2)
+			header |= (u32)data[1] << 24;
+	} else {
+		header |= (len << 16) | BIT(1);
+		for (offset = 0; offset + 4 <= len; offset += 4)
+			writel(get_unaligned_le32(data + offset), queue + 4 + offset);
+		if (offset < len) {
+			void __iomem *tail = queue + 4 + offset;
+			unsigned int shift = 0;
+
+			value = readl(tail);
+			while (offset < len) {
+				value &= ~(0xffU << shift);
+				value |= (u32)data[offset++] << shift;
+				shift += 8;
+			}
+			writel(value, tail);
+		}
+	}
+	writel(header, queue);
+	value = readl(regs + 0x44);
+	value = (value & ~0xffU) | size;
+	writel(value, regs + 0x44);
+	writel(value | BIT(15), regs + 0x44);
+	return 0;
+}
+/* MT6991 uses the four direct RX words at 0xa4, without RX SRAM banking. */
+static inline ssize_t mt6991_dsi_copy_response(void __iomem *regs,
+					       const struct mipi_dsi_msg *msg)
+{
+	u8 type = readb(regs + 0xa4);
+	bool dcs = msg->type == MIPI_DSI_DCS_READ;
+	unsigned int skip = 1;
+	size_t len, i;
+
+	switch (type) {
+	case MIPI_DSI_RX_GENERIC_SHORT_READ_RESPONSE_1BYTE:
+	case MIPI_DSI_RX_DCS_SHORT_READ_RESPONSE_1BYTE:
+		len = 1;
+		break;
+	case MIPI_DSI_RX_GENERIC_SHORT_READ_RESPONSE_2BYTE:
+	case MIPI_DSI_RX_DCS_SHORT_READ_RESPONSE_2BYTE:
+		len = 2;
+		break;
+	case MIPI_DSI_RX_DCS_LONG_READ_RESPONSE:
+	case MIPI_DSI_RX_GENERIC_LONG_READ_RESPONSE:
+		len = readb(regs + 0xa5) | (readb(regs + 0xa6) << 8);
+		if (!len || len > MT6991_DSI_RX_BYTES)
+			return -EPROTO;
+		skip = 4;
+		break;
+	default:
+		return -EPROTO;
+	}
+	if (dcs != (type == MIPI_DSI_RX_DCS_SHORT_READ_RESPONSE_1BYTE ||
+		    type == MIPI_DSI_RX_DCS_SHORT_READ_RESPONSE_2BYTE ||
+		    type == MIPI_DSI_RX_DCS_LONG_READ_RESPONSE))
+		return -EPROTO;
+	len = min(len, msg->rx_len);
+	for (i = 0; i < len; i++)
+		((u8 *)msg->rx_buf)[i] = readb(regs + 0xa4 + skip + i);
+	return len;
+}
+
+/* The caller has already configured the PHY, clocks and command mode.
+ * Polling owns the read-ready event; an IRQ handler must not consume it.
+ */
+static inline ssize_t mt6991_dsi_submit(void __iomem *regs, unsigned int capacity,
+					const struct mipi_dsi_msg *msg)
+{
+	u32 status;
+	int ret, ready = 0;
+
+	ret = readl_poll_timeout(regs + 0x0c, status, !(status & BIT(31)), 1, 100000);
+	if (ret)
+		return ret;
+	ret = mt6991_dsi_queue_write(regs, capacity, msg);
+	if (ret)
+		return ret;
+	if (msg->rx_len && (status & BIT(0)))
+		writel(status & ~BIT(0), regs + 0x0c);
+	writel(0, regs);
+	writel(1, regs);
+	writel(0, regs);
+	if (msg->rx_len) {
+		ready = readl_poll_timeout(regs + 0x0c, status, status & BIT(0), 100, 100000);
+		writel(status & ~BIT(0), regs + 0x0c);
+		writel(readl(regs + 0xb4) | BIT(0), regs + 0xb4);
+	}
+	ret = readl_poll_timeout(regs + 0x0c, status, !(status & BIT(31)), 1, 100000);
+	if (ready || ret)
+		return -ETIMEDOUT;
+	if (msg->rx_len)
+		return mt6991_dsi_copy_response(regs, msg);
+	return msg->tx_len;
+}
+
+static inline int mt6991_dsi_set_return_size(void __iomem *regs, unsigned int capacity,
+					    const struct mipi_dsi_msg *msg)
+{
+	u8 size[2] = { msg->rx_len, 0 };
+	struct mipi_dsi_msg limit = {
+		.type = MIPI_DSI_SET_MAXIMUM_RETURN_PACKET_SIZE,
+		.flags = msg->flags, .tx_len = sizeof(size), .tx_buf = size,
+	};
+	size_t params = msg->type == MIPI_DSI_DCS_READ ? 1 : msg->type >> 4;
+	ssize_t ret;
+
+	if (msg->channel || (msg->flags & ~MIPI_DSI_MSG_USE_LPM))
+		return -EOPNOTSUPP;
+	if (!msg->rx_len || !msg->rx_buf || msg->tx_len != params ||
+	    (params && !msg->tx_buf))
+		return -EINVAL;
+	if (msg->rx_len > MT6991_DSI_RX_BYTES)
+		return -EMSGSIZE;
+	ret = mt6991_dsi_submit(regs, capacity, &limit);
+	return ret < 0 ? ret : 0;
+}
+
+static inline ssize_t mt6991_dsi_host_transfer(void __iomem *regs, unsigned int capacity,
+					       const struct mipi_dsi_msg *msg)
+{
+	if (mt6991_dsi_is_read(msg->type)) {
+		int ret = mt6991_dsi_set_return_size(regs, capacity, msg);
+
+		if (ret)
+			return ret;
+	}
+	return mt6991_dsi_submit(regs, capacity, msg);
+}
+
+/* Turner routes panel commands to both halves with one primary START.
+ * SET_MAXIMUM_RETURN_PACKET_SIZE and the returned RX words use the primary.
+ * Both hosts must be powered, in command mode, and exclusively owned.
+ */
+static inline ssize_t mt6991_dsi_dual_transfer(void __iomem *primary,
+				void __iomem *secondary, unsigned int capacity,
+				const struct mipi_dsi_msg *msg)
+{
+	bool read = mt6991_dsi_is_read(msg->type);
+	u32 status, control;
+	int ret;
+
+	if (read) {
+		ret = mt6991_dsi_set_return_size(primary, capacity, msg);
+		if (ret < 0)
+			return ret;
+	}
+	ret = readl_poll_timeout(primary + 0xc, status, !(status & BIT(31)), 1, 100000);
+	if (ret)
+		return ret;
+	ret = readl_poll_timeout(secondary + 0xc, status, !(status & BIT(31)), 1, 100000);
+	if (ret)
+		return ret;
+	ret = mt6991_dsi_queue_write(primary, capacity, msg);
+	if (ret)
+		return ret;
+	ret = mt6991_dsi_queue_write(secondary, capacity, msg);
+	if (ret)
+		return ret;
+	if (read) {
+		writel(readl(primary + 0xc) & ~BIT(0), primary + 0xc);
+		writel(readl(secondary + 0xc) & ~BIT(0), secondary + 0xc);
+	}
+	control = readl(secondary + 0x30);
+	writel(control | BIT(4), secondary + 0x30);
+	writel(0, primary);
+	writel(1, primary);
+	writel(0, primary);
+	if (read) {
+		void __iomem *ports[] = { primary, secondary };
+		unsigned int i;
+
+		/* Both receivers must release the return bus before testing BUSY. */
+		for (i = 0; i < ARRAY_SIZE(ports); i++) {
+			void __iomem *port = ports[i];
+			int ready = readl_poll_timeout(port + 0xc, status, status & BIT(0),
+						       100, 100000);
+
+			writel(status & ~BIT(0), port + 0xc);
+			writel(readl(port + 0xb4) | BIT(0), port + 0xb4);
+			if (ready)
+				ret = ready;
+		}
+	}
+	if (!ret)
+		ret = readl_poll_timeout(primary + 0xc, status, !(status & BIT(31)), 1, 100000);
+	if (!ret)
+		ret = readl_poll_timeout(secondary + 0xc, status, !(status & BIT(31)), 1, 100000);
+	writel(control, secondary + 0x30);
+	if (ret)
+		return ret;
+	return read ? mt6991_dsi_copy_response(primary, msg) : (ssize_t)msg->tx_len;
+}
+#endif
--- /dev/null
+++ b/drivers/gpu/drm/mediatek/turner/mt6991-dsi-size.h
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#ifndef MT6991_DSI_SIZE_H
+#define MT6991_DSI_SIZE_H
+
+#include <linux/bitfield.h>
+#include <linux/io.h>
+#include <drm/display/drm_dsc.h>
+#include <drm/drm_modes.h>
+
+#define MT6991_DSI_PSCTRL	0x3c
+#define MT6991_DSI_SIZE_CON	0x2c
+#define MT6991_DSI_VACT_NL	0x6c
+#define MT6991_DSI_PS_WC	GENMASK(14, 0)
+#define MT6991_DSI_PS_SEL	GENMASK(19, 16)
+
+/* Program one idle host in full-frame dual-link DSC video mode. */
+static inline int mt6991_dsi_dual_dsc_size(void __iomem *regs,
+					   const struct drm_dsc_config *dsc)
+{
+	u32 count, bytes, ctrl;
+
+	if (!dsc->pic_height || !dsc->slice_count || dsc->slice_count % 2 ||
+	    !dsc->slice_chunk_size || !dsc->slice_width ||
+	    dsc->slice_width * dsc->slice_count != dsc->pic_width)
+		return -EINVAL;
+	count = dsc->slice_count / 2;
+	bytes = count * dsc->slice_chunk_size;
+	if (!FIELD_FIT(MT6991_DSI_PS_WC, bytes))
+		return -ERANGE;
+	ctrl = readl(regs + MT6991_DSI_PSCTRL);
+	ctrl &= ~(MT6991_DSI_PS_WC | MT6991_DSI_PS_SEL);
+	ctrl |= FIELD_PREP(MT6991_DSI_PS_WC, bytes) | FIELD_PREP(MT6991_DSI_PS_SEL, 5);
+	writel(dsc->pic_height, regs + MT6991_DSI_VACT_NL);
+	writel(ctrl, regs + MT6991_DSI_PSCTRL);
+	/* In DSC mode the input FIFO counts three compressed bytes per word. */
+	writel(((u32)dsc->pic_height << 16) | DIV_ROUND_UP(bytes, 3),
+	       regs + MT6991_DSI_SIZE_CON);
+	return 0;
+}
+
+/* Full-frame RGB888, D-PHY, sync-pulse video with static porch timings.
+ * Both links receive the same blanking intervals. Only DSC payload is split.
+ */
+static inline int mt6991_dsi_dual_dsc_timing(void __iomem *regs,
+					     const struct drm_display_mode *mode,
+					     const struct drm_dsc_config *dsc)
+{
+	u32 hsa, hbp, hfp;
+	int ret;
+
+	if (mode->hdisplay != dsc->pic_width || mode->vdisplay != dsc->pic_height ||
+	    mode->hdisplay >= mode->hsync_start || mode->hsync_start >= mode->hsync_end ||
+	    mode->hsync_end >= mode->htotal || mode->vdisplay > mode->vsync_start ||
+	    mode->vsync_start >= mode->vsync_end || mode->vsync_end > mode->vtotal)
+		return -EINVAL;
+
+	hsa = (mode->hsync_end - mode->hsync_start) * 3;
+	hbp = (mode->htotal - mode->hsync_end) * 3;
+	hfp = (mode->hsync_start - mode->hdisplay) * 3;
+	if (hsa < 10 || hbp < 10 || hfp < 12 ||
+	    hsa - 10 > 0x7fff || hbp - 10 > 0x7fff || hfp - 12 > 0x7fff)
+		return -ERANGE;
+
+	ret = mt6991_dsi_dual_dsc_size(regs, dsc);
+	if (ret)
+		return ret;
+
+	writel(mode->vsync_end - mode->vsync_start, regs + 0x60);
+	writel(mode->vtotal - mode->vsync_end, regs + 0x64);
+	writel(mode->vsync_start - mode->vdisplay, regs + 0x68);
+	writel(hsa - 10, regs + 0x80);
+	writel(hbp - 10, regs + 0x84);
+	writel(hfp - 12, regs + 0x88);
+	return 0;
+}
+
+/* Turner uses high-speed blanking in VFP and returns to LP once per frame.
+ * Account for the programmed D-PHY entry/exit time on all four data lanes.
+ */
+static inline int turner_dsi_video_frame_lp(void __iomem *regs)
+{
+	u32 tim0 = readl(regs + 0x600);
+	u32 tim1 = readl(regs + 0x604);
+	u32 cycles = FIELD_GET(GENMASK(7, 0), tim0) +
+		     FIELD_GET(GENMASK(15, 8), tim0) +
+		     FIELD_GET(GENMASK(23, 16), tim0) +
+		     FIELD_GET(GENMASK(31, 24), tim1) + 2;
+	u32 payload = FIELD_GET(MT6991_DSI_PS_WC, readl(regs + MT6991_DSI_PSCTRL));
+	u32 hfp = readl(regs + 0x88) & GENMASK(14, 0);
+
+	if (payload < 4 * cycles)
+		return -ERANGE;
+	writel(BIT(31) | ((payload - 4 * cycles) << 16) | hfp, regs + 0x88);
+	return 0;
+}
+
+/* Enable the MT6991 128-bit input FIFO for one side of a DSC video stream.
+ * The host must be idle, with its per-port DSC word count already programmed.
+ */
+static inline void mt6991_dsi_enable_video_fifo(void __iomem *regs)
+{
+	u32 bytes = FIELD_GET(MT6991_DSI_PS_WC, readl(regs + MT6991_DSI_PSCTRL));
+	u32 height = readl(regs + MT6991_DSI_VACT_NL);
+
+	writel(readl(regs + 0x304) & ~GENMASK(14, 0), regs + 0x304);
+	writel(DIV_ROUND_UP(bytes * height, 16), regs + 0x310);
+	writel(readl(regs + 0x300) | BIT(0), regs + 0x300);
+}
+#endif
