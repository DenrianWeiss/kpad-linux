@@ -0,0 +1,32 @@
+/* Acquired by the scan fixture after checking both DMA mappings. */
+static void turner_program_fetch(struct scan_path *path, const dma_addr_t addr[2])
+{
+	const u32 shape = (3008 << 16) | 940;
+	unsigned int side;
+
+	for (side = 0; side < 2; ++side) {
+		struct scan_block *fetch = &path->block[FETCH_L + side];
+		struct scan_block *blend = &path->block[BLEND_L + side];
+		struct scan_block *mutex = &path->block[MUT_OVL0 + side];
+		dma_addr_t start = addr[side] + side * 940 * sizeof(u32);
+
+		scan_write(fetch, 0x28, BIT(2), BIT(2));
+		scan_write(fetch, 0x30, U32_MAX, shape);
+		scan_write(fetch, 0x44, U32_MAX, 0);
+		scan_write(fetch, 0x48, U32_MAX, shape);
+		scan_write(fetch, 0x50, U32_MAX, 2); /* XR24 */
+		scan_write(fetch, 0x300, U32_MAX, 0x1ff);
+		scan_write(fetch, 0x2f4, U32_MAX, BIT(28) | 7520);
+		scan_write(fetch, 0xf40, U32_MAX, lower_32_bits(start));
+		scan_write(fetch, 0xf4c, GENMASK(3, 0), upper_32_bits(start));
+		scan_write(fetch, 0x100, BIT(0), BIT(0));
+		scan_write(fetch, 0x40, BIT(0), BIT(0));
+		scan_write(fetch, 0x20, BIT(0), BIT(0));
+		scan_write(blend, 0x48, U32_MAX, shape);
+		scan_write(blend, 0x50, U32_MAX, 2);
+		scan_write(blend, 0x200, U32_MAX, 0x10ff);
+		scan_write(blend, 0x10, GENMASK(5, 4), BIT(4));
+		scan_write(blend, 0x40, BIT(0), BIT(0));
+		scan_write(mutex, 0x34, BIT(3), BIT(3));
+	}
+}
