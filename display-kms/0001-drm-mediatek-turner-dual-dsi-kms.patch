+static int turner_get_modes(struct drm_connector *connector)
+{
+	unsigned int i;
+	for (i = 0; i < ARRAY_SIZE(turner_modes); i++) {
+		struct drm_display_mode *m = drm_mode_duplicate(connector->dev, &turner_modes[i]);
+
+		if (!m)
+			break;
+		m->type = DRM_MODE_TYPE_DRIVER | (i == 0 ? DRM_MODE_TYPE_PREFERRED : 0);
+		drm_mode_set_name(m);
+		drm_mode_probed_add(connector, m);
+	}
+	return i;
+}
+
+static enum drm_mode_status turner_validate_mode(struct drm_device *drm,
+						const struct drm_display_mode *mode)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(turner_modes); i++)
+		if (drm_mode_equal(mode, &turner_modes[i]))
+			return MODE_OK;
+	return MODE_BAD;
+}
