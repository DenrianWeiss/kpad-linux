+static int probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct turner_host *ctx;
+	int ret;
+
+	if (!dev->pm_domain)
+		return -EPROBE_DEFER;
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ctx->regs))
+		return PTR_ERR(ctx->regs);
+	ctx->phy = devm_phy_get(dev, "dphy");
+	if (IS_ERR(ctx->phy))
+		return PTR_ERR(ctx->phy);
+	ctx->hs = devm_clk_get(dev, "hs");
+	if (IS_ERR(ctx->hs))
+		return PTR_ERR(ctx->hs);
+	ctx->clocks[0].id = "engine";
+	ctx->clocks[1].id = "digital";
+	ret = devm_clk_bulk_get(dev, 2, ctx->clocks);
+	if (ret)
+		return ret;
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	ctx->host.dev = dev;
+	ctx->host.ops = &ops;
+	platform_set_drvdata(pdev, ctx);
+	if (of_property_read_bool(dev->of_node, "mediatek,dual-dsi-slave"))
+		return 0;
+	ret = mipi_dsi_host_register(&ctx->host);
+	if (ret)
+		return ret;
+	ret = device_create_file(dev, &dev_attr_exercise);
+	if (ret)
+		mipi_dsi_host_unregister(&ctx->host);
+	return ret;
+}
+static void remove_host(struct platform_device *pdev)
+{
+	struct turner_host *ctx = platform_get_drvdata(pdev);
+
+	if (of_property_read_bool(pdev->dev.of_node, "mediatek,dual-dsi-slave"))
+		return;
+	device_remove_file(&pdev->dev, &dev_attr_exercise);
+	mipi_dsi_host_unregister(&ctx->host);
+}
+static const struct of_device_id match[] = {
+	{ .compatible = "mediatek,mt6991-dsi" }, {}
+};
+static struct platform_driver turner_command_driver = {
+	.probe = probe, .remove = remove_host,
+	.driver = { .name = "turner-command-host", .of_match_table = match },
+};
+module_platform_driver(turner_command_driver);
