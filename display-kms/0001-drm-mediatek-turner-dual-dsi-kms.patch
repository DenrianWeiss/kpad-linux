Subject: [RFC PATCH] drm/mediatek: add Turner MT6991 dual DSI KMS bring-up driver

Build the tested atomic primary plane, shared DMA scan buffers, dual DSI
video path and CSOT mode list against Linux 7.3. The Turner firmware
kexec handoff and display power providers are required at runtime.

--- a/drivers/gpu/drm/mediatek/Kconfig
+++ b/drivers/gpu/drm/mediatek/Kconfig
@@ -57,3 +57,11 @@
 	  This driver can also be built as a module. If so, the HDMIv2
 	  module will be called "mtk_hdmi_v2", and the DDCv2 module
 	  will be called "mtk_hdmi_ddc_v2".
+
+config DRM_MEDIATEK_TURNER
+	tristate "Turner MT6991 dual DSI display"
+	depends on DRM_MEDIATEK && OF && I2C && IOMMU_API
+	select DRM_GEM_SHMEM_HELPER
+	help
+	  Enable the native KMS primary plane for the Redmi K Pad panel
+	  using two EXDMA engines, DSC encoders and DSI links.
--- a/drivers/gpu/drm/mediatek/Makefile
+++ b/drivers/gpu/drm/mediatek/Makefile
@@ -28,3 +28,5 @@
 obj-$(CONFIG_DRM_MEDIATEK_HDMI_V2) += mtk_hdmi_ddc_v2.o
 
 obj-$(CONFIG_DRM_MEDIATEK_DP) += mtk_dp.o
+
+obj-$(CONFIG_DRM_MEDIATEK_TURNER) += turner/
--- /dev/null
+++ b/drivers/gpu/drm/mediatek/turner/Makefile
@@ -0,0 +1 @@
+obj-$(CONFIG_DRM_MEDIATEK_TURNER) += command-host.o
--- /dev/null
+++ b/drivers/gpu/drm/mediatek/turner/command-host.c
@@ -0,0 +1,756 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Dual-host command-mode bring-up on the Turner firmware tree. */
+#include <linux/i2c.h>
+#include <linux/dma-mapping.h>
+#include <linux/iommu.h>
+#include <linux/regmap.h>
+#include <linux/arm-smccc.h>
+#include <linux/clk.h>
+#include <linux/soc/mediatek/mtk_sip_svc.h>
+#include <linux/module.h>
+#include <linux/of_graph.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+#include <drm/drm_panel.h>
+#include "mt6991-dsi-cmdq.h"
+#include "mt6991-dsi-size.h"
+#include "mt6991-dsc-engine.h"
+#include "turner-dsc.h"
+#include "turner-modes.h"
+
+static const u16 timing_regs[] = {
+	MT6991_DSI_VACT_NL, MT6991_DSI_PSCTRL, MT6991_DSI_SIZE_CON,
+	0x60, 0x64, 0x68, 0x80, 0x84, 0x88,
+};
+
+#include "kms.h"
+static bool kms_stop;
+struct turner_host {
+	struct turner_kms *kms;
+	bool fetch_unsettled;
+	struct mipi_dsi_host host;
+	struct mipi_dsi_device *panel;
+	void __iomem *regs;
+	struct clk *hs;
+	struct clk_bulk_data clocks[2];
+	struct phy *phy;
+	struct turner_host *peer;
+	bool powered;
+	u32 control, lanes, pattern, clock_lane, data_lane, shadow, timing[ARRAY_SIZE(timing_regs)];
+	unsigned int transfers;
+};
+
+static int attach(struct mipi_dsi_host *host, struct mipi_dsi_device *dsi)
+{
+	struct turner_host *ctx = container_of(host, struct turner_host, host);
+
+	if (ctx->panel || dsi->channel || dsi->lanes != 4)
+		return -EINVAL;
+	ctx->panel = dsi;
+	dev_notice(host->dev, "attached panel %pOF, VC %u, %u lanes\n",
+		   dsi->dev.of_node, dsi->channel, dsi->lanes);
+	return 0;
+}
+
+static int detach(struct mipi_dsi_host *host, struct mipi_dsi_device *dsi)
+{
+	container_of(host, struct turner_host, host)->panel = NULL;
+	return 0;
+}
+
+static void snapshot(struct device *dev, void __iomem *base, const char *phase)
+{
+	u32 shadow = readl(base + 0xd0);
+	u32 ctrl, lanes, mode;
+
+	writel(shadow & ~BIT(2), base + 0xd0);
+	ctrl = readl(base + 0x30);
+	lanes = readl(base + 0x38);
+	mode = readl(base + 0x34);
+
+	writel(shadow | BIT(2), base + 0xd0);
+	dev_notice(dev, "%s ctrl=%#x/%#x lanes=%#x/%#x mode=%#x/%#x irq=%#x shadow=%#x\n",
+		   phase, ctrl, readl(base + 0x30), lanes, readl(base + 0x38),
+		   mode, readl(base + 0x34), readl(base + 0xc), shadow);
+	writel(shadow, base + 0xd0);
+}
+
+static int power_up(struct turner_host *ctx);
+static void power_down(struct turner_host *ctx);
+
+static ssize_t transfer(struct mipi_dsi_host *host, const struct mipi_dsi_msg *msg)
+{
+	struct turner_host *ctx = container_of(host, struct turner_host, host);
+	ssize_t ret;
+
+	if (!ctx->peer)
+		return -EHOSTDOWN;
+	if (!ctx->powered) {
+		ret = power_up(ctx->peer);
+		if (ret)
+			return ret;
+		ret = power_up(ctx);
+		if (ret) {
+			power_down(ctx->peer);
+			return ret;
+		}
+		ctx->powered = true;
+	}
+	if (!ctx->transfers) {
+		snapshot(host->dev, ctx->regs, "primary before packet");
+		snapshot(host->dev, ctx->peer->regs, "secondary before packet");
+	}
+	ret = mt6991_dsi_dual_transfer(ctx->regs, ctx->peer->regs, 4, msg);
+	ctx->transfers++;
+	if (ret < 0 || msg->rx_len)
+		dev_notice(host->dev, "command %u type=%#x ret=%zd irq=%#x rx=%#x\n",
+			   ctx->transfers, msg->type, ret, readl(ctx->regs + 0xc),
+			   readl(ctx->regs + 0xa4));
+	if (ret < 0) {
+		void __iomem *ports[] = { ctx->regs, ctx->peer->regs };
+		unsigned int i;
+
+		for (i = 0; i < ARRAY_SIZE(ports); i++) {
+			void __iomem *base = ports[i];
+
+			dev_notice(host->dev, "port=%u ctrl=%#x mode=%#x lanes=%#x irq=%#x cmctl=%#x words=%#x lines=%#x queue=%#x header=%#x lc=%#x ld=%#x\n",
+				   i, readl(base + 0x30), readl(base + 0x34),
+				   readl(base + 0x38), readl(base + 0xc), readl(base + 0x274),
+				   readl(base + 0x27c), readl(base + 0x280), readl(base + 0x44),
+				   readl(base + 0x400), readl(base + 0x1d0), readl(base + 0x1d4));
+		}
+	}
+	return ret;
+}
+
+static const struct mipi_dsi_host_ops ops = {
+	.attach = attach, .detach = detach, .transfer = transfer,
+};
+
+/* Follow the MT6991 host sleep-out trigger after the PHY PLL starts. */
+static int exit_ulps(struct turner_host *ctx)
+{
+	void __iomem *regs = ctx->regs;
+	u32 mode = readl(regs + 0x34), data = readl(regs + 0x1d4);
+	u32 irq = readl(regs + 8), timer = readl(regs + 0x200);
+	u32 ctrl = readl(regs + 0x30), status, wake;
+	int ret;
+
+	wake = clk_get_rate(ctx->hs) / (1024 * 8 * 1000) + 1;
+	writel(ctrl | BIT(2), regs + 0x30);
+	writel(ctrl, regs + 0x30);
+	writel(readl(regs + 0xc) & ~BIT(6), regs + 0xc);
+	writel(irq | BIT(6), regs + 8);
+	writel(data | BIT(3), regs + 0x1d4);
+	writel(mode | BIT(20), regs + 0x34);
+	writel((timer & ~0xffff) | wake, regs + 0x200);
+	writel(0, regs);
+	writel(BIT(2), regs);
+	ret = readl_poll_timeout(regs + 0xc, status, status & BIT(6), 20, 100000);
+	dev_notice(ctx->host.dev, "ULPS exit=%d status=%#x wake=%u engine=%lu digital=%lu state=%#x\n",
+		   ret, status, wake, clk_get_rate(ctx->clocks[0].clk),
+		   clk_get_rate(ctx->clocks[1].clk), readl(regs + 0x278));
+	writel(irq, regs + 8);
+	writel(data, regs + 0x1d4);
+	writel(mode, regs + 0x34);
+	writel(0, regs);
+	writel(timer, regs + 0x200);
+	writel(ctrl | BIT(0), regs + 0x30);
+	writel(ctrl, regs + 0x30);
+	return ret;
+}
+
+static int power_up(struct turner_host *ctx)
+{
+	struct device *dev = ctx->host.dev;
+	void __iomem *regs = ctx->regs;
+	unsigned int i;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+	ret = clk_set_rate(ctx->hs, 1173586000);
+	if (ret)
+		goto suspend;
+	ret = phy_init(ctx->phy);
+	if (ret)
+		goto suspend;
+	ret = phy_power_on(ctx->phy);
+	if (ret)
+		goto exit_phy;
+	ret = clk_bulk_prepare_enable(2, ctx->clocks);
+	if (ret)
+		goto power_off;
+	ctx->control = readl(regs + 0x30);
+	ctx->lanes = readl(regs + 0x38);
+	dev_notice(dev, "start=%#x status=%#x ctrl=%#x mode=%#x lanes=%#x tim0=%#x tim1=%#x tim2=%#x tim3=%#x swap=%#x\n",
+		   readl(regs), readl(regs + 0xc), ctx->control, readl(regs + 0x34), ctx->lanes,
+		   readl(regs + 0x600), readl(regs + 0x604), readl(regs + 0x608),
+		   readl(regs + 0x60c), readl(regs + 0x618));
+	if (readl(regs) || (readl(regs + 0xc) & BIT(31)) || (readl(regs + 0x34) & 3)) {
+		ret = -EBUSY;
+		goto disable;
+	}
+	ctx->shadow = readl(regs + 0xd0);
+	ctx->pattern = readl(regs + 0x610);
+	ctx->clock_lane = readl(regs + 0x1d0);
+	ctx->data_lane = readl(regs + 0x1d4);
+	writel(ctx->shadow & ~BIT(1), regs + 0xd0);
+	writel(ctx->control | BIT(1), regs + 0x30);
+	writel(ctx->lanes | GENMASK(5, 2), regs + 0x38);
+	for (i = 0; i < ARRAY_SIZE(timing_regs); i++)
+		ctx->timing[i] = readl(regs + timing_regs[i]);
+	ret = mt6991_dsi_dual_dsc_timing(regs, &turner_modes[0], &turner_dsc);
+	if (!ret)
+		ret = exit_ulps(ctx);
+	if (!ret) {
+		writel(0x55, regs + 0x610);
+		for (i = 0; i < 2; i++) {
+			void __iomem *lane = regs + 0x1d0 + i * 4;
+			u32 control = readl(lane) & ~(BIT(1) | BIT(2));
+
+			writel(control, lane);
+			writel(control | BIT(2), lane);
+			writel(control, lane);
+		}
+		dev_notice(dev, "lane wake lc=%#x ld=%#x clock-before=%#x data-before=%#x\n",
+			   readl(regs + 0x1d0), readl(regs + 0x1d4),
+			   ctx->clock_lane, ctx->data_lane);
+		snapshot(dev, regs, "after ULPS");
+		return 0;
+	}
+	for (i = 0; i < ARRAY_SIZE(timing_regs); i++)
+		writel(ctx->timing[i], regs + timing_regs[i]);
+	writel(ctx->shadow, regs + 0xd0);
+	writel(ctx->lanes, regs + 0x38);
+	writel(ctx->control, regs + 0x30);
+disable:
+	clk_bulk_disable_unprepare(2, ctx->clocks);
+power_off:
+	phy_power_off(ctx->phy);
+exit_phy:
+	phy_exit(ctx->phy);
+suspend:
+	pm_runtime_put_sync(dev);
+	return ret;
+}
+
+static void power_down(struct turner_host *ctx)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(timing_regs); i++)
+		writel(ctx->timing[i], ctx->regs + timing_regs[i]);
+	writel(ctx->clock_lane, ctx->regs + 0x1d0);
+	writel(ctx->data_lane, ctx->regs + 0x1d4);
+	writel(ctx->pattern, ctx->regs + 0x610);
+	writel(ctx->shadow, ctx->regs + 0xd0);
+	writel(ctx->lanes, ctx->regs + 0x38);
+	writel(ctx->control, ctx->regs + 0x30);
+	clk_bulk_disable_unprepare(2, ctx->clocks);
+	phy_power_off(ctx->phy);
+	phy_exit(ctx->phy);
+	pm_runtime_put_sync(ctx->host.dev);
+}
+
+/* The powered DSI hosts hold DIS1 throughout this register test. */
+static int exercise_encoder(struct device *dev, const char *path)
+{
+	struct device_node *node __free(device_node) = of_find_node_by_path(path);
+	struct resource resource;
+	void __iomem *regs;
+	struct clk *clk;
+	u32 pps[20] = {}, old_pps[20], old[ARRAY_SIZE(turner_dsc_config)];
+	unsigned int i;
+	int ret;
+
+	if (!node || of_address_to_resource(node, 0, &resource))
+		return -ENODEV;
+	clk = of_clk_get(node, 0);
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+	ret = clk_prepare_enable(clk);
+	if (ret)
+		goto put_clk;
+	regs = of_io_request_and_map(node, 0, "Turner DSC validation");
+	if (IS_ERR(regs)) {
+		ret = PTR_ERR(regs);
+		goto disable;
+	}
+	if (readl(regs) & BIT(0)) {
+		ret = -EBUSY;
+		goto unmap;
+	}
+	turner_dsc_pack_pps(&turner_dsc, pps);
+	for (i = 0; i < ARRAY_SIZE(turner_dsc_config); i++) {
+		const struct turner_dsc_write *w = &turner_dsc_config[i];
+
+		old[i] = readl(regs + w->offset);
+		writel((old[i] & ~w->mask) | (w->value & w->mask), regs + w->offset);
+	}
+	for (i = 0; i < ARRAY_SIZE(pps); i++) {
+		old_pps[i] = readl(regs + 0x80 + i * 4);
+		writel(pps[i], regs + 0x80 + i * 4);
+	}
+	for (i = 0; i < ARRAY_SIZE(pps); i++)
+		if (readl(regs + 0x80 + i * 4) != pps[i])
+			ret = -EIO;
+	dev_notice(dev, "DSC %pOF clk=%lu pic_w=%#x pic_h=%#x slice_w=%#x PPS match=%d\n",
+		   node, clk_get_rate(clk), readl(regs + 0x18), readl(regs + 0x1c),
+		   readl(regs + 0x20), !ret);
+	for (i = 0; i < ARRAY_SIZE(pps); i++)
+		writel(old_pps[i], regs + 0x80 + i * 4);
+	for (i = ARRAY_SIZE(turner_dsc_config); i > 0; i--)
+		writel(old[i - 1], regs + turner_dsc_config[i - 1].offset);
+unmap:
+	iounmap(regs);
+	release_mem_region(resource.start, resource_size(&resource));
+disable:
+	clk_disable_unprepare(clk);
+put_clk:
+	clk_put(clk);
+	return ret;
+}
+
+/* Establish access to the real fetch engine before enabling memory reads. */
+static int exercise_fetch_geometry(struct device *dev, const char *path)
+{
+	struct device_node *node __free(device_node) = of_find_node_by_path(path);
+	struct resource resource;
+	struct clk *clk;
+	void __iomem *regs;
+	u32 size, pitch;
+	int ret;
+
+	if (!node || of_address_to_resource(node, 0, &resource))
+		return -ENODEV;
+	clk = of_clk_get(node, 0);
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+	ret = clk_prepare_enable(clk);
+	if (ret)
+		goto put;
+	regs = of_io_request_and_map(node, 0, "Turner fetch geometry");
+	if (IS_ERR(regs)) {
+		ret = PTR_ERR(regs);
+		goto disable;
+	}
+	if (readl(regs + 0x40) & BIT(0)) {
+		ret = -EBUSY;
+		goto unmap;
+	}
+	size = readl(regs + 0x48);
+	pitch = readl(regs + 0x2f4);
+	writel(1880 * 4, regs + 0x2f4);
+	writel((3008 << 16) | 1880, regs + 0x48);
+	ret = readl(regs + 0x48) == ((3008 << 16) | 1880) &&
+	      readl(regs + 0x2f4) == 1880 * 4 ? 0 : -EIO;
+	dev_notice(dev, "EXDMA %pOF clk=%lu size=%#x pitch=%u result=%d\n",
+		   node, clk_get_rate(clk), readl(regs + 0x48), readl(regs + 0x2f4), ret);
+	writel(size, regs + 0x48);
+	writel(pitch, regs + 0x2f4);
+unmap:
+	iounmap(regs);
+	release_mem_region(resource.start, resource_size(&resource));
+disable:
+	clk_disable_unprepare(clk);
+put:
+	clk_put(clk);
+	return ret;
+}
+
+#include "scan-path.h"
+#include "fetch.h"
+
+/* Exercise sync-pulse video between a verified prepare and unprepare. */
+static void sample_video(struct turner_host *ctx, const struct drm_display_mode *profile,
+			 unsigned int duration_ms, const dma_addr_t addr[2])
+{
+	struct turner_host *ports[] = { ctx, ctx->peer };
+	u32 clock[2], mode[2], dual = readl(ctx->peer->regs + 0x30);
+	unsigned int i, frame[2] = {}, max_y[2] = {}, moving[2] = {}, prev[2] = {};
+	u32 fifo[2][3], reset_select[2], reserved[2];
+	unsigned int reported = 0, drained = 0;
+	ktime_t deadline = 0;
+	s64 first_us[2] = {}, last_us[2] = {};
+	u32 status;
+
+	struct scan_path *path __free(kfree) = kzalloc(sizeof(*path), GFP_KERNEL);
+	int ret;
+
+	if (!path)
+		return;
+	ret = start_scan_path(path, ctx->host.dev);
+	dev_notice(ctx->host.dev, "dual color scan setup=%d\n", ret);
+	if (ret) {
+		close_scan_path(path);
+		return;
+	}
+	for (i = 0; i < 2; i++) {
+		void __iomem *base = ports[i]->regs;
+
+		mt6991_dsi_dual_dsc_timing(base, profile, &turner_dsc);
+		/* Clear only the previous frame-done latch, as in the OEM DSC ISR. */
+		writel(BIT(0), path->block[DSC_L+i].base + 0xc);
+		writel(0, path->block[DSC_L+i].base + 0xc);
+		clock[i] = readl(base + 0x1d0);
+		mode[i] = readl(base + 0x34);
+		fifo[i][0] = readl(base + 0x300);
+		fifo[i][1] = readl(base + 0x304);
+		fifo[i][2] = readl(base + 0x310);
+		reset_select[i] = readl(base + 0x274);
+		reserved[i] = readl(base + 0x3f8);
+		writel(reset_select[i] | BIT(10), base + 0x274);
+		writel(reserved[i] & ~BIT(29), base + 0x3f8);
+		dev_notice(ctx->host.dev, "DSI%u mmreset=%#x->%#x reserved=%#x->%#x size=%#x ps=%#x vact=%u\n",
+			   i, reset_select[i], readl(base + 0x274), reserved[i],
+			   readl(base + 0x3f8), readl(base + 0x2c), readl(base + 0x3c),
+			   readl(base + 0x6c));
+		/* Working Turner snapshot: bypass shadow in video mode. */
+		writel(readl(base + 0xd0) | BIT(1), base + 0xd0);
+		ret = turner_dsi_video_frame_lp(base);
+		if (ret)
+			dev_warn(ctx->host.dev, "DSI%u invalid frame LP timing: %d\n", i, ret);
+		dev_notice(ctx->host.dev, "DSI%u per-frame LP hfp=%#x shadow=%#x\n", i,
+			   readl(base + 0x88), readl(base + 0xd0));
+		mt6991_dsi_enable_video_fifo(base);
+		dev_notice(ctx->host.dev, "DSI%u fifo before=%#x enabled=%#x transfers=%u\n",
+			   i, fifo[i][0], readl(base + 0x300), readl(base + 0x310));
+		writel(0, base);
+		writel((mode[i] & ~3) | 1, base + 0x34);
+		writel(clock[i] | BIT(0), base + 0x1d0);
+		writel(readl(base + 0xc) & ~(BIT(4) | BIT(12)), base + 0xc);
+	}
+	turner_program_fetch(path, addr);
+	/* Match the stock prepare / mutex / trigger packet ordering. */
+	static const enum block_id trigger_order[] = {
+		MUT_DIS0, MUT_OVL0, MUT_DIS1, MUT_OVL1,
+	};
+	for (i = 0; i < ARRAY_SIZE(trigger_order); i++)
+		scan_write(&path->block[trigger_order[i]], 0x20, U32_MAX, 1);
+	writel(dual | BIT(4), ctx->peer->regs + 0x30);
+	writel(0, ctx->regs);
+	writel(1, ctx->regs);
+
+	do {
+		for (i = 0; i < 2; i++) {
+			void __iomem *base = ports[i]->regs;
+
+			u32 pos = readl(base + 0x244);
+			max_y[i] = max(max_y[i], (pos >> 16) & 0x1fff);
+			moving[i] += pos != prev[i];
+			prev[i] = pos;
+			status = readl(base + 0xc);
+			if (status & BIT(4)) {
+				writel(status & ~BIT(4), base + 0xc);
+				frame[i]++;
+				if (deadline)
+					drained |= BIT(i);
+				if (!i) {
+					struct turner_kms *k = ctx->kms;
+					mutex_lock(&k->flip_lock);
+					k->retiring = -1;
+					if (k->pending >= 0) {
+						const dma_addr_t *next = k->slot[k->pending].addr;
+						writel(lower_32_bits(next[0]), path->block[FETCH_L].base+0xf40);
+						writel(lower_32_bits(next[1]+3760), path->block[FETCH_R].base+0xf40);
+						k->retiring = k->front;
+						k->front = k->pending;
+						k->pending = -1;
+					}
+					mutex_unlock(&k->flip_lock);
+					wake_up_all(&k->flip_wait);
+					drm_crtc_handle_vblank(&k->crtc);
+					if (reported != READ_ONCE(ctx->kms->sequence) && frame[i] % (reported < 4 ? 8 : 256) == 0) {
+						reported = READ_ONCE(ctx->kms->sequence);
+						dev_notice(ctx->host.dev, "KMS frame %u rate=%d pixels=%06x/%06x\n",
+							   reported, drm_mode_vrefresh(profile),
+							   (readl(path->block[FETCH_L].base+0x24c)>>4)&0xffffff,
+							   (readl(path->block[FETCH_R].base+0x24c)>>4)&0xffffff);
+					}
+				}
+				last_us[i] = ktime_to_us(ktime_get());
+				if (frame[i] == 1)
+					first_us[i] = last_us[i];
+			}
+		}
+		usleep_range(250, 450);
+		if (READ_ONCE(kms_stop))
+			schedule_work(&ctx->kms->shutdown);
+		if (!deadline && (READ_ONCE(ctx->kms->finished) ||
+		    READ_ONCE(ctx->kms->hz) != drm_mode_vrefresh(profile)))
+			deadline = ktime_add_ms(ktime_get(), 100);
+	} while (!deadline || (drained != 3 && ktime_before(ktime_get(), deadline)));
+	for (i = 0; i < 2; ++i) {
+		void __iomem *f = path->block[FETCH_L+i].base;
+		u32 data = readl(f + 0x24c);
+		dev_notice(ctx->host.dev, "memory frame side=%u addr=%#x:%08x rdma=%#x pixel_bus=%#x pos=%#x\n",
+			   i, readl(f+0xf4c), readl(f+0xf40), readl(f+0x100),
+			   (data >> 4) & 0xffffff, readl(f+0x244));
+	}
+	report_scan_path(path, ctx->host.dev);
+	for (i = 0; i < 2; i++) {
+		void __iomem *base = ports[i]->regs;
+
+		dev_notice(ctx->host.dev, "video result port=%u frames=%u irq=%#x vstate=%#x lines=%#x\n",
+			   i, frame[i], readl(base + 0xc), readl(base + 0x278), readl(base + 0x280));
+		dev_notice(ctx->host.dev, "scan rate=%d port=%u frames=%u elapsed_us=%lld dsc_irq=%#x underrun=%u max_y=%u\n",
+			   drm_mode_vrefresh(profile), i, frame[i], last_us[i] - first_us[i],
+			   readl(path->block[DSC_L+i].base + 8), !!(readl(base + 0xc) & BIT(12)), max_y[i]);
+		writel(mode[i], base + 0x34);
+	}
+	for (i = 0; i < ARRAY_SIZE(ports); i++)
+		writel(0, ports[i]->regs);
+	for (i = 0; i < ARRAY_SIZE(ports); i++) {
+		void __iomem *base = ports[i]->regs;
+		int ret = readl_poll_timeout(base + 0xc, status, !(status & BIT(31)),
+					     100, 100000);
+
+		dev_notice(ctx->host.dev, "video stop port=%u idle=%d status=%#x\n",
+			   i, !ret, status);
+		dev_notice(ctx->host.dev, "DSI%u input max_y=%u changes=%u last=%#x\n",
+			   i, max_y[i], moving[i], prev[i]);
+		writel(ports[i]->shadow & ~BIT(1), base + 0xd0);
+		writel(reset_select[i], base + 0x274);
+		writel(reserved[i], base + 0x3f8);
+		writel(fifo[i][0], base + 0x300);
+		writel(fifo[i][1], base + 0x304);
+		writel(fifo[i][2], base + 0x310);
+		writel(clock[i], base + 0x1d0);
+	}
+	writel(dual, ctx->peer->regs + 0x30);
+	for (i = 0; i < 2; ++i) {
+		void __iomem *f = path->block[FETCH_L+i].base;
+		/* The OEM stop sequence clears engine enable and resets the layer. */
+		writel(readl(f + 0x20) & ~BIT(0), f + 0x20);
+		writel(1, f + 0x24);
+		writel(0, f + 0x24);
+		writel(0, f + 0x40);
+		writel(0, f + 0x100);
+		ret = readl_poll_timeout(f + 0x240, status, status & BIT(19), 10, 100000);
+		if (ret) {
+			ctx->fetch_unsettled = true;
+			dev_err(ctx->host.dev, "fetch side %u did not report idle\n", i);
+		}
+	}
+	close_scan_path(path);
+}
