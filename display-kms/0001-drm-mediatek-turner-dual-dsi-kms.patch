+	.atomic_destroy_state = drm_atomic_helper_connector_destroy_state,
+};
+static const struct drm_connector_helper_funcs turner_connector_helpers = {
+	.get_modes = turner_get_modes,
+};
+static const struct drm_encoder_funcs turner_encoder_funcs = { .destroy = drm_encoder_cleanup };
+static const struct drm_mode_config_funcs turner_config_funcs = {
+	.fb_create = drm_gem_fb_create_with_dirty,
+	.mode_valid = turner_validate_mode,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
+};
+DEFINE_DRM_GEM_FOPS(turner_fops);
+static const struct drm_driver turner_driver = {
+	.driver_features = DRIVER_GEM | DRIVER_MODESET | DRIVER_ATOMIC,
+	.fops = &turner_fops,
+	DRM_GEM_SHMEM_DRIVER_OPS,
+	.name = "turner-display", .desc = "MT6991 dual DSI", .major = 1,
+};
+
+static int turner_register_kms(struct turner_kms *k)
+{
+	static const u32 formats[] = { DRM_FORMAT_XRGB8888 };
+	static const u64 modifiers[] = { DRM_FORMAT_MOD_LINEAR, DRM_FORMAT_MOD_INVALID };
+	struct drm_device *drm = &k->drm;
+	int ret = drmm_mode_config_init(drm);
+
+	if (ret)
+		return ret;
+	drm->mode_config.funcs = &turner_config_funcs;
+	drm->mode_config.max_width = 1880;
+	drm->mode_config.max_height = 3008;
+	ret = drm_universal_plane_init(drm, &k->plane, 1, &turner_plane_funcs, formats,
+				       ARRAY_SIZE(formats), modifiers, DRM_PLANE_TYPE_PRIMARY, NULL);
+	if (ret)
+		return ret;
+	drm_plane_helper_add(&k->plane, &turner_plane_helpers);
+	ret = drm_crtc_init_with_planes(drm, &k->crtc, &k->plane, NULL, &turner_crtc_funcs, NULL);
+	if (ret)
+		return ret;
+	drm_crtc_helper_add(&k->crtc, &turner_crtc_helpers);
+	ret = drm_encoder_init(drm, &k->encoder, &turner_encoder_funcs, DRM_MODE_ENCODER_DSI, NULL);
+	if (ret)
+		return ret;
+	k->encoder.possible_crtcs = drm_crtc_mask(&k->crtc);
+	ret = drm_connector_init(drm, &k->connector, &turner_connector_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (ret)
+		return ret;
+	k->connector.display_info.width_mm = 118;
+	k->connector.display_info.height_mm = 189;
+	drm_connector_helper_add(&k->connector, &turner_connector_helpers);
+	ret = drm_connector_attach_encoder(&k->connector, &k->encoder);
+	if (ret)
+		return ret;
+	ret = drm_vblank_init(drm, 1);
+	if (ret)
+		return ret;
+	drm_mode_config_reset(drm);
+	return drm_dev_register(drm, 0);
+}
+
+
+/* Disable the CRTC while the scan thread can still deliver vblank events. */
+static void turner_shutdown_work(struct work_struct *work)
+{
+	struct turner_kms *kms = container_of(work, struct turner_kms, shutdown);
+
+	if (READ_ONCE(kms->finished))
+		return;
+	drm_dev_unplug(&kms->drm);
+	drm_atomic_helper_shutdown(&kms->drm);
+	WRITE_ONCE(kms->finished, true);
+}
