+static int turner_memory_frame(struct turner_host *ctx)
+{
+	struct device_node *ln __free(device_node) = of_find_node_by_path("/soc/disp-ovl0-exdma3@32860000");
+	struct device_node *rn __free(device_node) = of_find_node_by_path("/soc/disp-ovl1-exdma3@32c60000");
+	struct device_node *sn __free(device_node) = of_parse_phandle(rn, "mtk,smmu-shared", 0);
+	struct platform_device *left = of_find_device_by_node(ln), *right = of_find_device_by_node(sn);
+	int ret = -EPROBE_DEFER;
+
+	if (left && right) {
+		for (int retry = 0; retry < 100 && ret == -EPROBE_DEFER; retry++) {
+			msleep(20);
+			ret = turner_check_buffer(&left->dev, &right->dev, ctx);
+		}
+	}
+	if (right)
+		put_device(&right->dev);
+	if (left)
+		put_device(&left->dev);
+	return ret;
+}
+
+/* Query the non-secure MM SMMU only while TF-A holds its power reference. */
+static void inspect_backlight(struct mipi_dsi_device *panel, bool enabled)
+{
+	struct device_node *node __free(device_node) =
+		of_parse_phandle(panel->dev.of_node, "backlight", 0);
+	struct i2c_client *client;
+	struct regmap *map;
+	unsigned int low, high, control, bias, cfg;
+	u8 pwm[2];
+	int ret;
+
+	if (!of_device_is_compatible(node, "xiaomi,turner-ktz8866"))
+		return;
+	client = of_find_i2c_device_by_node(node);
+	if (!client)
+		return;
+	map = dev_get_regmap(&client->dev, NULL);
+	ret = map ? regmap_read(map, 0x04, &low) : -ENODEV;
+	if (!ret)
+		ret = regmap_read(map, 0x05, &high);
+	if (!ret)
+		ret = regmap_read(map, 0x08, &control);
+	if (!ret)
+		ret = regmap_read(map, 0x09, &bias);
+	if (!ret)
+		ret = regmap_read(map, 0x02, &cfg);
+	if (!ret)
+		ret = regmap_bulk_read(map, 0x12, pwm, sizeof(pwm));
+	if (ret)
+		dev_warn(&client->dev, "panel backlight readback failed: %d\n", ret);
+	else
+		dev_notice(&client->dev, "panel on=%u backlight code=%u enable=%#x bias=%#x cfg=%#x pwm=%u\n",
+			   enabled, (high << 3) | (low & 7), control, bias, cfg,
+			   ((pwm[1] & 7) << 8) | pwm[0]);
+	put_device(&client->dev);
+}
+
+static void inspect_mm_smmu(struct device *dev)
+{
+	struct device_node *np __free(device_node) =
+		of_find_compatible_node(NULL, NULL, "mediatek,mt6991-mm-smmu");
+	struct arm_smccc_res reply;
+	struct resource res;
+	void __iomem *base;
+
+	if (!np || of_address_to_resource(np, 0, &res) || resource_size(&res) < SZ_4K)
+		return;
+	base = ioremap(res.start, SZ_4K);
+	if (!base)
+		return;
+	/* MT6991 firmware MM instance = 0, secure service bit 11, PM_GET/PUT = 3/4. */
+	arm_smccc_smc(MTK_SIP_KERNEL_IOMMU_CONTROL, BIT(11) | 3, 0, 0, 0, 0, 0, 0, &reply);
+	dev_notice(dev, "MM SMMU PM_GET=%ld\n", (long)reply.a0);
+	if (!reply.a0) {
+		dev_notice(dev, "MM SMMU IDR0=%#x IDR1=%#x IDR5=%#x CR0=%#x CR0ACK=%#x GERROR=%#x\n",
+			   readl(base), readl(base + 4), readl(base + 0x14),
+			   readl(base + 0x20), readl(base + 0x24), readl(base + 0x60));
+		/* Non-destructive handoff snapshot of the non-secure SMMUv3 queue. */
+		dev_notice(dev, "MM handoff CR1=%#x CR2=%#x STRTAB=%#llx CFG=%#x CMDQ=%#llx PROD=%#x CONS=%#x\n",
+			   readl(base + 0x28), readl(base + 0x2c), readq(base + 0x80),
+			   readl(base + 0x88), readq(base + 0x90),
+			   readl(base + 0x98), readl(base + 0x9c));
+		arm_smccc_smc(MTK_SIP_KERNEL_IOMMU_CONTROL, BIT(11) | 4, 0, 0, 0, 0, 0, 0, &reply);
+		dev_notice(dev, "MM SMMU PM_PUT=%ld\n", (long)reply.a0);
+	}
+	iounmap(base);
+}
+
+static ssize_t exercise_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t len)
+{
+	struct turner_host *ctx = dev_get_drvdata(dev), *peer;
+	struct device_node *node __free(device_node) =
+		of_graph_get_remote_node(dev->of_node, 1, 0);
+	struct platform_device *pdev = of_find_device_by_node(node);
+	struct drm_panel *panel;
+	int ret = -ENODEV;
+
+	if (!pdev)
+		return -ENODEV;
+	device_lock(&pdev->dev);
+	peer = platform_get_drvdata(pdev);
+	if (!peer || !ctx->panel || !sysfs_streq(buf, "prepare"))
+		goto unlock;
+	panel = mipi_dsi_get_drvdata(ctx->panel);
+	if (!panel || panel->prepared)
+		goto unlock;
+	/* Supply and reset the panel before driving the physical lanes. */
+	ctx->peer = peer;
+	ctx->transfers = 0;
+	drm_panel_prepare(panel);
+	ret = panel->prepared ? 0 : -EIO;
+	dev_notice(dev, "panel prepare=%d transactions=%u\n", ret, ctx->transfers);
+	if (panel->prepared) {
+		drm_panel_enable(panel);
+		inspect_backlight(ctx->panel, panel->enabled);
+		inspect_mm_smmu(dev);
+		dev_notice(dev, "panel enabled=%d raw RX primary=%#x secondary=%#x\n",
+			   panel->enabled, readl(ctx->regs + 0xa4), readl(peer->regs + 0xa4));
+		dev_notice(dev, "primary DSC config=%d\n",
+			   exercise_encoder(dev, "/soc/disp1-dsc-wrap0@32450000"));
+		dev_notice(dev, "secondary DSC config=%d\n",
+			   exercise_encoder(dev, "/soc/disp1-dsc-wrap1@32460000"));
+		dev_notice(dev, "first EXDMA geometry=%d\n",
+			   exercise_fetch_geometry(dev, "/soc/disp-ovl0-exdma3@32860000"));
+		dev_notice(dev, "second EXDMA geometry=%d\n",
+			   exercise_fetch_geometry(dev, "/soc/disp-ovl1-exdma3@32c60000"));
+		ret = turner_memory_frame(ctx);
+		dev_notice(dev, "memory frame test=%d\n", ret);
+		inspect_backlight(ctx->panel, panel->enabled);
+		drm_panel_disable(panel);
+		inspect_backlight(ctx->panel, panel->enabled);
+		drm_panel_unprepare(panel);
+		dev_notice(dev, "panel teardown enabled=%u prepared=%u transactions=%u\n",
+			   panel->enabled, panel->prepared, ctx->transfers);
+	}
+	if (ctx->powered) {
+		power_down(ctx);
+		power_down(peer);
+		ctx->powered = false;
+	}
+	ctx->peer = NULL;
+unlock:
+	device_unlock(&pdev->dev);
+	put_device(&pdev->dev);
+	return ret ? ret : len;
+}
+static DEVICE_ATTR_WO(exercise);
