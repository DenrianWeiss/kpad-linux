@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6991_DSC_ENGINE_H
+#define MT6991_DSC_ENGINE_H
+
+#include <drm/display/drm_dsc.h>
+
+#include "mt6991-dsi-video.h"
+
+/* Turner CSOT, 1880x3008 full-frame video, 470x8 slices, 10 bpc / 8 bpp.
+ * This profile is for one MT6991 wrapper, with its clock and domain held.
+ * The display owner synchronizes the packet, start, and trigger with scanout.
+ */
+enum turner_dsc_phase {
+	TURNER_DSC_CONFIG,
+	TURNER_DSC_START,
+	TURNER_DSC_TRIGGER,
+	TURNER_DSC_STOP,
+};
+
+struct turner_dsc_write {
+	u16 offset;
+	u32 value;
+	u32 mask;
+};
+
+/* The wrapper packs the min/max QP and signed six-bit BPG fields in a
+ * different bit order from a wire-format DSC PPS. The final halfword is 0.
+ */
+static inline void turner_dsc_pack_pps(const struct drm_dsc_config *cfg, u32 words[20])
+{
+	unsigned int i;
+
+	words[0] = cfg->line_buf_depth | (cfg->bits_per_component << 4) |
+		   (cfg->bits_per_pixel << 8) | ((u32)cfg->convert_rgb << 18) |
+		   ((u32)cfg->block_pred_enable << 19);
+	words[1] = cfg->initial_xmit_delay | ((u32)cfg->initial_dec_delay << 16);
+	words[2] = cfg->initial_scale_value | ((u32)cfg->scale_increment_interval << 16);
+	words[3] = cfg->scale_decrement_interval | ((u32)cfg->first_line_bpg_offset << 16);
+	words[4] = cfg->nfl_bpg_offset | ((u32)cfg->slice_bpg_offset << 16);
+	words[5] = cfg->initial_offset | ((u32)cfg->final_offset << 16);
+	words[6] = cfg->flatness_min_qp | (cfg->flatness_max_qp << 8) |
+		   ((u32)cfg->rc_model_size << 16);
+	words[7] = cfg->rc_edge_factor | (cfg->rc_quant_incr_limit0 << 8) |
+		   ((u32)cfg->rc_quant_incr_limit1 << 16) |
+		   ((u32)cfg->rc_tgt_offset_high << 28) | ((u32)cfg->rc_tgt_offset_low << 24);
+	for (i = 0; i < ARRAY_SIZE(cfg->rc_buf_thresh); i++)
+		words[8 + i / 4] |= (u32)cfg->rc_buf_thresh[i] << ((i % 4) * 8);
+	for (i = 0; i < ARRAY_SIZE(cfg->rc_range_params); i++) {
+		const struct drm_dsc_rc_range_parameters *range = &cfg->rc_range_params[i];
+		u32 value = range->range_min_qp | (range->range_max_qp << 5) |
+			    ((range->range_bpg_offset & 0x3f) << 10);
+
+		words[12 + i / 2] |= value << ((i % 2) * 16);
+	}
+}
+
+static const struct turner_dsc_write turner_dsc_config[] = {
+	{ 0x014, 0x00000000, U32_MAX },
+	{ 0x070, 0x800002d9, U32_MAX },
+	{ 0x03c, 0x03ac01d6, U32_MAX },
+	{ 0x000, 0x00010080, U32_MAX },
+	{ 0x018, 0x013903ac, U32_MAX },
+	{ 0x01c, 0x0bbf0bbf, U32_MAX },
+	{ 0x020, 0x009c01d6, U32_MAX },
+	{ 0x024, 0x81770007, U32_MAX },
+	{ 0x028, 0x013a01d6, U32_MAX },
+	{ 0x038, 0x00000002, U32_MAX },
+	{ 0x02c, 0x00000eb0, U32_MAX },
+	{ 0x030, 0x00000001, 0xffff },
+	{ 0x034, 0x00000028, U32_MAX },
+	{ 0x060, 0x00000200, 0x200 },
+	{ 0x200, 0x00000040, 0x60 },
+};
+
+static inline int turner_dsc_engine_append(struct cmdq_pkt *pkt, u32 base,
+					  enum turner_dsc_phase phase,
+					  const struct drm_dsc_config *cfg)
+{
+	static const struct turner_dsc_write start[] = {
+		{ 0x228, 0x00000001, 0x3 },
+		{ 0x000, 0x00000001, 0x1 },
+	};
+	static const struct turner_dsc_write trigger[] = {
+		{ 0x000, 0x00000100, 0x100 },
+		{ 0x000, 0x00000000, 0x100 },
+	};
+	static const struct turner_dsc_write stop[] = {
+		{ 0x000, 0x00000000, 0x1 },
+	};
+	static const struct {
+		const struct turner_dsc_write *writes;
+		unsigned int count;
+	} phases[] = {
+		[TURNER_DSC_CONFIG] = { turner_dsc_config, ARRAY_SIZE(turner_dsc_config) },
+		[TURNER_DSC_START] = { start, ARRAY_SIZE(start) },
+		[TURNER_DSC_TRIGGER] = { trigger, ARRAY_SIZE(trigger) },
+		[TURNER_DSC_STOP] = { stop, ARRAY_SIZE(stop) },
+	};
+	const struct turner_dsc_write *writes;
+	unsigned int count, i, instructions;
+	u32 pps[20] = {};
+	size_t before;
+	int ret;
+
+	if (!base || (base & 0xffff) || (unsigned int)phase >= ARRAY_SIZE(phases))
+		return -EINVAL;
+	writes = phases[phase].writes;
+	count = phases[phase].count;
+	instructions = 2 * count;
+	for (i = 0; i < count; i++)
+		instructions += writes[i].mask != U32_MAX;
+	if (phase == TURNER_DSC_CONFIG) {
+		if (!cfg || cfg->pic_width != 1880 || cfg->pic_height != 3008 ||
+		    cfg->slice_width != 470 || cfg->slice_height != 8 ||
+		    cfg->slice_chunk_size != 470 || cfg->bits_per_component != 10 ||
+		    cfg->bits_per_pixel != 128)
+			return -EINVAL;
+		instructions += 2 * ARRAY_SIZE(pps);
+		turner_dsc_pack_pps(cfg, pps);
+	}
+	ret = mt6991_video_room(pkt, instructions);
+	if (ret)
+		return ret;
+	before = pkt->cmd_buf_size;
+	for (i = 0; i < count; i++) {
+		if (writes[i].mask == U32_MAX)
+			ret = cmdq_pkt_write_pa(pkt, 0, base, writes[i].offset, writes[i].value);
+		else
+			ret = cmdq_pkt_write_mask_pa(pkt, 0, base, writes[i].offset,
+						     writes[i].value, writes[i].mask);
+		if (ret) {
+			pkt->cmd_buf_size = before;
+			return ret;
+		}
+	}
+	if (phase == TURNER_DSC_CONFIG) {
+		for (i = 0; i < ARRAY_SIZE(pps); i++) {
+			ret = cmdq_pkt_write_pa(pkt, 0, base, 0x80 + i * 4, pps[i]);
+			if (ret) {
+				pkt->cmd_buf_size = before;
+				return ret;
+			}
+		}
+	}
+	return 0;
+}
+#endif
