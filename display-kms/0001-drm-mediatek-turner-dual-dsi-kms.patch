+++ b/drivers/gpu/drm/mediatek/turner/mt6991-dsi-video.h
@@ -0,0 +1,122 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef MT6991_DSI_VIDEO_H
+#define MT6991_DSI_VIDEO_H
+
+#include <drm/drm_mipi_dsi.h>
+#include <linux/mailbox_client.h>
+#include <linux/mailbox/mtk-cmdq-mailbox.h>
+#include <linux/soc/mediatek/mtk-cmdq.h>
+
+static inline int mt6991_video_room(struct cmdq_pkt *pkt, unsigned int instructions)
+{
+	if (!IS_REACHABLE(CONFIG_MTK_CMDQ))
+		return -EOPNOTSUPP;
+	if (!pkt || !pkt->va_base || pkt->cmd_buf_size % CMDQ_INST_SIZE)
+		return -EINVAL;
+	if (pkt->cmd_buf_size > pkt->buf_size ||
+	    instructions * CMDQ_INST_SIZE > pkt->buf_size - pkt->cmd_buf_size)
+		return -ENOSPC;
+	return 0;
+}
+
+/* Each MT6991 host occupies its own 64 KiB-aligned physical address region.
+ * The caller owns the packet and synchronizes the display pipeline. A zero
+ * secondary address selects a single host. These helpers only append instructions.
+ */
+static inline int mt6991_dsi_video_prepare(struct cmdq_pkt *pkt, u32 primary,
+					  u32 secondary, unsigned long flags)
+{
+	size_t before;
+	u32 mode;
+	int ret;
+
+	if (!primary || ((primary | secondary) & 0xffff) || secondary == primary ||
+	    !(flags & MIPI_DSI_MODE_VIDEO))
+		return -EINVAL;
+	ret = mt6991_video_room(pkt, secondary ? 8 : 4);
+	if (ret)
+		return ret;
+	before = pkt->cmd_buf_size;
+	if (flags & MIPI_DSI_MODE_VIDEO_BURST)
+		mode = 3;
+	else if (flags & MIPI_DSI_MODE_VIDEO_SYNC_PULSE)
+		mode = 1;
+	else
+		mode = 2;
+
+	ret = cmdq_pkt_write_pa(pkt, 0, primary, 0, 0);
+	if (!ret && secondary)
+		ret = cmdq_pkt_write_pa(pkt, 0, secondary, 0, 0);
+	if (!ret)
+		ret = cmdq_pkt_write_pa(pkt, 0, primary, 0x34, mode);
+	if (!ret && secondary)
+		ret = cmdq_pkt_write_pa(pkt, 0, secondary, 0x34, mode);
+	if (ret)
+		pkt->cmd_buf_size = before;
+	return ret;
+}
+
+/* Supply windows in DT reg order (DISP0, DISP1, OVL0, OVL1).
+ * Use zero for inactive optional windows. MOD and SOF must already be set.
+ */
+static inline int mt6991_display_mutex_trigger(struct cmdq_pkt *pkt,
+					      const u32 banks[4], unsigned int slot)
+{
+	static const u8 trigger_order[] = { 0, 2, 1, 3 };
+	unsigned int i, count = 0;
+	size_t before;
+	int ret;
+
+	if (!banks || !banks[0] || (banks[3] && !banks[1]) || slot >= 10)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(trigger_order); i++) {
+		if (banks[i] & 0xffff)
+			return -EINVAL;
+		if (banks[i])
+			count++;
+	}
+	ret = mt6991_video_room(pkt, count * 2);
+	if (ret)
+		return ret;
+	before = pkt->cmd_buf_size;
+	for (i = 0; i < ARRAY_SIZE(trigger_order); i++) {
+		u32 bank = banks[trigger_order[i]];
+
+		if (!bank)
+			continue;
+		ret = cmdq_pkt_write_pa(pkt, 0, bank, 0x20 + slot * 0x20, 1);
+		if (ret) {
+			pkt->cmd_buf_size = before;
+			return ret;
+		}
+	}
+	return 0;
+}
+
+/* Append this phase after the display mutex trigger. The secondary gate is
+ * conditional in the stock CRTC path, independently of having a second link.
+ */
+static inline int mt6991_dsi_video_trigger(struct cmdq_pkt *pkt, u32 primary,
+					  u32 secondary, bool arm_secondary)
+{
+	size_t before;
+	int ret = 0;
+
+	if (!primary || ((primary | secondary) & 0xffff) || secondary == primary ||
+	    (arm_secondary && !secondary))
+		return -EINVAL;
+	ret = mt6991_video_room(pkt, arm_secondary ? 7 : 4);
+	if (ret)
+		return ret;
+	before = pkt->cmd_buf_size;
+	if (arm_secondary)
+		ret = cmdq_pkt_write_mask_pa(pkt, 0, secondary, 0x30, BIT(4), BIT(4));
+	if (!ret)
+		ret = cmdq_pkt_write_pa(pkt, 0, primary, 0, 0);
+	if (!ret)
+		ret = cmdq_pkt_write_pa(pkt, 0, primary, 0, 1);
+	if (ret)
+		pkt->cmd_buf_size = before;
+	return ret;
+}
+#endif
--- /dev/null
+++ b/drivers/gpu/drm/mediatek/turner/scan-path.h
@@ -0,0 +1,250 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Hardware fixture for the Turner's two half-width display streams. */
+#include <linux/mfd/syscon.h>
+#include <linux/regmap.h>
+
+enum block_id { FETCH_L, FETCH_R, DSC_L, DSC_R, BLEND_L, BLEND_R, OUT_L, OUT_R, MUT_DIS0, MUT_DIS1, MUT_OVL0, MUT_OVL1, BLOCKS };
+struct scan_block {
+	void __iomem *base;
+	struct resource resource;
+	struct clk *clk;
+	struct { u16 reg; u32 value; } saved[48];
+	unsigned int count;
+};
+
+enum route_bank { DISP0, DISP1, OVL0, OVL1, BANKS };
+static const char * const route_node[BANKS] = {
+	"/syscon@32000000", "/syscon@32400000", "/syscon@32800000", "/syscon@32c00000",
+};
+static const struct { u8 bank; u16 reg; u32 val; } route[] = {
+	/* Firmware programs these as set bits before changing routing. */
+	{ DISP0, 0xc30, 0xff0001 }, { DISP1, 0xcf8, 0xff0001 },
+	{ OVL0, 0xca0, 1 }, { OVL1, 0xca0, 1 },
+	{ OVL0, 0xcac, 0x1fe0000 }, { OVL1, 0xcac, 0x1fe0000 },
+	/* Feed OUTPROC0 from BLENDER1's local background, with all layers disabled. */
+	{ OVL0, 0xe04, BIT(0) }, { OVL0, 0xf10, BIT(0) },
+	{ OVL1, 0xe04, BIT(0) }, { OVL1, 0xf10, BIT(0) },
+	{ OVL0, 0x29c, (3008 << 16) | 940 }, { OVL1, 0x29c, (3008 << 16) | 940 },
+	/* DLI0 / DLI8 -> PQ bypass 6 / 7 -> panel crossbar 1 / 2 -> DLO1 / 2. */
+	{ DISP0, 0xdd0, BIT(2) }, { DISP0, 0xe54, BIT(1) }, { DISP0, 0xd84, BIT(1) },
+	{ DISP0, 0xdf0, BIT(3) }, { DISP0, 0xe58, BIT(2) }, { DISP0, 0xd88, BIT(2) },
+	{ OVL0, 0xe70, BIT(2) }, { OVL1, 0xe70, BIT(2) },
+	/* Independent half streams bypass the splitter and go through both encoders. */
+	{ DISP1, 0xeac, BIT(4) }, { DISP1, 0xf5c, BIT(1) },
+	{ DISP1, 0xeb4, BIT(5) }, { DISP1, 0xf64, BIT(3) },
+	{ DISP1, 0xd08, BIT(0) }, { DISP1, 0xdcc, BIT(0) },
+	{ DISP1, 0xd10, BIT(1) }, { DISP1, 0xdd4, BIT(3) },
+};
+static const struct { u8 bank, id; } relay_gates[] = {
+	{ OVL0, 105 }, { OVL1, 105 }, { DISP0, 37 }, { DISP0, 53 },
+	{ DISP0, 71 }, { DISP0, 73 }, { DISP1, 9 }, { DISP1, 11 },
+};
+struct scan_path {
+	struct scan_block block[BLOCKS];
+	struct regmap *map[BANKS];
+	struct clk *clocks[ARRAY_SIZE(relay_gates)];
+	u32 old_route[ARRAY_SIZE(route)];
+	unsigned int route_count, clock_count;
+};
+
+static void scan_write(struct scan_block *b, u16 reg, u32 mask, u32 value)
+{
+	u32 old = readl(b->base + reg);
+
+	if (WARN_ON(b->count >= ARRAY_SIZE(b->saved)))
+		return;
+	b->saved[b->count].reg = reg;
+	b->saved[b->count++].value = old;
+	writel((old & ~mask) | (value & mask), b->base + reg);
+}
+
+static int open_scan_block(struct scan_block *b, const char *path, unsigned int index)
+{
+	struct device_node *node __free(device_node) = of_find_node_by_path(path);
+	struct clk *clk;
+	void __iomem *base;
+	int ret;
+
+	if (!node || of_address_to_resource(node, index, &b->resource))
+		return -ENODEV;
+	clk = of_clk_get(node, index);
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+	ret = clk_prepare_enable(clk);
+	if (ret)
+		goto put;
+	base = of_io_request_and_map(node, index, "Turner dual scanout");
+	if (IS_ERR(base)) {
+		ret = PTR_ERR(base);
+		clk_disable_unprepare(clk);
+		goto put;
+	}
+	b->base = base;
+	b->clk = clk;
+	return 0;
+put:
+	clk_put(clk);
+	return ret;
+}
+
+static void close_scan_path(struct scan_path *p)
+{
+	int i;
+
+	/* Stop all four mutexes before altering any of their member blocks. */
+	for (i = BLOCKS - 1; i >= 0; i--) {
+		struct scan_block *b = &p->block[i];
+
+		while (b->count) {
+			--b->count;
+			writel(b->saved[b->count].value, b->base + b->saved[b->count].reg);
+		}
+	}
+	while (p->route_count) {
+		unsigned int j = --p->route_count;
+		regmap_write(p->map[route[j].bank], route[j].reg, p->old_route[j]);
+	}
+	while (p->clock_count) {
+		struct clk *clk = p->clocks[--p->clock_count];
+		clk_disable_unprepare(clk);
+		clk_put(clk);
+	}
+	for (i = BLOCKS - 1; i >= 0; i--) {
+		struct scan_block *b = &p->block[i];
+		if (!b->base)
+			continue;
+		iounmap(b->base);
+		release_mem_region(b->resource.start, resource_size(&b->resource));
+		clk_disable_unprepare(b->clk);
+		clk_put(b->clk);
+	}
+}
+
+static int start_scan_path(struct scan_path *p, struct device *dev)
+{
+	static const char * const nodes[] = {
+		"/soc/disp-ovl0-exdma3@32860000", "/soc/disp-ovl1-exdma3@32c60000",
+		"/soc/disp1-dsc-wrap0@32450000", "/soc/disp1-dsc-wrap1@32460000",
+		"/soc/disp-ovl0-blender1@328e0000", "/soc/disp-ovl1-blender1@32ce0000",
+		"/soc/disp-ovl0-outproc0@32970000", "/soc/disp-ovl1-outproc0@32d70000",
+	};
+
+	const u32 shape = (3008 << 16) | 940;
+	u32 pps[20] = {};
+	int i, j, ret;
+
+	for (i = 0; i < BLOCKS; i++) {
+		if (i < MUT_DIS0)
+			ret = open_scan_block(&p->block[i], nodes[i], 0);
+		else
+			ret = open_scan_block(&p->block[i], "/soc/disp1-mutex0@32020000",
+					      i - MUT_DIS0);
+		if (ret) {
+			dev_notice(dev, "scan block %d open error=%d\n", i, ret);
+			return ret;
+		}
+		if (readl(p->block[i].base + (i == DSC_L || i == DSC_R ? 0 : 0x20)) & 1)
+			return -EBUSY;
+	}
+	for (i = 0; i < BANKS; i++) {
+		struct device_node *np __free(device_node) = of_find_node_by_path(route_node[i]);
+		p->map[i] = syscon_node_to_regmap(np);
+		if (IS_ERR(p->map[i]))
+			return PTR_ERR(p->map[i]);
+	}
+	for (i = 0; i < ARRAY_SIZE(relay_gates); i++) {
+		struct device_node *np __free(device_node) =
+			of_find_node_by_path(route_node[relay_gates[i].bank]);
+		struct of_phandle_args spec = { .np = np, .args_count = 1,
+						.args = { relay_gates[i].id } };
+		struct clk *clk = of_clk_get_from_provider(&spec);
+		if (IS_ERR(clk))
+			return dev_err_probe(dev, PTR_ERR(clk), "relay clock %d\n", i);
+		ret = clk_prepare_enable(clk);
+		if (ret) {
+			clk_put(clk);
+			return ret;
+		}
+		p->clocks[p->clock_count++] = clk;
+	}
+	for (i = 0; i < ARRAY_SIZE(route); i++) {
+		struct regmap *m = p->map[route[i].bank];
+		ret = regmap_read(m, route[i].reg, &p->old_route[i]);
+		if (ret)
+			return ret;
+		p->route_count++;
+		ret = regmap_write(m, route[i].reg, route[i].val | (i < 6 ? p->old_route[i] : 0));
+		if (ret)
+			return ret;
+	}
+	turner_dsc_pack_pps(&turner_dsc, pps);
+	for (i = 0; i < 2; i++) {
+		struct scan_block *d = &p->block[DSC_L+i];
+
+		for (j = 0; j < ARRAY_SIZE(turner_dsc_config); j++) {
+			const struct turner_dsc_write *w = &turner_dsc_config[j];
+			scan_write(d, w->offset, w->mask, w->value);
+		}
+		for (j = 0; j < ARRAY_SIZE(pps); j++)
+			scan_write(d, 0x80 + j*4, U32_MAX, pps[j]);
+		scan_write(d, 0x228, 3, 3);
+		scan_write(d, 0, BIT(0), BIT(0));
+		writel(readl(d->base) | BIT(8), d->base);
+		writel(readl(d->base) & ~BIT(8), d->base);
+
+		struct scan_block *blend = &p->block[BLEND_L+i], *out = &p->block[OUT_L+i];
+
+		scan_write(blend, 0x28, BIT(2), BIT(2));
+		scan_write(blend, 0x30, U32_MAX, shape);
+		scan_write(blend, 0x104, U32_MAX, i ? 0xff00ff00 : 0xffff0000);
+		scan_write(blend, 0x10, BIT(0)|BIT(4)|BIT(5), BIT(4));
+		scan_write(blend, 0x40, BIT(0), 0);
+		scan_write(blend, 0x20, 0x31, 1);
+		scan_write(out, 0x28, BIT(2), BIT(2));
+		scan_write(out, 0x30, U32_MAX, shape);
+		scan_write(out, 0x20, 0x21, 1);
+	}
+	for (i = MUT_DIS0; i < BLOCKS; i++) {
+		struct scan_block *m = &p->block[i];
+		scan_write(m, 0x34, U32_MAX, i == MUT_DIS1 ? BIT(1)|BIT(2)|BIT(15)|BIT(17)|BIT(23)|BIT(25) :
+			   i == MUT_DIS0 ? BIT(16)|BIT(24) : BIT(11)|BIT(20));
+		scan_write(m, 0x38, U32_MAX, i == MUT_DIS0 ? BIT(1)|BIT(2) :
+			   i >= MUT_OVL0 ? BIT(16) : 0);
+		/* The active OEM path uses DSI1 SOF/EOF in the two right banks. */
+		scan_write(m, 0x30, U32_MAX, i == MUT_DIS1 || i == MUT_OVL1 ? 0x102 : 0x81);
+	}
+	return 0;
+}
+
+static void report_scan_path(struct scan_path *p, struct device *dev)
+{
+	int i;
+
+	for (i = 0; i < BANKS; i++) {
+		u32 start = i >= OVL0 ? 0xc50 : (i == DISP0 ? 0xc00 : 0xcc8);
+		u32 valid[6] = {}, ready[6] = {};
+		unsigned int n;
+		for (n = 0; n < 6; n++) {
+			regmap_read(p->map[i], start + n * 4, &valid[n]);
+			regmap_read(p->map[i], start + 24 + n * 4, &ready[n]);
+		}
+		dev_notice(dev, "scan bank=%d valid=%*phN ready=%*phN\n", i,
+			   (int)sizeof(valid), valid, (int)sizeof(ready), ready);
+	}
+	for (i = 0; i < 2; i++) {
+		void __iomem *f = p->block[FETCH_L+i].base, *d = p->block[DSC_L+i].base;
+
+		u32 count, size;
+		regmap_read(p->map[OVL0+i], 0x3ac, &count);
+		regmap_read(p->map[OVL0+i], 0x29c, &size);
+		dev_notice(dev, "OVL%d DLO5 size=%#x count=%#x\n", i, size, count);
+		dev_notice(dev, "blend side=%d color=%#x irq=%#x out_irq=%#x flow=%#x crc=%#x\n",
+			   i, readl(p->block[BLEND_L+i].base+0x104), readl(p->block[BLEND_L+i].base+8),
+			   readl(p->block[OUT_L+i].base+8), readl(p->block[OUT_L+i].base+0x108),
+			   readl(p->block[OUT_L+i].base+0x100));
+		dev_notice(dev, "scan side=%d fetch src=%#x color=%#x rdma=%#x flow=%#x pos=%#x irq=%#x DSC ctrl=%#x irq=%#x mutex=%#x\n",
+			   i, readl(f + 0x40), readl(f + 0x25c), readl(f + 0x100),
+			   readl(f + 0x240), readl(f + 0x244), readl(f + 8),
+			   readl(d), readl(d + 8), readl(p->block[MUT_DIS1].base + 4));
+	}
+}
--- /dev/null
+++ b/drivers/gpu/drm/mediatek/turner/service.h
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-2.0-only
+module_param(kms_stop, bool, 0600);
+
+
+static int turner_before_reboot(struct notifier_block *nb, unsigned long action, void *arg)
+{
+	WRITE_ONCE(kms_stop, true);
+
+	return NOTIFY_DONE;
+}
+static struct notifier_block turner_reboot_nb = { .notifier_call = turner_before_reboot };
+
+
+static int turner_check_buffer(struct device *left, struct device *right, struct turner_host *ctx)
+{
+	struct device *ports[] = { left, right };
+	struct turner_kms *kms;
+	struct platform_device *display;
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(ports); i++) {
+		struct iommu_domain *domain = iommu_get_domain_for_dev(ports[i]);
+
+		if (!domain || !iommu_is_dma_domain(domain))
+			return -EPROBE_DEFER;
+		ret = dma_set_mask_and_coherent(ports[i], DMA_BIT_MASK(34));
+		if (ret)
+			return ret;
+	}
+	display = platform_device_register_data(ctx->host.dev, "turner-kms",
+						PLATFORM_DEVID_AUTO, NULL, 0);
+	if (IS_ERR(display))
+		return PTR_ERR(display);
+	kms = devm_drm_dev_alloc(&display->dev, &turner_driver, struct turner_kms, drm);
+	if (IS_ERR(kms)) {
+		ret = PTR_ERR(kms);
+		goto remove;
+	}
+	kms->right = right;
+	kms->pending = kms->retiring = -1;
+	mutex_init(&kms->flip_lock);
+	init_waitqueue_head(&kms->flip_wait);
+	for (i = 0; i < ARRAY_SIZE(kms->slot); i++) {
+		struct turner_slot *slot = &kms->slot[i];
+		struct scatterlist *sg;
+		dma_addr_t end;
+		unsigned int n, off;
+		slot->cpu = dma_alloc_wc(left, TURNER_BYTES, &slot->addr[0], GFP_KERNEL);
+		if (!slot->cpu) {
+			ret = -ENOMEM;
+			goto release;
+		}
+		ret = dma_get_sgtable_attrs(left, &slot->table, slot->cpu, slot->addr[0],
+					    TURNER_BYTES, DMA_ATTR_WRITE_COMBINE);
+		if (ret)
+			goto release;
+		ret = dma_map_sgtable(right, &slot->table, DMA_TO_DEVICE, 0);
+		if (ret)
+			goto release;
+		slot->mapped = true;
+		end = slot->addr[1] = sg_dma_address(slot->table.sgl);
+		ret = -ERANGE;
+		for_each_sgtable_dma_sg(&slot->table, sg, n) {
+			if (sg_dma_address(sg) != end)
+				goto release;
+			end += sg_dma_len(sg);
+		}
+		if (end - slot->addr[1] < TURNER_BYTES)
+			goto release;
+		for (off = 0; off < TURNER_BYTES; off += PAGE_SIZE) {
+			phys_addr_t l = iommu_iova_to_phys(iommu_get_domain_for_dev(left), slot->addr[0] + off);
+			phys_addr_t r = iommu_iova_to_phys(iommu_get_domain_for_dev(right), slot->addr[1] + off);
+			if (!l || l != r)
+				goto release;
+		}
+	}
+	for (i = 0; i < 2; i++)
+		if (upper_32_bits(kms->slot[0].addr[i]) != upper_32_bits(kms->slot[1].addr[i]) ||
+		    upper_32_bits(kms->slot[1].addr[i]+TURNER_BYTES-1) != upper_32_bits(kms->slot[1].addr[i]) ||
+		    upper_32_bits(kms->slot[0].addr[i]+TURNER_BYTES-1) != upper_32_bits(kms->slot[0].addr[i])) {
+			ret = -ERANGE;
+			goto release;
+		}
+	INIT_WORK(&kms->shutdown, turner_shutdown_work);
+	ctx->kms = kms;
+	ret = turner_register_kms(kms);
+	if (ret)
+		goto release;
+	ret = register_reboot_notifier(&turner_reboot_nb);
+	if (ret) {
+		drm_dev_unplug(&kms->drm);
+		goto release;
+	}
+	dev_notice(ctx->host.dev, "KMS registered dual DSI\n");
+	while (!READ_ONCE(kms->finished) && !ctx->fetch_unsettled) {
+		unsigned int hz = READ_ONCE(kms->hz);
+
+		if (READ_ONCE(kms_stop))
+			schedule_work(&kms->shutdown);
+		for (i = 0; i < ARRAY_SIZE(turner_modes); i++)
+			if (drm_mode_vrefresh(&turner_modes[i]) == hz) {
+				int front;
+				mutex_lock(&kms->flip_lock);
+				front = kms->front;
+				kms->running = true;
+				mutex_unlock(&kms->flip_lock);
+				sample_video(ctx, &turner_modes[i], 0, kms->slot[front].addr);
+				mutex_lock(&kms->flip_lock);
+				kms->running = false;
+				if (kms->pending >= 0)
+					kms->front = kms->pending;
+				kms->pending = kms->retiring = -1;
+				mutex_unlock(&kms->flip_lock);
+				wake_up_all(&kms->flip_wait);
+				break;
+			}
+		msleep(2);
+	}
+	if (!READ_ONCE(kms->finished))
+		schedule_work(&kms->shutdown);
+	flush_work(&kms->shutdown);
+	if (ctx->fetch_unsettled)
+		ret = -ETIMEDOUT;
+	unregister_reboot_notifier(&turner_reboot_nb);
+release:
+	ctx->kms = NULL;
+	for (i = 0; !ctx->fetch_unsettled && i < ARRAY_SIZE(kms->slot); i++) {
+		struct turner_slot *slot = &kms->slot[i];
+		if (slot->mapped)
+			dma_unmap_sgtable(right, &slot->table, DMA_TO_DEVICE, 0);
+		if (slot->table.sgl)
+			sg_free_table(&slot->table);
+		if (slot->cpu)
+			dma_free_wc(left, TURNER_BYTES, slot->cpu, slot->addr[0]);
+	}
+remove:
+	platform_device_unregister(display);
+	return ret;
+}
