+static void turner_crtc_enable(struct drm_crtc *crtc, struct drm_atomic_commit *state)
+{
+	WRITE_ONCE(to_kms(crtc->dev)->hz, drm_mode_vrefresh(&crtc->state->mode));
+	drm_crtc_vblank_on(crtc);
+}
+
+static void turner_crtc_disable(struct drm_crtc *crtc, struct drm_atomic_commit *state)
+{
+	WRITE_ONCE(to_kms(crtc->dev)->hz, 0);
+	drm_crtc_vblank_off(crtc);
+}
