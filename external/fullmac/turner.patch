+++ b/drivers/misc/mediatek/connectivity/conninfra/conn_drv/connv3/core/connv3_core.c
@@ -5,6 +5,7 @@
 
 #define pr_fmt(fmt) KBUILD_MODNAME "@(%s:%d) " fmt, __func__, __LINE__
 
+#include <linux/moduleparam.h>
 #include "conninfra_conf.h"
 #include "connv3.h"
 #include "connv3_hw.h"
@@ -191,6 +192,21 @@ enum pre_cal_type {
 
 static unsigned int g_pre_cal_mode = PRE_CAL_SCREEN_ON_DISABLED;
 
+static int pre_cal_ready_get(char *buf, const struct kernel_param *kp)
+{
+	bool ready = READ_ONCE(g_pre_cal_mode) == PRE_CAL_ALL_DISABLED ||
+		     READ_ONCE(g_connv3_ctx.cal_info.status) == PRE_CAL_DONE;
+
+	return sysfs_emit(buf, "%u\n", ready);
+}
+
+static const struct kernel_param_ops pre_cal_ready_ops = {
+	.get = pre_cal_ready_get,
+};
+module_param_cb(pre_cal_ready, &pre_cal_ready_ops, NULL, 0444);
+MODULE_PARM_DESC(pre_cal_ready, "Initial shared-radio pre-calibration has finished or is disabled");
+
