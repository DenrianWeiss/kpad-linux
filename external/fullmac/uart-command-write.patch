--- a/drivers/misc/mediatek/connectivity/bt/linux_v2/uart/btmtktty.c
+++ b/drivers/misc/mediatek/connectivity/bt/linux_v2/uart/btmtktty.c
@@ -1824,6 +1824,8 @@
 			break;
 		}
 		ret = cif_dev->tty->ops->write(cif_dev->tty, cmd + len, cmd_len - len);
