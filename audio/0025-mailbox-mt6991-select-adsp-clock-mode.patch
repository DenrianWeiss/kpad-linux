+		return dev_err_probe(dev, PTR_ERR(mb->pll), "getting ADSP PLL\n");
+	mb->clk26m = devm_clk_get(dev, "clk_top_clk26m");
+	if (IS_ERR(mb->clk26m))
+		return dev_err_probe(dev, PTR_ERR(mb->clk26m), "getting 26 MHz clock\n");
 	platform_set_drvdata(pdev, mb);
 
 	for (i = 0; i < ARRAY_SIZE(mb->rx); i++) {
@@ -194,6 +255,7 @@
 	.driver = {
 		.name = "mt6991-adsp-mailbox",
