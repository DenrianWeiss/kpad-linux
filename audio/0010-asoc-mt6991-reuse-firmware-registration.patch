-};
+	struct regmap *spm;
+	bool firmware_ready;
+};
+
+static long mt6991_audio_call(unsigned int op)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(MTK_SIP_AUDIO_CONTROL, op, 0, 0, 0, 0, 0, 0, &res);
+	return res.a0;
+}
+
+static int mt6991_audio_result(struct device *dev, unsigned int op, long status)
+{
+	if (!status)
+		return 0;
+	dev_err(dev, "audio firmware operation %u returned %ld\n", op, status);
+	return -EIO;
+}
 
 static int mt6991_audio_smc(struct device *dev, unsigned int op)
 {
-	struct arm_smccc_res res;
-
-	arm_smccc_smc(MTK_SIP_AUDIO_CONTROL, op, 0, 0, 0, 0, 0, 0, &res);
-	if (res.a0) {
-		dev_err(dev, "audio firmware operation %u returned %#lx\n", op, res.a0);
-		return -EIO;
-	}
-	return 0;
+	return mt6991_audio_result(dev, op, mt6991_audio_call(op));
+}
+
+static int mt6991_afe_sidebands(struct device *dev, struct mt6991_afe *afe)
+{
+	long status = mt6991_audio_call(MTK_AUDIO_SMC_OP_DOMAIN_SIDEBANDS);
+	unsigned int power;
+	int ret;
+
+	/*
+	 * Firmware keeps the AUDIO registration across unbind and kexec.
+	 * A first sideband call returns -5 for either a missing registration
+	 * or an unpowered domain. INIT consumes a slot on every invocation.
+	 */
+	if (status == -5 && !afe->firmware_ready) {
+		ret = regmap_read(afe->spm, MT6991_AUDIO_PWR_CON, &power);
+		if (ret)
+			return ret;
+		if ((power & MT6991_AUDIO_PWR_ACK) == MT6991_AUDIO_PWR_ACK) {
+			ret = mt6991_audio_smc(dev, MTK_AUDIO_SMC_OP_INIT);
+			if (ret)
+				return ret;
+			afe->firmware_ready = true;
+			dev_dbg(dev, "registered AUDIO firmware resource\n");
+			status = mt6991_audio_call(MTK_AUDIO_SMC_OP_DOMAIN_SIDEBANDS);
+		}
+	}
+	if (!status)
+		afe->firmware_ready = true;
+	return mt6991_audio_result(dev, MTK_AUDIO_SMC_OP_DOMAIN_SIDEBANDS, status);
 }
 
