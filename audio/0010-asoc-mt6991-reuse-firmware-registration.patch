 #include "../common/mtk-base-afe.h"
 
+#define MT6991_AUDIO_PWR_CON	0xe4c
+#define MT6991_AUDIO_PWR_ACK	GENMASK(31, 30)
+
 #define AFE_DL0_CON0	0x4460
 
 enum mt6991_bus_clock {
@@ -21,18 +26,58 @@
 	struct clk_bulk_data bus[NUM_BUS_CLKS];
