+/* The logger firmware consumes four little-endian address/length pairs. */
+static int mt6991_adsp_prepare_loggers(struct device *dev, struct mt6991_adsp_tx *msgs)
+{
+	static const u8 ids[][4] = { { 0, 3, 1, 10 }, { 4, 7, 5, 10 } };
+	struct mt6991_adsp_block blocks[ARRAY_SIZE(adsp_block_names)];
+	struct device_node *sys __free(device_node) = of_parse_phandle(dev->of_node, "mboxes", 0);
+	u64 range[2];
+	int ret, i, j;
+
+	if (!sys)
+		return -ENODEV;
+	/* Use this transfer sequence only on the stock Turner mailbox layout. */
+	if (of_property_match_string(sys, "reg-names", "infracfg_rsv") >= 0 ||
+	    of_property_match_string(sys, "reg-names", "ipic_chn") >= 0)
+		return -EOPNOTSUPP;
+	ret = mt6991_adsp_layout(sys, range, blocks);
+	if (ret)
+		return ret;
+	if (!IS_ALIGNED(range[0], SZ_4K))
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(ids); i++) {
+		const struct mt6991_adsp_block *log = &blocks[ids[i][0]];
+		void __iomem *mem;
+
+		if (log->size < SZ_64K)
+			return -EINVAL;
+		msgs[i].id = 4;
+		msgs[i].len = 64;
+		for (j = 0; j < ARRAY_SIZE(ids[i]); j++) {
+			const struct mt6991_adsp_block *block = &blocks[ids[i][j]];
+
+			put_unaligned_le64(block->address, msgs[i].payload + 16 * j);
+			put_unaligned_le64(block->size, msgs[i].payload + 16 * j + 8);
+		}
+		/* Both cores are stalled; initialize only their dedicated log rings. */
+		mem = ioremap_wc(log->address, log->size);
+		if (!mem)
+			return -ENOMEM;
+		memset_io(mem, 0, log->size);
+		writel(0x504c5402, mem);
+		writel(0x18, mem + 4);
+		writel(0x80, mem + 12);
+		writel(0x180, mem + 16);
+		writel(log->size - 0x180, mem + 20);
+		wmb();
+		iounmap(mem);
+	}
+	return 0;
+}
+
+static int mt6991_adsp_logger_reply(struct device *dev, struct mt6991_adsp_tx *msg)
+{
+	struct mt6991_adsp_core *core = dev_get_drvdata(dev);
+	struct mbox_client client = { .dev = dev, .tx_block = true, .tx_tout = 200 };
+	struct mbox_chan *tx;
+	int ret;
+
+	if (!wait_for_completion_timeout(&core->logger_request, msecs_to_jiffies(500)))
+		return -ETIMEDOUT;
+	tx = mbox_request_channel(&client, 0);
+	if (IS_ERR(tx))
+		return PTR_ERR(tx);
+	ret = mbox_send_message(tx, msg);
+	mbox_free_channel(tx);
+	return ret < 0 ? ret : 0;
+}
