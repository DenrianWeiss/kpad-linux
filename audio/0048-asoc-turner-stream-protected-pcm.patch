+static int configure(struct device *dev, const struct field *settings, size_t n)
+{
+	struct regmap *m = dev_get_regmap(dev, NULL);
+	unsigned int product, version, f0, f3, f4, state, key, ctrl;
+	int ret;
+
+	if (!m)
+		return -ENODEV;
+	ret = regmap_read(m, 0, &ctrl);
+	if (ret || (ctrl & 0x18))
+		return ret ?: -EBUSY;
+	ret = regmap_clear_bits(m, 0, 1);
+	if (!ret)
+		ret = regmap_clear_bits(m, 4, BIT(6));
+	if (!ret)
+		ret = regmap_read_poll_timeout(m, 0x12, state,
+					       (state & 15) == 1, 500, 50000);
+	if (ret)
+		return ret;
+	if (regmap_read(m, 3, &product) || regmap_read(m, 6, &version) ||
+	    regmap_read(m, 0xf0, &f0) || regmap_read(m, 0xf3, &f3) ||
+	    regmap_read(m, 0xf4, &f4))
+		return -EIO;
+	if (product != 0x9866 || version != 0x0507 || !(f3 & GENMASK(12, 11)) ||
+	    (f0 & BIT(9)) || (f4 & BIT(15)))
+		return -ENODEV;
+	ret = regmap_write(m, 0x0f, 0x5a6b);
+	if (!ret)
+		ret = regmap_read(m, 0xfb, &key);
+	if (!ret)
+		ret = regmap_write(m, 0xa0, key ^ 0x005a);
+	if (!ret)
+		ret = regmap_write(m, 0xa1, 0x5a);
+	for (size_t i = 0; !ret && i < ARRAY_SIZE(startup); i++)
+		ret = regmap_write(m, startup[i].reg, startup[i].def);
+	if (ret)
+		return ret;
+	ret = regmap_read_poll_timeout(m, 0x12, state, !(state & 15), 500,
+				       50000);
+	if (!ret)
+		ret = regmap_set_bits(m, 4, BIT(6));
+	for (size_t i = 0; !ret && i < n; i++) {
+		u16 id = settings[i].id, shift = (id >> 4) & 15;
+		u16 mask = (BIT((id & 15) + 1) - 1) << shift;
+		u16 value = settings[i].value << shift;
+		unsigned int actual;
+
+		/* Defer boost enable until the protected playback test. */
+		if (id == 0x0040)
+			continue;
+		ret = regmap_update_bits(m, id >> 8, mask, value);
+		if (!ret)
+			ret = regmap_read(m, id >> 8, &actual);
+		if (!ret && (actual & mask) != value) {
+			dev_err(dev, "field %04x expected %04x read %04x\n", id,
+				value, actual);
+			ret = -EIO;
+		}
+	}
+	if (!ret)
+		ret = regmap_write(m, 0xa1, 0);
+	if (!ret)
+		ret = regmap_write(m, 0x0f, 0);
+	if (!ret)
+		ret = regmap_set_bits(m, 1, BIT(2));
+	if (!ret)
+		ret = regmap_clear_bits(m, 0, BIT(0));
+	if (!ret)
+		ret = regmap_read_poll_timeout(m, 0x11, state, state & BIT(0),
+					       1000, 50000);
+	dev_info(dev,
+		 "Turner muted profile 0x110b65 status=%04x clock ret=%d\n",
+		 state, ret);
+	return ret;
+}
+
+static bool test_layout_matches(struct device *dev, phys_addr_t output)
+{
+	static const char *const prior[] = {
+		"adsp-rsv-logger-a", "adsp-rsv-dbg-dump-a",
+		"adsp-rsv-ipidma-a", "adsp-rsv-core-dump-a",
+		"adsp-rsv-logger-b", "adsp-rsv-dbg-dump-b",
+		"adsp-rsv-ipidma-b", "adsp-rsv-core-dump-b",
+		"adsp-rsv-c2c",	     "adsp-rsv-pcie",
+		"adsp-rsv-l2sram",   "adsp-rsv-xhci",
+	};
+	struct device_node *sys __free(device_node) =
+		of_parse_phandle(dev->of_node, "mboxes", 0);
+	u64 range[2], offset = 0;
+	u32 size;
+	int i;
+
+	if (!sys || of_property_read_u64_array(sys, "shared_memory", range, 2))
+		return false;
+	for (i = 0; i < ARRAY_SIZE(prior); i++)
+		if (!of_property_read_u32(sys, prior[i], &size))
+			offset += ALIGN((u64)size, SZ_4K);
+	return !of_property_read_u32(sys, "adsp-rsv-audio", &size) &&
+	       size >= SZ_4K + 4 * SZ_16K && offset + size <= range[1] &&
+	       output == range[0] + offset + SZ_4K + SZ_16K;
+}
+
+static int trigger(struct mbox_chan *tx, u16 command)
+{
+	struct mt6991_adsp_tx msg = { .id = 9, .len = 16 };
+
+	put_unaligned_le16(0x8888, msg.payload);
+	msg.payload[2] = 32;
+	msg.payload[3] = 0x21;
+	msg.payload[5] = 3;
+	put_unaligned_le16(command, msg.payload + 6);
+	put_unaligned_le32(1, msg.payload + 8);
+	return mbox_send_message(tx, &msg);
+}
+
+static int send_measured_cal(struct device *dev, struct mbox_chan *tx)
+{
+	struct device_node *sys __free(device_node) =
+		of_parse_phandle(dev->of_node, "mboxes", 0);
+	struct mt6991_adsp_tx m = { .id = 9, .len = 72 };
+	const struct firmware *fw;
+	u64 range[2];
+	u32 a, b, size, w, next;
+	void __iomem *pool, *desc, *ring;
+	int ret;
+	if (!sys ||
+	    of_property_read_u64_array(sys, "shared_memory", range, 2) ||
+	    of_property_read_u32(sys, "adsp-rsv-logger-a", &a) ||
+	    of_property_read_u32(sys, "adsp-rsv-dbg-dump-a", &b) ||
+	    of_property_read_u32(sys, "adsp-rsv-ipidma-a", &size) ||
+	    size != SZ_1M ||
+	    ALIGN((u64)a, SZ_4K) + ALIGN((u64)b, SZ_4K) + size > range[1])
+		return -EINVAL;
+	ret = request_firmware(&fw, "mediatek/turner/turner-unit-cal.bin", dev);
+	if (ret)
+		return ret;
+	if (fw->size != 9 || memcmp(fw->data, "\x00\x81\x05", 3)) {
+		ret = -EINVAL;
+		goto release;
+	}
+	pool = ioremap_wc(range[0] + ALIGN(a, SZ_4K) + ALIGN(b, SZ_4K), size);
+	if (!pool) {
+		ret = -ENOMEM;
+		goto release;
+	}
+	desc = pool + 32 * 0x300 + 0x80;
+	w = readl(desc + 0x100);
+	if (readl(desc) != ALIGN(0x8484, 128) || readl(desc + 4) != SZ_32K ||
+	    w != readl(desc + 0x80) || w > SZ_32K - 128 ||
+	    !IS_ALIGNED(w, 128)) {
+		ret = -ERANGE;
+		goto unmap;
+	}
+	ring = pool + readl(desc);
+	memcpy_toio(ring + w, fw->data, 9);
+	wmb();
+	next = (w + 128) % SZ_32K;
+	writel(next, desc + 0x100);
+	wmb();
+	put_unaligned_le16(0x8888, m.payload);
+	m.payload[2] = 32;
+	m.payload[3] = 0x21;
+	m.payload[4] = 2;
+	m.payload[5] = 1;
+	put_unaligned_le16(0x204, m.payload + 6);
+	put_unaligned_le32(9, m.payload + 8);
+	put_unaligned_le32(3, m.payload + 12);
+	put_unaligned_le32(9, m.payload + 0x24);
+	put_unaligned_le32(w, m.payload + 0x30);
+	put_unaligned_le32(9, m.payload + 0x34);
+	ret = mbox_send_message(tx, &m);
+	if (ret >= 0)
+		ret = readl_poll_timeout(desc + 0x80, w, w == next, 100,
+					 300000);
+	pr_info("turner-trigger measured cal transport=%d\n", ret);
+unmap:
+	iounmap(pool);
+release:
+	release_firmware(fw);
+	return ret;
+}
+
+static int source_msg(struct mbox_chan *tx, u16 cmd, u8 ack, u32 param,
+		      const void *body, u32 len)
+{
+	struct mt6991_adsp_tx m = { .id = 9, .len = 16 + len };
+	put_unaligned_le16(0x8888, m.payload);
+	m.payload[2] = 7;
+	m.payload[3] = 0x21;
+	m.payload[4] = !!len;
+	m.payload[5] = ack;
+	put_unaligned_le16(cmd, m.payload + 6);
+	put_unaligned_le32(param, m.payload + 8);
+	if (len)
+		memcpy(m.payload + 16, body, len);
+	int ret = mbox_send_message(tx, &m);
+	usleep_range(2000, 2500);
+	return ret < 0 ? ret : 0;
+}
+
+static int source_setup(struct mbox_chan *tx, void __iomem *mem,
+			phys_addr_t base, u8 *buf)
+{
+	u64 start = base + SZ_4K + 3 * SZ_16K;
+	__le64 ptrs[4];
+	u8 desc[96];
+	int ret = source_msg(tx, 0x19, 0, 0, NULL, 0);
+	for (int i = 0; !ret && i < 2; i++) {
+		u32 off = (i + 2) * SZ_1K;
+		ptrs[0] = cpu_to_le64(base + off);
+		ptrs[1] = cpu_to_le64((unsigned long)(mem + off));
+		ptrs[2] = cpu_to_le64(SZ_1K);
+		ptrs[3] = ptrs[1];
+		ret = source_msg(tx, 5 + i, 0, 32, ptrs, 32);
+	}
+	if (ret)
+		return ret;
+	ret = source_msg(tx, 1, 1, 0, NULL, 0);
+	memcpy_fromio(desc, mem, sizeof(desc));
+	put_unaligned_le64(start, desc);
+	put_unaligned_le64(start + SZ_16K, desc + 8);
+	put_unaligned_le64(start, desc + 16);
+	put_unaligned_le64(start, desc + 24);
+	put_unaligned_le32(0, desc + 84);
+	memcpy_toio(mem + 2 * SZ_1K, desc, sizeof(desc));
+	wmb();
+	ptrs[0] = cpu_to_le64(base + 2 * SZ_1K);
+	if (!ret)
+		ret = source_msg(tx, 4, 1, 8, ptrs, 8);
+	if (!ret)
+		ret = source_msg(tx, 3, 1, 8, ptrs, 8);
+	if (ret)
+		return ret;
+	memset(buf, 0, SZ_16K);
+	memcpy_toio(mem + SZ_4K + 3 * SZ_16K, buf, SZ_16K);
+	for (int i = 0; !ret && i < 3; i++) {
+		put_unaligned_le64(start + SZ_4K * (i + 1), desc + 24);
+		put_unaligned_le32(i, desc + 84);
+		memcpy_toio(mem + 2 * SZ_1K, desc, sizeof(desc));
+		wmb();
+		ret = source_msg(tx, 10, 1, 8, ptrs, 8);
+	}
+	return ret;
+}
+
+static int amp_ok(struct regmap *map)
+{
+	unsigned int status, irq;
+	if (regmap_read(map, 0x11, &status) || regmap_read(map, 0x40, &irq))
+		return -EIO;
+	if ((status & 0x81) != 0x81 || status & 0x1104 || irq & 0xffe) {
+		pr_err("turner-tone fault status=%04x irq=%04x\n", status, irq);
+		return -EIO;
+	}
+	return 0;
+}
+struct afe_field {
+	unsigned int reg, mask, value, saved;
+};
+
+/* 48 kHz PCM32 stereo. IRQ12 and IRQ16 go to DSP core A. */
+static const struct afe_field field_defaults[] = {
+	
+	{ 0x4640, GENMASK(29, 24) | GENMASK(12, 8) | 7, 2 << 24 | 10 << 8 | 2 },
+	{ 0x4e10, GENMASK(12, 8) | BIT(4) | 7, 10 << 8 | 2 },
+	{ 0x1a4, GENMASK(23, 0), 512 },
+	{ 0x1c4, GENMASK(23, 0), 512 },
+	{ 0x104, BIT(12) | BIT(16), BIT(12) | BIT(16) },
+	{ 0x1a0, GENMASK(8, 4) | BIT(0), 10 << 4 | 1 },
+	{ 0x1c0, GENMASK(8, 4) | BIT(0), 10 << 4 | 1 },
+	{ 0x4e10, BIT(28), BIT(28) },
+	{ 0x4640, BIT(31), BIT(31) },
+};
+
+static int check_window(struct regmap *map, unsigned int reg, u64 expected,
+			unsigned int enable)
+{
+	unsigned int hi, lo, ctrl;
+	int ret;
+
+	ret = regmap_read(map, reg + 32, &ctrl);
+	if (ret || ctrl & enable)
+		return ret ?: -EBUSY;
+	for (int i = 0; i < 2; i++, reg += 16, expected += SZ_16K - 1) {
+		if (regmap_read(map, reg, &hi) ||
+		    regmap_read(map, reg + 4, &lo))
+			return -EIO;
+		if (((u64)hi << 32 | lo) != expected)
+			return -ERANGE;
+	}
+	return 0;
+}
