+#include "mt6991-stream.h"
+
+/* The protected source is four stereo S32 periods.  Follow the output DMA
+ * cursor to avoid clock drift between Linux and the DSP during long streams.
+ */
+static int wait_period(struct regmap *map, u32 base, unsigned int *last, unsigned int *credit, ktime_t *tick)
+{
+	unsigned int pos;
+	unsigned int elapsed;
+	int ret;
+
+	/* The source FIFO is four periods deep. Refill a missed slot from its
+	 * reserve when Linux was late, without resetting the amplifiers.
+	 */
+	if (*credit) {
+		--*credit;
+		return 0;
+	}
+	ret = regmap_read_poll_timeout(map, 0x462c, pos,
+		pos - base < SZ_16K && (pos - base) / SZ_4K != *last,
+		300, 30000);
+	if (ret)
+		return ret;
+	pos = (pos - base) / SZ_4K;
+	elapsed = *last < 4 ? (pos + 4 - *last) % 4 : 1;
+	if (ktime_us_delta(ktime_get(), *tick) >= 4 * 10667)
+		return -EPIPE;
+	*tick = ktime_get();
+	*credit = elapsed - 1;
+	*last = pos;
+	return 0;
+}
+
+static int submit(struct mbox_chan *tx, void __iomem *mem, phys_addr_t base,
+		  unsigned int seq, u8 *buf)
+{
+	u64 start = base + SZ_4K + 3 * SZ_16K;
+	unsigned int slot = seq % 4;
+	__le64 ptr = cpu_to_le64(base + 2 * SZ_1K);
+	u8 desc[96];
+
+	memcpy_toio(mem + SZ_4K + 3 * SZ_16K + slot * SZ_4K, buf, SZ_4K);
+	memcpy_fromio(desc, mem + 2 * SZ_1K, sizeof(desc));
+	put_unaligned_le64(start + ((slot + 1) % 4) * SZ_4K, desc + 24);
+	put_unaligned_le32(seq, desc + 84);
+	memcpy_toio(mem + 2 * SZ_1K, desc, sizeof(desc));
+	wmb();
+	return source_msg(tx, 10, 1, 8, &ptr, 8);
+}
+static int play_stream(struct turner_stream *stream)
+{
+	struct device *dev __free(put_device) = bus_find_device_by_name(
+		&platform_bus_type, NULL, "1a060000.adsp-core0");
+	struct mbox_client client = { .dev = dev,
+				      .tx_block = true,
+				      .tx_tout = 200 };
+	phys_addr_t out, iv;
+	struct mbox_chan *tx;
+	u8 *buf __free(kfree) = NULL;
+	void __iomem *mem;
+	struct device *afe __free(put_device) = bus_find_device_by_name(
+		&platform_bus_type, NULL, "1a110000.mt6991-afe-pcm");
+	struct regmap *map;
+
+	struct afe_field fields[ARRAY_SIZE(field_defaults)];
+	struct snd_pcm_substream *pcm = stream->pcm;
+	struct snd_pcm_runtime *rt = pcm->runtime;
+	unsigned int last = 0, seq, drain_ticks = 0, tail_frames = 0, credit = 0;
+	ktime_t tick;
+	unsigned int iv_missing = 0, feedback_checks = 0, output_peak = 0;
+	snd_pcm_uframes_t pos = 0;
+	int ret, stop, i, changed = 0;
+	memcpy(fields, field_defaults, sizeof(fields));
+
+	struct device *left __free(put_device) =
+		bus_find_device_by_name(&i2c_bus_type, NULL, "0-0034");
+	struct device *right __free(put_device) =
+		bus_find_device_by_name(&i2c_bus_type, NULL, "0-0036");
+	struct device *card __free(put_device) =
+		bus_find_device_by_name(&platform_bus_type, NULL, "sound");
+	struct reset_control *reset = NULL;
+	struct pinctrl *pins = NULL;
+	struct regmap *amps[2];
+	bool awake = false;
+	if (!left || !right || !card)
+		return -ENODEV;
+	amps[0] = dev_get_regmap(left, NULL);
+	amps[1] = dev_get_regmap(right, NULL);
+	if (!amps[0] || !amps[1])
+		return -ENODEV;
+	if (!dev || !afe)
+		return -ENODEV;
+	ret = mt6991_adsp_memif_windows(dev, &out, &iv);
+	if (ret)
+		return ret;
+	if (!test_layout_matches(dev, out) || iv != out + SZ_16K)
+		return -ERANGE;
+	buf = kmalloc(SZ_16K, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	mem = ioremap_wc(out - SZ_16K - SZ_4K, SZ_4K + 4 * SZ_16K);
+	if (!mem)
+		return -ENOMEM;
+	tx = mbox_request_channel(&client, 0);
+	if (IS_ERR(tx)) {
+		ret = PTR_ERR(tx);
+		goto unmap;
+	}
+	map = dev_get_regmap(afe, NULL);
+	if (!map || pm_runtime_get_if_in_use(afe) <= 0) {
+		ret = -EAGAIN;
+		goto free_tx;
+	}
+	ret = check_window(map, 0x4620, out, BIT(31));
+	if (!ret)
+		ret = check_window(map, 0x4df0, iv, BIT(28));
+	if (ret)
+		goto restore;
+	for (i = 0; i < ARRAY_SIZE(fields); i++) {
+		struct afe_field *f = &fields[i];
+
+		ret = regmap_read(map, f->reg, &f->saved);
+		if (ret)
+			goto restore;
+		changed++;
+		ret = regmap_update_bits(map, f->reg, f->mask, f->value);
+		if (ret)
+			goto restore;
+	}
+	ret = send_measured_cal(dev, tx);
+	if (ret < 0)
+		goto restore;
+
+	pins = pinctrl_get_select(card, "i2s4-active");
+	if (IS_ERR(pins)) {
+		ret = PTR_ERR(pins);
+		pins = NULL;
+		goto restore;
+	}
+	reset = reset_control_get_shared(left, NULL);
+	if (IS_ERR(reset)) {
+		ret = PTR_ERR(reset);
+		reset = NULL;
+		goto restore;
+	}
+
+	ret = reset_control_deassert(reset);
+	if (ret)
+		goto restore;
+	awake = true;
+	usleep_range(2500, 3000);
+	ret = configure(left, profile_34, ARRAY_SIZE(profile_34));
+	if (!ret)
+		ret = configure(right, profile_36, ARRAY_SIZE(profile_36));
+	if (ret)
+		goto restore;
+
+	ret = trigger(tx, 0xf);
+	if (ret >= 0)
+		ret = source_setup(tx, mem, out - SZ_16K - SZ_4K, buf);
+	if (!ret)
+		ret = source_msg(tx, 15, 3, 1, NULL, 0);
+	if (!ret)
+		ret = regmap_read(map, 0x462c, &last);
+	last = (last - lower_32_bits(out)) / SZ_4K;
+	tick = ktime_get();
+	for (seq = 3; !ret && READ_ONCE(stream->running); seq++) {
+		unsigned int frames = 0;
+		snd_pcm_uframes_t appl, ready;
+		ret = wait_period(map, lower_32_bits(out), &last, &credit, &tick);
+		if (ret || !READ_ONCE(stream->running))
+			break;
+		if (seq >= 10) {
+			for (i = 0; i < 2 && !ret; i++) {
+				ret = amp_ok(amps[i]);
+				if (!ret && seq == 10)
+					ret = regmap_set_bits(amps[i], 0, BIT(4) | BIT(3));
+			}
+			if (ret)
+				break;
+		}
+		if (seq >= 26 && !(seq % 8)) {
+			u32 iv_bits = 0, peak = 0;
+
+			for (unsigned int off = 0; off < SZ_16K; off += 132) {
+				s32 sample = readl(mem + SZ_4K + SZ_16K + off);
+
+				peak = max(peak, (u32)abs(sample >> 8));
+				iv_bits |= readl(mem + SZ_4K + 2 * SZ_16K + off);
+			}
+			output_peak = max(peak, output_peak);
+			if (iv_bits)
+				feedback_checks++;
+			if (peak > 128 && !iv_bits) {
+				if (++iv_missing >= 2) {
+					dev_err(dev, "speaker output active without IV feedback\n");
+					ret = -EIO;
+					break;
+				}
+			} else {
+				iv_missing = 0;
+			}
+		}
+		memset(buf, 0, SZ_4K);
+		if (seq >= 10 && !drain_ticks) {
+			appl = READ_ONCE(rt->control->appl_ptr);
+			ready = appl >= pos ? appl - pos : rt->boundary - pos + appl;
+			frames = min_t(snd_pcm_uframes_t, ready, 512);
+			for (unsigned int j = 0; j < frames; j++) {
+				const u8 *p = rt->dma_area + ((pos + j) % rt->buffer_size) * 8;
+				for (unsigned int ch = 0; ch < 2; ch++) {
+					s32 v = get_unaligned_le32(p + ch * 4);
+					/* Reserve 18 dB of digital headroom ahead of the calibrated DSP. */
+					put_unaligned_le32(v / 8, buf + j * 8 + ch * 4);
+				}
+			}
+			pos = (pos + frames) % rt->boundary;
+		}
+		ret = submit(tx, mem, out - SZ_16K - SZ_4K, seq, buf);
+		if (ret)
+			break;
+		/* ALSA may reuse a period as soon as the DSP owns its copy.
+		 * Hold the final notification through the firmware FIFO on drain.
+		 */
+		if (!drain_ticks && frames && READ_ONCE(rt->state) == SNDRV_PCM_STATE_DRAINING &&
+		    READ_ONCE(rt->control->appl_ptr) == pos) {
+			tail_frames = frames;
+			drain_ticks = 5;
+			frames = 0;
+		}
+		if (drain_ticks && !--drain_ticks) {
+			frames = tail_frames;
+			tail_frames = 0;
+		}
+		if (frames) {
+			WRITE_ONCE(stream->position, (stream->position + frames) % rt->buffer_size);
+			snd_pcm_period_elapsed(pcm);
+		}
+	}
+	if (awake)
+		for (int j = 0; j < 2; j++)
+			regmap_clear_bits(amps[j], 0, BIT(3) | BIT(4));
+	source_msg(tx, 16, 3, 1, NULL, 0);
+	source_msg(tx, 9, 1, 1, NULL, 0);
+	source_msg(tx, 2, 1, 0, NULL, 0);
+	stop = trigger(tx, 0x10);
+
+	dev_info(dev, "speaker stream status=%d stop=%d feedback=%u peak=%u\n",
+		 ret, stop, feedback_checks, output_peak);
+	if (ret >= 0)
+		ret = min(stop, 0);
+restore:
+
+	if (awake && reset_control_assert(reset))
+		ret = -EIO;
+	if (reset)
+		reset_control_put(reset);
+	if (pins)
+		pinctrl_put(pins);
+	while (changed) {
+		struct afe_field *f = &fields[--changed];
+		int err = regmap_update_bits(map, f->reg, f->mask, f->saved);
+
+		if (!ret)
+			ret = err;
+	}
+	pm_runtime_put(afe);
+free_tx:
+	mbox_free_channel(tx);
+unmap:
+	iounmap(mem);
+	return ret;
+}
+
+void turner_playback_work(struct work_struct *work)
+{
+	struct turner_stream *stream = container_of(work, struct turner_stream, work);
+	int ret = play_stream(stream);
+
+	if (ret && READ_ONCE(stream->running)) {
+		pr_err_ratelimited("turner protected playback failed: %d\n", ret);
+		snd_pcm_stop_xrun(stream->pcm);
+	}
+}
