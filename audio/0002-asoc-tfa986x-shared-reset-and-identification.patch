--- /dev/null
+++ b/sound/soc/codecs/tfa986x.c
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* NXP TFA986x smart amplifier */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+
+#define TFA986X_REVISION	0x03
+
+struct tfa986x {
+	struct regmap *regmap;
+	struct reset_control *reset;
+};
+
+/* Serialize the minimum pulse width across both clients sharing one GPIO. */
+static DEFINE_MUTEX(tfa986x_reset_lock);
+
+static const struct regmap_config tfa986x_regmap_config = {
+	.reg_bits = 8,
+	.val_bits = 16,
+	.val_format_endian = REGMAP_ENDIAN_BIG,
+};
+
+static int tfa986x_runtime_resume(struct device *dev)
+{
+	struct tfa986x *tfa = dev_get_drvdata(dev);
+	int ret;
+
+	guard(mutex)(&tfa986x_reset_lock);
+	/* The first user releases the common active-low reset. */
+	usleep_range(2000, 2500);
+	ret = reset_control_deassert(tfa->reset);
+	if (ret)
+		return ret;
+	usleep_range(2000, 2500);
+	return 0;
+}
+
+static int tfa986x_runtime_suspend(struct device *dev)
+{
+	struct tfa986x *tfa = dev_get_drvdata(dev);
+
+	guard(mutex)(&tfa986x_reset_lock);
+	return reset_control_assert(tfa->reset);
+}
+
+static void tfa986x_power_off(void *data)
+{
+	struct device *dev = data;
+
+	if (!pm_runtime_status_suspended(dev)) {
+		tfa986x_runtime_suspend(dev);
+		pm_runtime_set_suspended(dev);
+	}
+}
+
+static int tfa986x_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct tfa986x *tfa;
+	unsigned int revision;
+	int ret, suspend_ret;
+
+	tfa = devm_kzalloc(dev, sizeof(*tfa), GFP_KERNEL);
+	if (!tfa)
+		return -ENOMEM;
+	tfa->regmap = devm_regmap_init_i2c(client, &tfa986x_regmap_config);
+	if (IS_ERR(tfa->regmap))
+		return dev_err_probe(dev, PTR_ERR(tfa->regmap), "creating regmap\n");
+	tfa->reset = devm_reset_control_get_shared(dev, NULL);
+	if (IS_ERR(tfa->reset))
+		return dev_err_probe(dev, PTR_ERR(tfa->reset), "getting speaker reset\n");
+	i2c_set_clientdata(client, tfa);
+
+	ret = devm_add_action_or_reset(dev, tfa986x_power_off, dev);
+	if (ret)
+		return ret;
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+	ret = regmap_read(tfa->regmap, TFA986X_REVISION, &revision);
+	suspend_ret = pm_runtime_put_sync_suspend(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "reading amplifier revision\n");
+	if (suspend_ret < 0)
+		return dev_err_probe(dev, suspend_ret, "suspending amplifier\n");
+	if (revision != 0x9866)
+		return dev_err_probe(dev, -ENODEV, "unknown revision %#x\n", revision);
+
+	dev_info(dev, "TFA986x revision %#04x\n", revision);
+	return 0;
+}
+
+static const struct dev_pm_ops tfa986x_pm_ops = {
+	RUNTIME_PM_OPS(tfa986x_runtime_suspend, tfa986x_runtime_resume, NULL)
+};
+
+static const struct of_device_id tfa986x_of_match[] = {
+	{ .compatible = "nxp,tfa986x" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, tfa986x_of_match);
+
+static struct i2c_driver tfa986x_driver = {
+	.driver = {
+		.name = "tfa986x",
+		.of_match_table = tfa986x_of_match,
+		.pm = pm_ptr(&tfa986x_pm_ops),
+	},
+	.probe = tfa986x_probe,
+};
+module_i2c_driver(tfa986x_driver);
+
+MODULE_DESCRIPTION("NXP TFA986x speaker amplifier");
+MODULE_LICENSE("GPL");
