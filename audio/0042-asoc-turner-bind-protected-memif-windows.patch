 enum turner_ring { APP_RING, OUTPUT_RING, IV_RING };
 
+static u32 mt6991_memif_offset(struct mt6991_adsp_core *a, enum turner_ring ring)
+{
+	return SZ_4K + ALIGN(a->pcm_bytes, SZ_4K) + (ring == IV_RING ? SZ_16K : 0);
+}
+
+int mt6991_adsp_memif_windows(struct device *dev, phys_addr_t *output, phys_addr_t *iv)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	u32 last;
+
+	guard(mutex)(&a->boot_lock);
+	if (!a->pcm_open || !a->pair_ready || !a->pcm_bytes)
+		return -EHOSTDOWN;
+	last = mt6991_memif_offset(a, IV_RING);
+	if (last > a->audio_size || SZ_16K > a->audio_size - last)
+		return -ERANGE;
+	*output = a->audio_base + mt6991_memif_offset(a, OUTPUT_RING);
+	*iv = a->audio_base + last;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6991_adsp_memif_windows);
