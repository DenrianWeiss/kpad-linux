+#define DL_24CH_BASE_MSB	0x4620
+#define VUL3_BASE_MSB		0x4df0
+#define VUL3_CON0		0x4e10
+
+/* BASE and END are inclusive, with a separate high word per address.
+ * CUR and CON0 remain owned by the engine and are never written here.
+ */
+static int mt6991_write_window(struct regmap *map, unsigned int reg,
+			       dma_addr_t base, dma_addr_t end)
+{
+	unsigned int regs[] = { reg, reg + 4, reg + 16, reg + 20 };
+	u32 words[] = { upper_32_bits(base), lower_32_bits(base),
+			upper_32_bits(end), lower_32_bits(end) };
+	unsigned int value;
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		ret = regmap_write(map, regs[i], words[i]);
+		if (ret)
+			return ret;
+		ret = regmap_read(map, regs[i], &value);
+		if (ret)
+			return ret;
+		if (value != words[i])
+			return -EIO;
+	}
+	return 0;
+}
+
+static int mt6991_window_idle(struct regmap *map, unsigned int reg, u32 enable)
+{
+	u32 value;
+	int ret = regmap_read(map, reg, &value);
+
+	return ret ?: ((value & enable) ? -EBUSY : 0);
+}
+
+static int mt6991_speaker_windows_idle(struct regmap *map)
+{
+	int ret = mt6991_window_idle(map, DL_24CH_BASE_MSB + 32, BIT(31));
+
+	return ret ?: mt6991_window_idle(map, VUL3_CON0, BIT(28));
+}
+
+static int mt6991_clear_windows(struct mt6991_afe *afe)
+{
+	struct regmap *map = afe->common.regmap;
+	int ret, err;
+
+	if (!afe->speaker_windows_set)
+		return 0;
+	ret = mt6991_speaker_windows_idle(map);
+	if (ret)
+		return ret;
+	/* The low nibble of END always reads as 0xf on this SoC. */
+	ret = mt6991_write_window(map, DL_24CH_BASE_MSB, 0, 15);
+	err = mt6991_write_window(map, VUL3_BASE_MSB, 0, 15);
+	if (!ret && !err)
+		afe->speaker_windows_set = false;
+	return ret ?: err;
+}
+
+int mt6991_afe_set_speaker_windows(struct snd_soc_dai *dai, phys_addr_t output, phys_addr_t iv)
+{
+	struct mt6991_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct regmap *map = afe->common.regmap;
+	struct device *dev = afe->common.dev;
+	int ret;
+
+	/* The stock AFE and DSP use the same direct bus addresses. */
+	if (device_iommu_mapped(dev) || !output || !IS_ALIGNED(output, SZ_4K) ||
+	    output > DMA_BIT_MASK(34) - 2 * SZ_16K + 1 || iv != output + SZ_16K ||
+	    phys_to_dma(dev, output) != output ||
+	    phys_to_dma(dev, iv + SZ_16K - 1) != iv + SZ_16K - 1)
+		return -ERANGE;
+	ret = mt6991_speaker_windows_idle(map);
+	if (ret)
+		return ret;
+	afe->speaker_windows_set = true;
+	ret = mt6991_write_window(map, VUL3_BASE_MSB, iv, iv + SZ_16K - 1);
+	if (!ret)
+		ret = mt6991_write_window(map, DL_24CH_BASE_MSB, output, output + SZ_16K - 1);
+	if (ret && mt6991_clear_windows(afe))
+		dev_err(dev, "failed to clear partial speaker DMA windows\n");
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6991_afe_set_speaker_windows);
