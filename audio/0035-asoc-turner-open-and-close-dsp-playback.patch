+struct device *mt6991_adsp_link_playback(struct device *consumer)
+{
+	struct device_node *np __free(device_node) =
+		of_find_compatible_node(NULL, NULL, "mediatek,mt6991-adsp_core_0");
+	struct platform_device *pdev;
+	struct device *dev, *result = ERR_PTR(-EPROBE_DEFER);
+
+	if (!np || !of_device_is_available(np))
+		return ERR_PTR(-ENODEV);
+	pdev = of_find_device_by_node(np);
+	if (!pdev)
+		return result;
+	dev = &pdev->dev;
+	device_lock(dev);
+	if (dev->driver == &mt6991_adsp_core_driver.driver && device_is_bound(dev)) {
+		struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+
+		if (!a->peer)
+			result = ERR_PTR(-ENODEV);
+		else if (device_link_add(consumer, dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+			result = dev;
+		else
+			result = ERR_PTR(-EINVAL);
+	}
+	device_unlock(dev);
+	put_device(dev);
+	return result;
+}
+EXPORT_SYMBOL_GPL(mt6991_adsp_link_playback);
