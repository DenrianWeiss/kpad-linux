+/* Caller holds boot_lock. A failed transaction requires a firmware restart
+ * before reusing the same command number, since the ACK has no sequence ID.
+ */
+static int mt6991_adsp_pcm_command(struct device *dev, u16 command)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	struct mbox_client client = { .dev = dev, .tx_block = true, .tx_tout = 200 };
+	struct mbox_chan *tx;
+	int ret;
+
+	tx = mbox_request_channel(&client, 0);
+	if (IS_ERR(tx))
+		return PTR_ERR(tx);
+	reinit_completion(&a->pcm_reply);
+	WRITE_ONCE(a->pending_command, command);
+	ret = mt6991_adsp_audio_send(tx, ADSP_AUDIO_PLAYBACK, command, NULL, 0, true);
+	if (ret >= 0)
+		ret = wait_for_completion_timeout(&a->pcm_reply, msecs_to_jiffies(500)) ?
+			0 : -ETIMEDOUT;
+	WRITE_ONCE(a->pending_command, 0);
+	mbox_free_channel(tx);
+	return ret;
+}
+
+int mt6991_adsp_pcm_open(struct device *dev)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	bool owns_pair;
+	int ret;
+
+	guard(mutex)(&a->boot_lock);
+	if (a->pcm_open)
+		return -EBUSY;
+	if (a->pair_powered && !a->pair_ready) {
+		ret = mt6991_adsp_stop_pair(dev);
+		if (ret)
+			return ret;
+	}
+	owns_pair = !a->pair_ready;
+	ret = mt6991_adsp_start_pair(dev);
+	if (ret)
+		return ret;
+	ret = mt6991_adsp_playback_mailboxes(dev);
+	if (!ret)
+		ret = mt6991_adsp_pcm_command(dev, 1);
+	if (ret) {
+		if (mt6991_adsp_stop_pair(dev))
+			dev_err(dev, "failed to halt DSP after playback open error\n");
+		return ret;
+	}
+	a->pcm_owns_pair = owns_pair;
+	a->pcm_open = true;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6991_adsp_pcm_open);
+
+int mt6991_adsp_pcm_close(struct device *dev)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	int ret, stop = 0;
+
+	guard(mutex)(&a->boot_lock);
+	if (!a->pcm_open)
+		return 0;
+	ret = a->pair_ready ? mt6991_adsp_pcm_command(dev, 2) : -EHOSTDOWN;
+	if (a->pcm_owns_pair || ret)
+		stop = mt6991_adsp_stop_pair(dev);
+	a->pcm_open = false;
+	a->pcm_owns_pair = false;
+	return ret ?: stop;
+}
+EXPORT_SYMBOL_GPL(mt6991_adsp_pcm_close);
