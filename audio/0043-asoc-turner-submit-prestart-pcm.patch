+
+/* Submit samples while the task is prepared but has not received START.
+ * There is no consumer credit until streaming/IRQ support is available.
+ */
+int mt6991_adsp_pcm_prefill(struct device *dev, u32 pos, const void *data, u32 bytes)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	void __iomem *samples;
+	u64 base, next;
+	int ret;
+
+	guard(mutex)(&a->boot_lock);
+	if (!a->pair_ready || !a->pcm_open || !a->hw_prepared || !a->pcm_bytes)
+		return -EHOSTDOWN;
+	if (!bytes || !IS_ALIGNED(bytes, 8) || pos != a->prefilled % a->pcm_bytes)
+		return -EINVAL;
+	if (bytes > a->pcm_bytes - a->prefilled)
+		return -ENOSPC;
+
+	base = a->audio_base + SZ_4K;
+	samples = ioremap_wc(base, a->pcm_bytes);
+	if (!samples)
+		return -ENOMEM;
+	memcpy_toio(samples + pos, data, bytes);
+	wmb();
+	iounmap(samples);
+
+	next = base + (a->prefilled + bytes) % a->pcm_bytes;
+	put_unaligned_le64(next, a->app_desc + 24);
+	put_unaligned_le32(a->copy_sequence, a->app_desc + 84);
+	memcpy_toio(a->playback_buffers, a->app_desc, sizeof(a->app_desc));
+	wmb();
+	ret = mt6991_adsp_pcm_command(dev, PCM_COPY, 1);
+	if (ret) {
+		dev_err(dev, "DSP COPY failed: %d\n", ret);
+		if (mt6991_adsp_stop_pair(dev))
+			dev_err(dev, "failed to halt DSP after COPY error\n");
+		return ret;
+	}
+	a->prefilled += bytes;
+	a->copy_sequence++;
+	dev_info_once(dev, "DSP acknowledged prefill of %u bytes\n", bytes);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6991_adsp_pcm_prefill);
 
