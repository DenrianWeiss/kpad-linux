+/* Turner embeds a PA1 file with a revision check and no DSP write blocks. */
+static int tfa_check_patch(const struct firmware *fw, u32 desc, u16 revision)
+{
+	const u8 *file = tfa_item(fw, desc, 8);
+	const u8 *header, *check;
+	u32 size;
+
+	if (!file)
+		return -EINVAL;
+	size = get_unaligned_le32(file + 4);
+	if (size < 42 || size > fw->size - (file + 8 - fw->data))
+		return -EINVAL;
+	header = file + 8;
+	if (memcmp(header, "PA1_00", 6) || get_unaligned_le16(header + 6) != size ||
+	    (crc32_le(~0U, header + 12, size - 12) ^ ~0U) != get_unaligned_le32(header + 8))
+		return -EINVAL;
+
+	check = header + 36;
+	if (size != 42 || check[1] != 0xff || check[2] != 0xff ||
+	    check[3] || check[4] || check[5] != 0x0b)
+		return -EOPNOTSUPP;
+	return (check[5] << 8 | check[0]) == revision ? 0 : -ENODEV;
+}
