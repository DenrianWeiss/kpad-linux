+		return dev_err_probe(dev, -EINVAL, "invalid ADSP L2 window\n");
+	l2 = devm_ioremap_resource(dev, res);
+	if (IS_ERR(l2))
+		return PTR_ERR(l2);
+	core->l2_end = l2 + resource_size(res);
 	core->client.dev = dev;
 	core->client.rx_callback = mt6991_adsp_receive;
 	platform_set_drvdata(pdev, core);
