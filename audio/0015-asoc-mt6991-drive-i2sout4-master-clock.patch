+/* The stock OUT4 DAI uses the I2SIN0 master-clock divider on Turner. */
+static int mt6991_i2sout4_sysclk(struct snd_soc_dai *dai, int id,
+				 unsigned int freq, int dir)
+{
+	struct mt6991_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct clk *pll = afe->mclk[APLL2_PARENT].clk;
+	struct clk *aud = afe->mclk[AUD2_MUX].clk;
+	struct clk *div = afe->mclk[MCLK_DIV].clk;
+	unsigned long rate;
+	int ret;
 
+	if (id || dir != SND_SOC_CLOCK_OUT || freq != 48000 * 128)
+		return -EINVAL;
+
+	/* Allow for PLL frequency-word rounding when deriving the /32 rate. */
+	rate = DIV_ROUND_UP(clk_get_rate(pll), 32);
+	if (rate < freq - 1 || rate > freq + 1)
+		return -ERANGE;
+	if (afe->mclk_enabled)
+		return clk_get_rate(div) == rate ? 0 : -EBUSY;
+
+	ret = clk_set_parent(aud, pll);
+	if (ret)
+		return ret;
+	ret = clk_set_parent(afe->mclk[MCLK_MUX].clk, aud);
+	if (ret)
+		return ret;
+	ret = clk_set_rate(div, rate);
+	if (ret)
+		return ret;
+	return clk_get_rate(div) == rate ? 0 : -ERANGE;
+}
+
+static int mt6991_i2sout4_prepare(struct snd_pcm_substream *s,
+				  struct snd_soc_dai *dai)
+{
+	struct mt6991_afe *afe = snd_soc_dai_get_drvdata(dai);
+	int ret;
+
+	if (afe->mclk_enabled)
+		return 0;
+	ret = clk_prepare_enable(afe->mclk[MCLK_DIV].clk);
+	if (!ret)
+		afe->mclk_enabled = true;
+	return ret;
+}
+
+static int mt6991_i2sout4_free(struct snd_pcm_substream *s,
+			       struct snd_soc_dai *dai)
+{
+	struct mt6991_afe *afe = snd_soc_dai_get_drvdata(dai);
+
+	if (afe->mclk_enabled) {
+		clk_disable_unprepare(afe->mclk[MCLK_DIV].clk);
+		afe->mclk_enabled = false;
+	}
+	return 0;
+}
+
 static const struct snd_soc_dai_ops i2sout4_ops = {
+	.set_sysclk = mt6991_i2sout4_sysclk,
+	.prepare = mt6991_i2sout4_prepare,
+	.hw_free = mt6991_i2sout4_free,
 	.hw_params = mt6991_i2sout4_params,
 };
 
