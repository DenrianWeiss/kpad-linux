+static int turner_i2s_prepare(struct snd_pcm_substream *s)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(s);
+	struct turner_audio *audio = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_pcm_runtime *rt = s->runtime;
+
+	return mt6991_adsp_pcm_prepare(audio->dsp, rt->period_size, rt->periods,
+				       min_t(unsigned long, rt->start_threshold, U32_MAX),
+				       min_t(unsigned long, rt->stop_threshold, U32_MAX));
+}
