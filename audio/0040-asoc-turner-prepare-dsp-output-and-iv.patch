+	if (!a->hw_prepared)
+		return 0;
+	ret = mt6991_adsp_pcm_command(dev, MEMIF_FREE, 4);
+	if (!ret)
+		ret = mt6991_adsp_pcm_command(dev, MEMIF_FREE, 1);
+	if (!ret)
