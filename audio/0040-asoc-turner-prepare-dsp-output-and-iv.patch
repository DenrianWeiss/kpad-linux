+/* The I2S backend holds the AFE runtime-PM reference during prepare. */
+int mt6991_adsp_pcm_prepare(struct device *dev, u32 period, u32 periods,
+			    u32 start_threshold, u32 stop_threshold)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	static const u16 commands[] = { MEMIF_PARAMS, MEMIF_PREPARE };
+	int ret, i;
+	enum turner_ring ring;
+
+	guard(mutex)(&a->boot_lock);
+	if (!a->pair_ready || !a->pcm_open || !a->pcm_bytes)
+		return -EHOSTDOWN;
+	if (a->pcm_format != 10)
+		return -EOPNOTSUPP;
+	if (!a->hw_prepared) {
+		for (i = 0; i < ARRAY_SIZE(commands); i++) {
+			for (ring = OUTPUT_RING; ring <= IV_RING; ring++) {
+				ret = mt6991_adsp_ring_desc(dev, ring, commands[i], 0, 0, 0, 0, 0, 0);
+				if (ret)
+					goto halt;
+			}
+		}
+		a->hw_prepared = true;
+	}
+	ret = mt6991_adsp_ring_desc(dev, APP_RING, PCM_PREPARE, a->pcm_format,
+				   a->pcm_bytes, period, periods, start_threshold, stop_threshold);
+	if (!ret) {
+		dev_info_once(dev, "DSP acknowledged output, IV and playback prepare\n");
+		return 0;
+	}
+halt:
+	dev_err(dev, "DSP ring prepare failed: %d\n", ret);
+	if (mt6991_adsp_stop_pair(dev))
+		dev_err(dev, "failed to halt DSP after prepare error\n");
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6991_adsp_pcm_prepare);
 
