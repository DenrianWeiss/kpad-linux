+/* Stock Turner crossbar: I2SIN4 feeds VUL3; DL_24CH feeds I2SOUT4.
+ * Include the direct DL0 bits in the output mask to exclude a bypass.
+ * Each caller holds the AFE runtime PM reference.
+ */
+static int mt6991_speaker_routes(struct regmap *map, bool enable)
+{
+	static const struct { unsigned int reg, mask, active; } routes[] = {
+		{ 0x2390, BIT(14), BIT(14) },
+		{ 0x23b0, BIT(15), BIT(15) },
+		{ AFE_CONN116_1, BIT(22) | BIT(0), BIT(22) },
+		{ AFE_CONN117_1, BIT(23) | BIT(1), BIT(23) },
+	};
+	unsigned int value;
+	int i, ret, first = 0;
+
+	for (i = 0; i < ARRAY_SIZE(routes); i++) {
+		int n = enable ? i : ARRAY_SIZE(routes) - 1 - i;
+		unsigned int target = enable ? routes[n].active : 0;
+
+		ret = regmap_update_bits(map, routes[n].reg, routes[n].mask, target);
+		if (!ret)
+			ret = regmap_read(map, routes[n].reg, &value);
+		if (!ret && (value & routes[n].mask) != target)
+			ret = -EIO;
+		if (ret && enable)
+			return ret;
+		if (!first)
+			first = ret;
+	}
+	return first;
+}
