+/* The caller holds the RX channel and hence the ADSP clock and power domain. */
+int mt6991_adsp_require_stall(struct mbox_chan *chan, unsigned int id)
+{
+	struct mt6991_adsp_mailbox *mb;
+	u32 control;
+
+	if (!chan || chan->mbox->ops != &mt6991_adsp_ops)
+		return -EINVAL;
+	mb = dev_get_drvdata(chan->mbox->dev);
+	if (id >= ARRAY_SIZE(mb->chan) || chan != &mb->chan[id])
+		return -EINVAL;
+	control = readl(mb->core_control);
+	if (control == U32_MAX)
+		return -ENXIO;
+	return control & BIT(12 + id) ? 0 : -EBUSY;
+}
+EXPORT_SYMBOL_GPL(mt6991_adsp_require_stall);
