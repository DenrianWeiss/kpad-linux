+static bool mt6991_adsp_lk_pool(const char *name)
+{
+	size_t prefix = str_has_prefix(name, "mblock-");
+	size_t suffix;
+
+	if (!prefix || !isdigit(name[prefix]))
+		return false;
+	name += prefix;
+	while (isdigit(*name))
+		name++;
+	suffix = str_has_prefix(name, "-adsp_shared_reserved");
+	return suffix && (!name[suffix] || name[suffix] == '@');
+}
+
+static bool mt6991_adsp_pool_owned(struct device_node *sys)
+{
+	struct device_node *reserved __free(device_node) = of_find_node_by_path("/reserved-memory");
+	u64 range[2], start, size;
+	bool found = false;
+
+	if (!reserved || of_property_read_u64_array(sys, "shared_memory", range, 2))
+		return false;
+	for_each_available_child_of_node_scoped(reserved, node) {
+		const char *name = kbasename(of_node_full_name(node));
+
+		if (!mt6991_adsp_lk_pool(name) &&
+		    !of_device_is_compatible(node, "mediatek,reserve-memory-adsp_share"))
+			continue;
+		if (found || !of_property_present(node, "no-map") ||
+		    of_property_present(node, "reusable") ||
+		    of_property_count_u64_elems(node, "reg") != 2 ||
+		    of_property_read_reg(node, 0, &start, &size) ||
+		    start != range[0] || size != range[1])
+			return false;
+		found = true;
+	}
+	return found;
+}
+
+static void mt6991_adsp_write_record(void __iomem *slot,
+				     const struct mt6991_adsp_record *record)
+{
+	writel(record->address, slot);
+	writel(record->size, slot + 4);
+}
+
+static int mt6991_adsp_boot_records(struct device *dev, bool prepare)
+{
+	struct mt6991_adsp_core *core = dev_get_drvdata(dev);
+	void __iomem *mpu_slot = core->l2_end - 0x28;
+	struct mt6991_adsp_record pool, c2c;
+	struct of_phandle_args rx;
+	int ret;
+
+	ret = of_parse_phandle_with_args(dev->of_node, "mboxes", "#mbox-cells", 1, &rx);
+	if (ret)
+		return ret;
+	ret = mt6991_adsp_records(rx.np, &pool, &c2c);
+	if (!ret && prepare && !mt6991_adsp_pool_owned(rx.np))
+		ret = -ENODATA;
+	of_node_put(rx.np);
+	if (ret)
+		return ret;
+
+	guard(mutex)(&core->records_lock);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+	if (prepare) {
+		ret = mt6991_adsp_require_stall(core->rx, core->id);
+		if (ret)
+			goto out;
+		mt6991_adsp_write_record(mpu_slot, &pool);
+		if (!core->id)
+			mt6991_adsp_write_record(core->l2_end - 0x2510, &c2c);
+	}
+	ret = mt6991_adsp_record_matches(mpu_slot, &pool);
+	if (!core->id)
+		ret &= mt6991_adsp_record_matches(core->l2_end - 0x2510, &c2c);
+out:
+	pm_runtime_put_sync(dev);
+	return ret;
+}
