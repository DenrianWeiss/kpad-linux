+/* Turner uses asynchronous master I2S with two 32-bit slots. */
+static int mt6991_i2sout4_params(struct snd_pcm_substream *s,
+				 struct snd_pcm_hw_params *params,
+				 struct snd_soc_dai *dai)
+{
+	struct mt6991_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct regmap *map = afe->common.regmap;
+	int ret;
+
+	if (params_rate(params) != 48000 || params_channels(params) != 2 ||
+	    params_format(params) != SNDRV_PCM_FORMAT_S32_LE)
+		return -EINVAL;
+
+	ret = regmap_update_bits(map, ETDM_OUT4_CON0,
+				 OUT_SYNC | OUT_SLAVE | OUT_FMT | OUT_BITS |
+				 OUT_WORD | OUT_CHANNELS | OUT_RELATCH_DOMAIN,
+				 FIELD_PREP(OUT_BITS, 31) | FIELD_PREP(OUT_WORD, 31) |
+				 FIELD_PREP(OUT_CHANNELS, 1) |
+				 FIELD_PREP(OUT_RELATCH_DOMAIN, 1));
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(map, ETDM_OUT4_CON1,
+				 OUT_INITIAL_COUNT | OUT_INITIAL_POINT | OUT_LRCK_RESET,
+				 FIELD_PREP(OUT_INITIAL_COUNT, 5) |
+				 FIELD_PREP(OUT_INITIAL_POINT, 6) | OUT_LRCK_RESET);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(map, ETDM_OUT4_CON2, OUT_IN2LATCH,
+				 FIELD_PREP(OUT_IN2LATCH, 6));
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(map, ETDM_OUT4_CON4,
+				  OUT_FS_TIMING | OUT_CLK_SOURCE | OUT_RELATCH_RATE,
+				  FIELD_PREP(OUT_FS_TIMING, 5) |
+				  FIELD_PREP(OUT_CLK_SOURCE, 1) |
+				  FIELD_PREP(OUT_RELATCH_RATE, 10));
+}
+
+static const struct snd_soc_dai_ops i2sout4_ops = {
