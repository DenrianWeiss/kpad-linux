+static int mt6991_adsp_configure_aurisys(struct device *dev)
+{
+	struct mbox_client client = { .dev = dev, .tx_block = true, .tx_tout = 200 };
+	struct mt6991_adsp_tx msg = { .id = ADSP_AUDIO_IPI, .len = 16 };
+	struct mbox_chan *tx;
+	int ret;
+
+	ret = mt6991_adsp_send_config(dev, true);
+	if (ret)
+		return ret;
+	tx = mbox_request_channel(&client, 0);
+	if (IS_ERR(tx))
+		return PTR_ERR(tx);
+	/* HAL set_aurisys_on(), controller A, message-only, bypass ACK. */
+	put_unaligned_le16(0x8888, msg.payload);
+	msg.payload[2] = 38;
+	msg.payload[3] = 0x20;
+	put_unaligned_le16(0xada3, msg.payload + 6);
+	put_unaligned_le32(1, msg.payload + 8);
+	ret = mbox_send_message(tx, &msg);
+	mbox_free_channel(tx);
+	return min(ret, 0);
+}
