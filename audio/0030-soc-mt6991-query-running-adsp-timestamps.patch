+/* Caller holds the pair boot lock and both runtime PM references. */
+static int mt6991_adsp_query_timestamp(struct device *dev, u64 *timestamp)
+{
+	struct mt6991_adsp_core *core = dev_get_drvdata(dev);
+	struct mt6991_adsp_tx msg = { .id = MT6991_ADSP_IPI_TEST, .len = sizeof(u32) };
+	struct mbox_client client = { .dev = dev, .tx_block = true, .tx_tout = 200 };
+	struct device_node *provider;
+	struct mbox_chan *tx;
+	int ret;
+
+	/* Stock uses a separate pre-wake sequence on variants with these windows. */
+	provider = of_parse_phandle(dev->of_node, "mboxes", 0);
+	if (!provider)
+		return -ENODEV;
+	ret = of_property_match_string(provider, "reg-names", "infracfg_rsv") >= 0 ||
+	      of_property_match_string(provider, "reg-names", "ipic_chn") >= 0;
+	of_node_put(provider);
+	if (ret)
+		return -EOPNOTSUPP;
+
+	/* Replies have no sequence field. Discard late replies until a fresh boot. */
+	if (core->timestamp_failed)
+		return -EPIPE;
+	tx = mbox_request_channel(&client, 0);
+	if (IS_ERR(tx))
+		return PTR_ERR(tx);
+	put_unaligned_le32(0x5a5a, msg.payload);
+	reinit_completion(&core->timestamp_reply);
+	ret = mbox_send_message(tx, &msg);
+	if (ret < 0) {
+		dev_err(dev, "timestamp TX completion failed: %d\n", ret);
+	} else {
+		if (wait_for_completion_timeout(&core->timestamp_reply, msecs_to_jiffies(200))) {
+			*timestamp = READ_ONCE(core->timestamp);
+			ret = 0;
+		} else {
+			dev_err(dev, "timestamp TX consumed; timed out waiting for reply\n");
+			ret = -ETIMEDOUT;
+		}
+	}
+	if (ret < 0)
+		core->timestamp_failed = true;
+	mbox_free_channel(tx);
+	return ret;
+}
+
+static ssize_t firmware_timestamps_show(struct device *dev, struct device_attribute *attr,
+					char *buf)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	u64 first, second;
+	int ret_a, ret_b;
+
+	guard(mutex)(&a->boot_lock);
+	if (!a->pair_ready)
+		return -EHOSTDOWN;
+	ret_a = mt6991_adsp_query_timestamp(dev, &first);
+	ret_b = mt6991_adsp_query_timestamp(a->peer, &second);
+	if (ret_a || ret_b)
+		return ret_a ?: ret_b;
+	return sysfs_emit(buf, "%llu %llu\n", first, second);
+}
+static struct device_attribute dev_attr_firmware_timestamps =
+	__ATTR(firmware_timestamps, 0400, firmware_timestamps_show, NULL);
