+static int turner_playback_params(struct snd_pcm_substream *s,
+				  struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(s);
+	struct turner_audio *audio = snd_soc_card_get_drvdata(rtd->card);
+
+	if (params_rate(params) != 48000 || params_channels(params) != 2)
+		return -EINVAL;
+	return mt6991_adsp_pcm_hw_params(audio->dsp, params_format(params),
+					 params_buffer_bytes(params));
+}
+
+static int turner_playback_free(struct snd_pcm_substream *s)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(s);
+	struct turner_audio *audio = snd_soc_card_get_drvdata(rtd->card);
+
+	return mt6991_adsp_pcm_hw_free(audio->dsp);
+}
+
 static const struct snd_soc_ops turner_playback_ops = {
