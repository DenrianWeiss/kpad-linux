+/* The firmware consumes the software ring in its own reserved DRAM pool.
+ * Keep the first page for scene mailboxes. No DMA engine is started here.
+ */
+static int mt6991_adsp_setup_ring(struct device *dev, u32 format, u32 bytes)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	u64 start = a->audio_base + SZ_4K;
+	u8 desc[96] = {};
+	void __iomem *ring;
+
+	if (!bytes || a->audio_size < SZ_4K || bytes > a->audio_size - SZ_4K)
+		return -ERANGE;
+	ring = ioremap_wc(start, bytes);
+	if (!ring)
+		return -ENOMEM;
+	memset_io(ring, 0, bytes);
+	wmb();
+	iounmap(ring);
+	put_unaligned_le64(start, desc);
+	put_unaligned_le64(start + bytes, desc + 8);
+	put_unaligned_le64(start, desc + 16);
+	put_unaligned_le64(start, desc + 24);
+	put_unaligned_le64(bytes, desc + 32);
+	put_unaligned_le32(format, desc + 48);
+	put_unaligned_le32(48000, desc + 52);
+	put_unaligned_le32(2, desc + 56);
+	put_unaligned_le32(1, desc + 60); /* playback */
+	desc[83] = 1; /* DRAM */
+	memcpy_toio(a->playback_buffers, desc, sizeof(desc));
+	wmb();
+	return mt6991_adsp_pcm_command(dev, 4);
+}
+
+int mt6991_adsp_pcm_hw_params(struct device *dev, u32 format, u32 bytes)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	int ret;
+
+	guard(mutex)(&a->boot_lock);
+	if (!a->pcm_open || !a->pair_ready)
+		return -EHOSTDOWN;
+	if (a->pcm_bytes)
+		return -EBUSY;
+	ret = mt6991_adsp_setup_ring(dev, format, bytes);
+	if (ret) {
+		if (mt6991_adsp_stop_pair(dev))
+			dev_err(dev, "failed to halt DSP after HWPARAM error\n");
+		return ret;
+	}
+	a->pcm_bytes = bytes;
+	a->pcm_format = format;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(mt6991_adsp_pcm_hw_params);
+
+int mt6991_adsp_pcm_hw_free(struct device *dev)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	int ret;
+
+	guard(mutex)(&a->boot_lock);
+	if (!a->pcm_bytes)
+		return 0;
+	ret = a->pair_ready ? mt6991_adsp_pcm_command(dev, 9) : -EHOSTDOWN;
+	if (ret && mt6991_adsp_stop_pair(dev))
+		dev_err(dev, "failed to halt DSP after HWFREE error\n");
+	a->pcm_bytes = 0;
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6991_adsp_pcm_hw_free);
