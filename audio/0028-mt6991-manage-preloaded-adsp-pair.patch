+int mt6991_adsp_set_running(struct mbox_chan *chan, unsigned int id, bool run)
+{
+	int ret = mt6991_adsp_require_stall(chan, id);
+
+	if (ret && ret != -EBUSY)
+		return ret;
+	if (run && ret)
+		return ret;
+	if (!run && !ret)
+		return 0;
+	ret = mt6991_adsp_fw_control(chan->mbox->dev, run ? MT6991_ADSP_CORE_START : MT6991_ADSP_CORE_STOP, id);
+	if (ret)
+		return ret;
+	ret = mt6991_adsp_require_stall(chan, id);
+	if (!run)
+		return ret;
+	if (ret == -EBUSY)
+		return 0;
+	return ret ?: -EIO;
+}
+EXPORT_SYMBOL_GPL(mt6991_adsp_set_running);
