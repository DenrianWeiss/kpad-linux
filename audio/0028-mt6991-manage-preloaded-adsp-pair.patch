+static int mt6991_adsp_fw_control(struct device *dev, unsigned int op, u32 arg)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(MT6991_SIP_ADSP_CONTROL, op, arg, 0, 0, 0, 0, 0, &res);
+	if (!res.a0)
+		return 0;
+	dev_err(dev, "ADSP firmware operation %u returned %ld\n", op, (long)res.a0);
+	return -EIO;
+}
