+/* LK chooses the physical locations on each boot. */
+static int mt6991_adsp_check_handoff(struct device *a, struct device *b)
+{
+	struct device_node *reserved __free(device_node) = of_find_node_by_path("/reserved-memory");
+	struct adsp_range image, pool, wa, wb, shared;
+	struct of_phandle_args spec;
+	bool have_image = false, have_pool = false;
+	int ret;
+
+	if (!reserved || mt6991_adsp_range(a->of_node, "system", &wa) ||
+	    mt6991_adsp_range(b->of_node, "system", &wb))
+		return -ENODATA;
+	ret = of_parse_phandle_with_args(a->of_node, "mboxes", "#mbox-cells", 1, &spec);
+	if (ret)
+		return ret;
+	ret = mt6991_adsp_range(spec.np, "shared_memory", &shared);
+	of_node_put(spec.np);
+	if (ret)
+		return ret;
+	for_each_available_child_of_node_scoped(reserved, node) {
+		bool is_image = mt6991_adsp_mblock(node, "-adsp_image_reserved");
+
+		if (!is_image && !mt6991_adsp_mblock(node, "-adsp_shared_reserved") &&
+		    !of_device_is_compatible(node, "mediatek,reserve-memory-adsp_share"))
+			continue;
+		if (!of_property_present(node, "no-map") || of_property_present(node, "reusable") ||
+		    (is_image ? have_image : have_pool) ||
+		    mt6991_adsp_range(node, "reg", is_image ? &image : &pool))
+			return -ENODATA;
+		if (is_image)
+			have_image = true;
+		else
+			have_pool = true;
+	}
+	if (!have_image || !have_pool || wa.start < image.start || wa.end > wb.start ||
+	    wb.end > image.end || pool.start != shared.start || pool.end != shared.end ||
+	    (pool.start < image.end && image.start < pool.end))
+		return -ENODATA;
+	return 0;
+}
