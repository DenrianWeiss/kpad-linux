+static int mt6991_adsp_range(struct device_node *node, const char *name,
+			     struct adsp_range *range)
+{
+	u64 cells[2];
+
+	if (of_property_count_u64_elems(node, name) != 2 ||
+	    of_property_read_u64_array(node, name, cells, 2) ||
+	    !cells[0] || !cells[1] || check_add_overflow(cells[0], cells[1], &range->end))
+		return -ENODATA;
+	range->start = cells[0];
+	return 0;
+}
+
+static bool mt6991_adsp_mblock(struct device_node *node, const char *suffix)
+{
+	const char *name = kbasename(of_node_full_name(node));
+	size_t prefix = str_has_prefix(name, "mblock-");
+	size_t digits, len;
+
+	if (!prefix)
+		return false;
+	name += prefix;
+	digits = strspn(name, "0123456789");
+	if (!digits)
+		return false;
+	name += digits;
+	len = strlen(suffix);
+	return !strncmp(name, suffix, len) && (!name[len] || name[len] == '@');
+}
