+/* boot_lock serializes transitions; keep both RX channels until both cores stop. */
+static int mt6991_adsp_stop_pair(struct device *dev)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	struct mt6991_adsp_core *cores[] = { a, dev_get_drvdata(a->peer) };
+	int i, ret;
+
+	a->pair_ready = false;
+	for (i = 1; i >= 0; i--) {
+		if (!(a->started & BIT(i)))
+			continue;
+		ret = mt6991_adsp_set_running(cores[i]->rx, i, false);
+		if (ret)
+			return ret;
+		a->started &= ~BIT(i);
+	}
+	if (a->pair_powered) {
+		pm_runtime_put_sync(a->peer);
+		pm_runtime_put_sync(dev);
+		a->pair_powered = false;
+	}
+	return 0;
+}
+
+static int mt6991_adsp_start_pair(struct device *dev)
+{
+	struct mt6991_adsp_core *a = dev_get_drvdata(dev);
+	struct mt6991_adsp_core *cores[] = { a, dev_get_drvdata(a->peer) };
+	int ret, i;
+
+	if (a->pair_ready)
+		return 0;
+	if (a->pair_powered)
+		return -EBUSY;
+	ret = mt6991_adsp_check_handoff(dev, a->peer);
+	if (ret)
+		return ret;
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+	ret = pm_runtime_resume_and_get(a->peer);
+	if (ret < 0) {
+		pm_runtime_put_sync(dev);
+		return ret;
+	}
+	a->pair_powered = true;
+	ret = mt6991_adsp_clear_pair(cores[0]->rx, cores[1]->rx);
+	if (ret)
+		goto stop;
+	for (i = 0; i < ARRAY_SIZE(cores); i++) {
+		reinit_completion(&cores[i]->ready);
+		a->started |= BIT(i);
+		ret = mt6991_adsp_set_running(cores[i]->rx, i, true);
+		if (ret)
+			goto stop;
+		if (!wait_for_completion_timeout(&cores[i]->ready, 2 * HZ)) {
+			dev_err(dev, "DSP core %d timed out waiting for READY\n", i);
+			ret = -ETIMEDOUT;
+			goto stop;
+		}
+	}
+	a->pair_ready = true;
+	return 0;
+stop:
+	if (mt6991_adsp_stop_pair(dev))
+		dev_err(dev, "unable to stop DSP pair; retaining power for retry\n");
+	return ret;
+}
