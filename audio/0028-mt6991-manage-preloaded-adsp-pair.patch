+static int mt6991_adsp_link_peer(struct device *dev, struct mt6991_adsp_core *core)
+{
+	struct device_node *peer __free(device_node) =
+		of_find_compatible_node(NULL, NULL, "mediatek,mt6991-adsp_core_1");
+	struct platform_device *pdev;
+	int ret = -EPROBE_DEFER;
+
+	if (!peer || !of_device_is_available(peer))
+		return 0;
+	pdev = of_find_device_by_node(peer);
+	if (!pdev)
+		return ret;
+	device_lock(&pdev->dev);
+	if (pdev->dev.driver == &mt6991_adsp_core_driver.driver && device_is_bound(&pdev->dev)) {
+		if (device_link_add(dev, &pdev->dev, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+			core->peer = &pdev->dev;
+			ret = 0;
+		} else {
+			ret = -EINVAL;
+		}
+	}
+	device_unlock(&pdev->dev);
+	put_device(&pdev->dev);
+	return ret;
+}
