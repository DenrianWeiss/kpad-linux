+int mt6991_adsp_clear_pair(struct mbox_chan *a, struct mbox_chan *b)
+{
+	struct mt6991_adsp_mailbox *mb;
+	struct device *dev;
+	int ret;
+
+	if (!a || !b || a->mbox != b->mbox)
+		return -EINVAL;
+	ret = mt6991_adsp_require_stall(a, 0);
+	if (!ret)
+		ret = mt6991_adsp_require_stall(b, 1);
+	if (ret)
+		return ret;
+	dev = a->mbox->dev;
+	mb = dev_get_drvdata(dev);
+	if (mb->needs_reload && readl(mb->pending))
+		return -EAGAIN;
+	ret = mt6991_adsp_fw_control(dev, MT6991_ADSP_SYS_CLEAR, MT6991_ADSP_MAGIC);
+	if (ret)
+		return ret;
+	if (!mb->needs_reload) {
+		mb->needs_reload = true;
+		return 0;
+	}
+
+	/* The stock recovery sequence switches low then high before replacing
+	 * both firmware images from LK's retained allocation.
+	 */
+	ret = mt6991_adsp_local_mux(dev, false);
+	if (ret)
+		return ret;
+	ret = clk_set_parent(mb->clk, mb->clk26m);
+	if (!ret)
+		ret = clk_set_parent(mb->clk, mb->pll);
+	if (ret) {
+		if (!clk_set_parent(mb->clk, mb->pll))
+			mt6991_adsp_local_mux(dev, true);
+		return ret;
+	}
+	ret = mt6991_adsp_local_mux(dev, true);
+	if (ret)
+		return ret;
+	return mt6991_adsp_fw_control(dev, MT6991_ADSP_RELOAD, MT6991_ADSP_MAGIC);
+}
+EXPORT_SYMBOL_GPL(mt6991_adsp_clear_pair);
