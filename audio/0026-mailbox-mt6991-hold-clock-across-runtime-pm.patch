+static void mt6991_adsp_release_clock(void *data)
+{
+	struct device *dev = data;
+	struct mt6991_adsp_mailbox *mb = dev_get_drvdata(dev);
+
+	/* Runtime PM is disabled and clients have been unregistered. */
+	if (mb->runtime_clock && mt6991_adsp_runtime_suspend(dev)) {
+		dev_warn(dev, "failed to restore idle ADSP clock on detach\n");
+		clk_disable_unprepare(mb->clk);
+		mb->runtime_clock = false;
+	}
 }
 
