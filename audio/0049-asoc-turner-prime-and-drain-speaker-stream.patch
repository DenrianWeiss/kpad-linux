+static void mt6991_stream_quiesce(struct turner_stream *stream)
+{
+	atomic_set(&stream->state, TURNER_IDLE);
+	cancel_work_sync(&stream->work);
+	WRITE_ONCE(stream->position, 0);
+}
+
+static int mt6991_dl0_prepare(struct snd_pcm_substream *s, struct snd_soc_dai *dai)
+{
+	struct mt6991_afe *afe = snd_soc_dai_get_drvdata(dai);
+	struct turner_stream *stream = &afe->stream;
+
+	mt6991_stream_quiesce(stream);
+	stream->pcm = s;
+	stream->error = 0;
+	reinit_completion(&stream->prepared);
+	atomic_set(&stream->state, TURNER_WARMUP);
+	queue_work(system_unbound_wq, &stream->work);
+	if (!wait_for_completion_timeout(&stream->prepared, msecs_to_jiffies(2000))) {
+		mt6991_stream_quiesce(stream);
+		return -ETIMEDOUT;
+	}
+	return READ_ONCE(stream->error);
+}
