Subject: [RFC PATCH] clk: mediatek: add the vendor-verified MT6991 i2c_north mux

Disassembled the vendor clk-mt6991.ko: ck_i2c_north_sel is id 40 on
CLK_CFG_11 with shift 24/width 3, update bit 31, and the hardware voter
window 0x30/0x34/0x2c18. Register it so the north I2C wrapper's bus gates
have a parent clock.

--- a/drivers/clk/mediatek/clk-mt8196-topckgen.c
+++ b/drivers/clk/mediatek/clk-mt8196-topckgen.c
@@ -188,6 +188,10 @@
 #define HWV_CG_5_DONE	0x2c14
 #define HWV_CG_6_SET	0x0030
 #define HWV_CG_6_CLR	0x0034
+#ifndef MT6991_CLK_TOP_I2C_NORTH
+#define MT6991_CLK_TOP_I2C_NORTH	40
+#endif
+
 #define HWV_CG_6_DONE	0x2c18
 #define HWV_CG_7_SET	0x0038
 #define HWV_CG_7_CLR	0x003c
@@ -1025,6 +1029,12 @@
 		CLK_CFG_11, CLK_CFG_11_SET, CLK_CFG_11_CLR,
 		0, 3, 7, CLK_CFG_UPDATE1, TOP_MUX_I2C_PERI_SHIFT,
 		CLK_FENC_STATUS_MON_1, 19),
+	/* Vendor clk-mt6991.ko: id 40, shift 24, upd 31, HWV 0x30/0x34/0x2c18. */
+	MUX_GATE_HWV_FENC_CLR_SET_UPD(MT6991_CLK_TOP_I2C_NORTH, "i2c_north", i2c_parents,
+		CLK_CFG_11, CLK_CFG_11_SET, CLK_CFG_11_CLR,
+		HWV_CG_6_DONE, HWV_CG_6_SET, HWV_CG_6_CLR,
+		24, 3, 31, CLK_CFG_UPDATE1, TOP_MUX_I2C_NORTH_SHIFT,
+		CLK_FENC_STATUS_MON_1, 16),
 	MUX_GATE_HWV_FENC_CLR_SET_UPD(MT6991_CLK_TOP_UART, "uart", uart_parents,
 		CLK_CFG_6, CLK_CFG_6_SET, CLK_CFG_6_CLR,
 		HWV_CG_3_DONE, HWV_CG_3_SET, HWV_CG_3_CLR,
