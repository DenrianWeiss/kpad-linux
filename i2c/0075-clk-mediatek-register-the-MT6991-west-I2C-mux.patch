 drivers/clk/mediatek/clk-mt8196-topckgen.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/drivers/clk/mediatek/clk-mt8196-topckgen.c b/drivers/clk/mediatek/clk-mt8196-topckgen.c
index ede17cf..3b60715 100644
