Subject: [PATCH] dt-bindings: clock: describe the MT6991 firmware peripheral providers

--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/mediatek,mt6991-cksys.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6991-cksys.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6991 firmware peripheral clock providers
+
+maintainers:
+  - Guangjie Song <guangjie.song@mediatek.com>
+
+description:
+  Firmware uses distinct clock IDs for the selector or gate and its
+  peripheral client aliases. Each reference takes one firmware clock ID.
+
+properties:
+  compatible:
+    items:
+      - enum:
+          - mediatek,mt6991-cksys
+          - mediatek,mt6991-imp_iic_wrap_w
+          - mediatek,mt6991-pericfg_ao
+      - const: syscon
+
+  reg:
+    maxItems: 1
+
+  '#clock-cells':
+    const: 1
+
+  hw-voter-regmap:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Firmware reference to the hardware clock voter.
+
+required:
+  - compatible
+  - reg
+  - '#clock-cells'
+
+if:
+  properties:
+    compatible:
+      contains:
+        const: mediatek,mt6991-imp_iic_wrap_w
+then:
+  properties:
+    hw-voter-regmap: false
+else:
+  required:
+    - hw-voter-regmap
+
+additionalProperties: false
