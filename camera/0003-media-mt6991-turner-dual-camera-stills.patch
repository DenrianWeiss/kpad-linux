+	{ ANA_A, 0x100, 0x00202020, 0x00202020 }, /* CDPHY_RX_ASYM_AFIFO_CTRL_0 */
+	{ ANA_A, 0x00c, 0x08000000, 0x08000000 }, /* CDPHY_RX_ANA_3 */
