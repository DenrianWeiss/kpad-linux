@@ -0,0 +1,360 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Turner OV08F10 front sensor, 24 MHz stock preview mode. */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <media/mipi-csi2.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-subdev.h>
+#include "front-preview.h"
+
+struct rail_setting {
+	const char *name;
+	int uv;
+	int delay_us;
+};
+static const struct rail_setting rails[] = {
+	{ "dovdd", 1800000, 1000 }, { "avdd1", 3200000, 6000 },
+	{ "dvdd", 1450000, 1000 }, { "avdd", 2800000, 1000 },
+	{ "dvdd1", 1200000, 6000 },
+};
+
+struct turner_sensor {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct i2c_client *client;
+	struct device *dev;
+	struct clk *clk;
+	struct pinctrl *pins;
+	struct pinctrl_state *low, *high, *drive, *off;
+	struct regulator *supplies[ARRAY_SIZE(rails)];
+	unsigned int nrails;
+	bool clock_on;
+};
+
+/* #156 has no CAMTG0 clock provider; the trial build supplies the clock. */
+#ifdef TURNER_LIVE_CLOCK
+#include "live-camtg0.h"
+#endif
+
+static void power_down(struct turner_sensor *s)
+{
+	pinctrl_select_state(s->pins, s->low);
+	pinctrl_select_state(s->pins, s->off);
+	if (s->clock_on) {
+		clk_disable_unprepare(s->clk);
+		s->clock_on = false;
+	}
+	while (s->nrails) {
+		unsigned int i = --s->nrails;
+		/* RT6160 enable pin is tied high on Turner. */
+		if (i != 1 && regulator_disable(s->supplies[i]))
+			dev_warn(s->dev, "could not disable %s\n", rails[i].name);
+		else
+			regulator_set_voltage(s->supplies[i], 0, INT_MAX);
+	}
+}
+
+static int power_up(struct turner_sensor *s)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(rails); i++) {
+		if (i == 1) {
+			ret = pinctrl_select_state(s->pins, s->low);
+			if (ret)
+				goto fail;
+			usleep_range(1000, 1200);
+		}
+		ret = regulator_set_voltage(s->supplies[i], rails[i].uv, rails[i].uv);
+		if (ret)
+			goto fail;
+		if (i != 1) {
+			ret = regulator_enable(s->supplies[i]);
+			if (ret) {
+				regulator_set_voltage(s->supplies[i], 0, INT_MAX);
+				goto fail;
+			}
+		}
+		s->nrails++;
+		usleep_range(rails[i].delay_us, rails[i].delay_us + 200);
+	}
+	ret = pinctrl_select_state(s->pins, s->high);
+	if (ret)
+		goto fail;
+	usleep_range(1000, 1200);
+	ret = clk_prepare_enable(s->clk);
+	if (ret)
+		goto fail;
+	s->clock_on = true;
+	ret = pinctrl_select_state(s->pins, s->drive);
+	if (ret)
+		goto fail;
+	usleep_range(6000, 6500);
+	return 0;
+fail:
+	power_down(s);
+	return ret;
+}
+
+static int write_table(struct i2c_adapter *adap, const u8 (*table)[2], size_t count)
+{
+	for (size_t i = 0; i < count; i++) {
+		u8 pair[2] = { table[i][0], table[i][1] };
+		struct i2c_msg msg = { .addr = 0x10, .buf = pair, .len = sizeof(pair) };
+		int ret = i2c_transfer(adap, &msg, 1);
+
+		if (ret != 1)
+			return ret < 0 ? ret : -EIO;
+	}
+	return 0;
+}
+
+static int read_reg(struct i2c_adapter *adap, u8 reg, u8 *value)
+{
+	struct i2c_msg msgs[] = {
+		{ .addr = 0x10, .buf = &reg, .len = 1 },
+		{ .addr = 0x10, .flags = I2C_M_RD, .buf = value, .len = 1 },
+	};
+	int ret = i2c_transfer(adap, msgs, ARRAY_SIZE(msgs));
+
+	return ret == ARRAY_SIZE(msgs) ? 0 : ret < 0 ? ret : -EIO;
+}
+
+static int start(struct turner_sensor *s)
+{
+	static const u8 wake[][2] = {
+		{0xfd, 0}, {0x21, 6}, {0x21, 4}, {0x21, 0}, {0xfd, 0}, {0xc2, 0x38},
+	};
+	static const u8 on[][2] = {
+		{0xfd, 1}, {1, 3}, {0xfd, 0}, {0xa0, 1}, {0xfd, 0},
+		{0xe7, 3}, {0xe7, 0}, {0x20, 0x0f},
+	};
+	struct i2c_adapter *adap = s->client->adapter;
+	u8 size[4], active;
+	int ret = power_up(s);
+
+	if (ret)
+		return ret;
+
+	ret = write_table(adap, wake, ARRAY_SIZE(wake));
+	if (ret)
+		goto fail;
+	usleep_range(5000, 5500);
+	ret = write_table(adap, preview, ARRAY_SIZE(preview));
+	for (unsigned int i = 0; !ret && i < ARRAY_SIZE(size); i++)
+		ret = read_reg(adap, 0x8e + i, &size[i]);
+	if (!ret && memcmp(size, (const u8[]){0x0c, 0xc0, 0x09, 0x90}, 4))
+		ret = -EIO;
+	if (!ret)
+		ret = write_table(adap, on, ARRAY_SIZE(on));
+	if (!ret)
+		ret = read_reg(adap, 0xa0, &active);
+	if (!ret && active == 1)
+		return 0;
+	ret = ret ?: -EIO;
+fail:
+	power_down(s);
+	return ret;
+}
+
+static int stop(struct turner_sensor *s)
+{
+	static const u8 off[][2] = { {0xfd, 0}, {0xa0, 0}, {0xfd, 0}, {0x20, 0x0b} };
+	static const u8 sleep[][2] = { {0xc2, 0x3a}, {0xfd, 0}, {0x21, 7} };
+	struct i2c_adapter *adap = s->client->adapter;
+	int ret = write_table(adap, off, ARRAY_SIZE(off));
+	u8 active;
+
+	msleep(40);
+	if (!ret)
+		ret = read_reg(adap, 0xa0, &active);
+	if (!ret && active)
+		ret = -EIO;
+	if (!ret)
+		ret = write_table(adap, sleep, ARRAY_SIZE(sleep));
+	power_down(s);
+	return ret;
+}
+
+static int enable(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+		  u32 pad, u64 streams)
+{
+	return start(container_of(sd, struct turner_sensor, sd));
+}
+static int disable(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+		   u32 pad, u64 streams)
+{
+	return stop(container_of(sd, struct turner_sensor, sd));
+}
+
+static int format(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+		  struct v4l2_subdev_format *fmt)
+{
+	if (fmt->pad || fmt->stream)
+		return -EINVAL;
+	fmt->format = (struct v4l2_mbus_framefmt){
+		.width = 3264, .height = 2448, .code = MEDIA_BUS_FMT_SBGGR10_1X10,
+		.field = V4L2_FIELD_NONE, .colorspace = V4L2_COLORSPACE_RAW,
+	};
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	return 0;
+}
+static int init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {};
+	return format(sd, state, &fmt);
+}
+static int code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+		struct v4l2_subdev_mbus_code_enum *item)
+{
+	if (item->index || item->pad || item->stream)
+		return -EINVAL;
+	item->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	return 0;
+}
+static int bus_config(struct v4l2_subdev *sd, unsigned int pad,
+		      struct v4l2_mbus_config *cfg)
+{
+	if (pad)
+		return -EINVAL;
+	/* The Turner preview table specifies 280.8 Mpixel/s, RAW10, two lanes. */
+	*cfg = (struct v4l2_mbus_config) {
+		.type = V4L2_MBUS_CSI2_DPHY,
+		.link_freq = 702000000,
+		.bus.mipi_csi2 = { .num_data_lanes = 2, .data_lanes = { 1, 2 } },
+	};
+	return 0;
+}
+
+static int frame_desc(struct v4l2_subdev *sd, unsigned int pad,
+		      struct v4l2_mbus_frame_desc *desc)
+{
+	if (pad)
+		return -EINVAL;
+	*desc = (struct v4l2_mbus_frame_desc) {
+		.type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2,
+		.num_entries = 1,
+		.entry = { {
+			.pixelcode = MEDIA_BUS_FMT_SBGGR10_1X10,
+			.bus.csi2 = { .vc = 0, .dt = MIPI_CSI2_DT_RAW10 },
+		} },
+	};
+	return 0;
+}
+static const struct v4l2_subdev_pad_ops pad_ops = {
+	.get_mbus_config = bus_config, .get_frame_desc = frame_desc,
+	.enum_mbus_code = code, .get_fmt = v4l2_subdev_get_fmt, .set_fmt = format,
+	.enable_streams = enable, .disable_streams = disable,
+};
+static const struct v4l2_subdev_video_ops video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+static const struct v4l2_subdev_ops ops = { .pad = &pad_ops, .video = &video_ops };
+static const struct v4l2_subdev_internal_ops internal_ops = { .init_state = init_state };
+
+
+static int front_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct turner_sensor *s;
+	unsigned int i;
+	u8 id[2];
+	struct pinctrl_state *scl, *sda;
+	int ret;
+
+	if (of_property_match_string(dev->of_node, "sensor-names",
+				     "turnerov08f10front_mipi_raw") < 0)
+		return -ENODEV;
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+	s->dev = dev;
+	s->client = client;
+#ifdef TURNER_LIVE_CLOCK
+	s->clk = live_camtg0(dev);
+#else
+	s->clk = devm_clk_get(dev, "mclk");
+#endif
+	if (IS_ERR(s->clk))
+		return dev_err_probe(dev, PTR_ERR(s->clk), "MCLK unavailable\n");
+	if (clk_get_rate(s->clk) != 24000000)
+		return dev_err_probe(dev, -EINVAL, "expected 24 MHz MCLK\n");
+	s->pins = devm_pinctrl_get(dev);
+	if (IS_ERR(s->pins))
+		return PTR_ERR(s->pins);
+	s->low = pinctrl_lookup_state(s->pins, "rst_low");
+	s->high = pinctrl_lookup_state(s->pins, "rst_high");
+	s->drive = pinctrl_lookup_state(s->pins, "mclk_6mA");
+	s->off = pinctrl_lookup_state(s->pins, "mclk_off");
+	if (IS_ERR(s->low) || IS_ERR(s->high) || IS_ERR(s->drive) || IS_ERR(s->off))
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(rails); i++) {
+		s->supplies[i] = devm_regulator_get_optional(dev, rails[i].name);
+		if (IS_ERR(s->supplies[i]))
+			return dev_err_probe(dev, PTR_ERR(s->supplies[i]), "missing %s\n", rails[i].name);
+	}
+	scl = pinctrl_lookup_state(s->pins, "scl_ap");
+	sda = pinctrl_lookup_state(s->pins, "sda_ap");
+	if (IS_ERR(scl) || IS_ERR(sda))
+		return -ENOENT;
+	ret = pinctrl_select_state(s->pins, scl);
+	if (!ret)
+		ret = pinctrl_select_state(s->pins, sda);
+	if (!ret)
+		ret = power_up(s);
+	if (ret)
+		return ret;
+	ret = read_reg(client->adapter, 0, &id[0]);
+	if (!ret)
+		ret = read_reg(client->adapter, 1, &id[1]);
+	power_down(s);
+	if (ret || id[0] != 0x56 || id[1] != 0x08)
+		return dev_err_probe(dev, ret ?: -ENODEV, "chip ID check failed\n");
+	v4l2_i2c_subdev_init(&s->sd, client, &ops);
+	s->sd.internal_ops = &internal_ops;
+	s->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&s->sd.entity, 1, &s->pad);
+	if (ret)
+		return ret;
+	ret = v4l2_subdev_init_finalize(&s->sd);
+	if (!ret) {
+		ret = v4l2_async_register_subdev_sensor(&s->sd);
+		if (!ret)
+			return 0;
+		v4l2_subdev_cleanup(&s->sd);
+	}
+	media_entity_cleanup(&s->sd.entity);
+	return ret;
+}
+static void front_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct turner_sensor *s = container_of(sd, struct turner_sensor, sd);
+
+	v4l2_async_unregister_subdev(sd);
+	if (s->clock_on)
+		stop(s);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+}
+static const struct of_device_id matches[] = {
+	{ .compatible = "mediatek,imgsensor" }, {}
+};
+static struct i2c_driver front_driver = {
+	.driver = { .name = "turner-ov08f10", .of_match_table = matches },
+	.probe = front_probe, .remove = front_remove,
+};
+module_i2c_driver(front_driver);
+MODULE_DESCRIPTION("Turner OV08F10 front camera");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/mediatek/turner/isp8/turner-camera-domains.c b/drivers/media/platform/mediatek/turner/isp8/turner-camera-domains.c
new file mode 100644
index 0000000..1e82561
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/isp8/turner-camera-domains.c
@@ -0,0 +1,187 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Firmware DT identifiers for the MT6991 ISP8 camera power path. */
+#include <linux/module.h>
+#include <linux/mfd/syscon.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/regmap.h>
+
+struct camera_bank {
+	unsigned int set, clear, done, enable, pending_set, pending_clear;
+};
+static const struct camera_bank camera = { 0x218, 0x21c, 0x141c, 0x1410, 0x146c, 0x1470 };
+static const struct camera_bank phy = { 0x220, 0x224, 0x142c, 0x1420, 0x1474, 0x1478 };
+static const struct domain_info {
+	unsigned int id, bit;
+	const char *name;
+	const struct camera_bank *bank;
+	int parent;
+} infos[] = {
+	{ 2,  2, "mm-infra1", NULL, -1 },
+	{ 16, 21, "cam-vcore", &camera, 0 },
+	{ 17, 20, "cam-main", &camera, 1 },
+	{ 35, 5, "csi-bs-rx", &phy, 0 },
+	{ 36, 6, "csi-ls-rx", &phy, 0 },
+};
+
+struct domain {
+	struct generic_pm_domain pd;
+	const struct domain_info *info;
+	struct regmap *map;
+	bool inherited, sampled;
+};
+struct camera_power {
+	struct domain domains[ARRAY_SIZE(infos)];
+	struct generic_pm_domain *by_id[37];
+	struct genpd_onecell_data cells;
+	struct of_phandle_args mmup, infra;
+};
+
+static int wait_bit(struct domain *d, unsigned int reg, bool high)
+{
+	unsigned int v;
+	return regmap_read_poll_timeout(d->map, reg, v,
+			!!(v & BIT(d->info->bit)) == high, 10, 300000);
+}
+
+static int vote(struct domain *d, bool on)
+{
+	const struct camera_bank *b = d->info->bank;
+	unsigned int mask = BIT(d->info->bit), v;
+	int ret;
+
+	/* Keep the initial AP vote from the first-stage kernel intact. */
+	if (!d->sampled) {
+		ret = regmap_read(d->map, b ? b->set : 0x100, &v);
+		if (ret)
+			return ret;
+		d->inherited = !!(v & mask);
+		d->sampled = true;
+	}
+	if (!on && d->inherited)
+		return 0;
+	if (!b) {
+		unsigned int reg = on ? 0x104 : 0x108;
+
+		/* MT6991 requires the vote to be repeated across clock idle. */
+		ret = regmap_write(d->map, reg, mask);
+		if (!ret)
+			ret = regmap_write(d->map, reg, mask);
+		if (!ret)
+			ret = wait_bit(d, 0x100, on);
+		if (!ret && on)
+			ret = regmap_read_poll_timeout(d->map, 0x144, v, v == 1, 10, 300000);
+		return ret;
+	}
+	ret = wait_bit(d, b->done, true);
+	if (!ret)
+		ret = regmap_write(d->map, on ? b->set : b->clear, mask);
+	if (!ret)
+		ret = wait_bit(d, on ? b->set : b->clear, on);
+	if (!ret && !on)
+		usleep_range(100, 150);
+	if (!ret)
+		ret = wait_bit(d, b->done, true);
+	if (!ret && on)
+		ret = wait_bit(d, b->enable, true);
+	if (!ret)
+		ret = wait_bit(d, on ? b->pending_set : b->pending_clear, false);
+	return ret;
+}
+
+static int power_on(struct generic_pm_domain *pd)
+{
+	struct domain *d = container_of(pd, struct domain, pd);
+	int ret = vote(d, true);
+
+	if (ret) {
+		pr_err("turner camera: %s vote failed: %d\n", pd->name, ret);
+		if (d->sampled && !d->inherited)
+			vote(d, false);
+	}
+	return ret;
+}
+
+static int power_off(struct generic_pm_domain *pd)
+{
+	return vote(container_of(pd, struct domain, pd), false);
+}
+
+static int camera_domains_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct camera_power *p;
+	struct regmap *mm, *infra;
+	unsigned int i = 0, linked = 1;
+	int ret;
+
+	mm = syscon_regmap_lookup_by_phandle(dev->of_node, "mm-hw-ccf-regmap");
+	if (IS_ERR(mm))
+		return PTR_ERR(mm);
+	infra = syscon_regmap_lookup_by_phandle(dev->of_node, "mminfra-hwv-regmap");
+	if (IS_ERR(infra))
+		return PTR_ERR(infra);
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->mmup.np = of_find_compatible_node(NULL, NULL, "mediatek,mt6991-hwv-scp-power-controller");
+	if (!p->mmup.np)
+		return -EPROBE_DEFER;
+	p->mmup.args_count = 1;
+	p->mmup.args[0] = 0; /* mm-proc-dormant in the #156 compact binding */
+	p->infra.np = dev->of_node;
+	p->infra.args_count = 1;
+	p->infra.args[0] = infos[0].id;
+	for (; i < ARRAY_SIZE(infos); i++) {
+		struct domain *d = &p->domains[i];
+
+		d->pd.name = infos[i].name;
+		d->pd.power_on = power_on;
+		d->pd.power_off = power_off;
+		d->info = &infos[i];
+		d->map = infos[i].bank ? mm : infra;
+		ret = pm_genpd_init(&d->pd, NULL, true);
+		if (ret)
+			goto rollback;
+		p->by_id[infos[i].id] = &d->pd;
+	}
+	for (; linked < ARRAY_SIZE(infos); linked++) {
+		ret = pm_genpd_add_subdomain(&p->domains[infos[linked].parent].pd,
+					     &p->domains[linked].pd);
+		if (ret)
+			goto rollback;
+	}
+	p->cells.domains = p->by_id;
+	p->cells.num_domains = ARRAY_SIZE(p->by_id);
+	ret = of_genpd_add_provider_onecell(dev->of_node, &p->cells);
+	if (ret)
+		goto rollback;
+	ret = of_genpd_add_subdomain(&p->mmup, &p->infra);
+	if (ret) {
+		of_genpd_del_provider(dev->of_node);
+		goto rollback;
+	}
+	of_node_put(p->mmup.np);
+	return 0;
+rollback:
+	while (linked > 1) {
+		linked--;
+		pm_genpd_remove_subdomain(&p->domains[infos[linked].parent].pd, &p->domains[linked].pd);
+	}
+	while (i)
+		pm_genpd_remove(&p->domains[--i].pd);
+	of_node_put(p->mmup.np);
+	return ret;
+}
+static const struct of_device_id matches[] = {
+	{ .compatible = "mediatek,mt6991-hfrpsys-hwv" }, {}
+};
+static struct platform_driver camera_domains = {
+	.driver = { .name = "turner-camera-domains", .of_match_table = matches, .suppress_bind_attrs = true },
+	.probe = camera_domains_probe,
+};
+/* These shared genpds live for the lifetime of the SoC. */
+builtin_platform_driver(camera_domains);
+MODULE_DESCRIPTION("MT6991 firmware camera power domains");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/mediatek/turner/isp8/turner-capture-mode.h b/drivers/media/platform/mediatek/turner/isp8/turner-capture-mode.h
new file mode 100644
index 0000000..de50b61
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/isp8/turner-capture-mode.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+	{ TOP_CTL, 0x018, BIT(24), BIT(24) }, /* software config level */
+	{ TOP_CTL, 0x008, BIT(ASYNC_INDEX), BIT(ASYNC_INDEX) }, /* async clock */
+	{ TOP_CTL, 0x00c, BIT(0), BIT(0) }, /* outmux0 clock */
+	{ ASYNC, 0x000, BIT(24 + ASYNC_INDEX) | BIT(ASYNC_INDEX), BIT(24 + ASYNC_INDEX) }, /* physical input, debug on */
+#include PHY_REGISTERS
+	{ MAC, 0x304, U32_MAX, (MODE_HEIGHT << 16) | MODE_WIDTH }, /* size checker */
+	{ OUTMUX, 0x000, 3, 0 }, /* normal configuration */
+	{ OUTMUX, 0x008, 1, 1 }, /* 16 pixels per cycle */
+	{ OUTMUX, 0x00c, 0x1f1f73, ASYNC_INDEX << 4 }, /* async0, full port, first and last VC0 */
+	{ OUTMUX, 0x010, 0x1f, 0 }, /* tag 0 references VC0 */
+	{ OUTMUX, 0x018, 0x73, ASYNC_INDEX << 4 }, /* source async0 */
+	{ OUTMUX, 0x080, 0x3f1f11, 0x2b0001 }, /* accept VC0 RAW10 */
+	{ OUTMUX, 0x084, U32_MAX, ((MODE_HEIGHT - 1) << 16) | MODE_WIDTH },
+	{ OUTMUX, 0x02c, 1, 1 }, /* ready */
+	{ OUTMUX, 0x01c, 1, 1 }, /* commit */
+	/* CAMSV A DDR request and image write FIFO thresholds. */
+	{ SV, 0x150, 0x1e, 0x16 }, { SV, 0x158, 0x1e, 0x16 },
+	{ SV_DMA, 0x008, U32_MAX, 0x86660555 }, { SV_DMA, 0x004, U32_MAX, 0x14440333 },
+	{ SV_DMA, 0x000, U32_MAX, 0x12220111 }, { SV_DMA, 0x00c, U32_MAX, 0x81110000 },
+	{ SV_DMA, 0x0e8, U32_MAX, 0x84000355 }, { SV_DMA, 0x0e4, U32_MAX, 0x12ab0200 },
+	{ SV_DMA, 0x0e0, U32_MAX, 0x115600ab }, { SV_DMA, 0x0ec, U32_MAX, 0x80ab0000 },
+	{ SV, 0x554, U32_MAX, 1 }, /* CCD tag 0 packed RAW10 */
+	{ SV, 0x55c, U32_MAX, 1 }, /* enable tag */
+	{ SV, 0x170, U32_MAX, 0x20 }, /* CCD single tag timing */
+	{ SV, 0x18c, U32_MAX, 3 }, /* timestamp control */
+	{ SV, 0x548, U32_MAX, MODE_WIDTH << 16 }, /* grab pixels from column zero */
+	{ SV, 0x54c, U32_MAX, MODE_HEIGHT << 16 }, /* grab lines from row zero */
+	{ SV, 0x1cc, 0xff, 1 }, /* first tag */
+	{ SV, 0x1c8, 0xff, 1 }, /* last tag */
+	{ SV, 0x1b8, 0xff, 1 }, /* tag group 0 */
+	{ SV, 0x140, BIT(11) | BIT(4) | 3, BIT(4) | 3 }, /* CMOS on */
+	{ SV, 0x148, 1, 0 }, /* viewfinder on */
+	{ SV, 0x1b4, BIT(30), BIT(30) }, /* enable double buffering */
+	{ MAC, 0x020, 0x003f1f31, 0x002b0011 }, /* S0 DI: VC0 RAW10 */
diff --git a/drivers/media/platform/mediatek/turner/isp8/turner-csi-packets.c b/drivers/media/platform/mediatek/turner/isp8/turner-csi-packets.c
new file mode 100644
index 0000000..4e54886
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/isp8/turner-csi-packets.c
@@ -0,0 +1,475 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/module.h>
+#include "turner-sv-dma.h"
+
+static bool verify_write;
+module_param(verify_write, bool, 0444);
+#include <linux/device.h>
+#include <linux/interrupt.h>
+#include <linux/of_irq.h>
+#include <linux/io.h>
+#include <linux/of_address.h>
+#include <media/v4l2-subdev.h>
+#include "turner-receiver-clocks.h"
+
+enum csi_block { ANA_A, ANA_B, DPHY, MAC_TOP, MAC, TOP_CTL, ASYNC, OUTMUX, SV, SV_INNER, SV_DMA, SV_DMA_INNER, DELAY };
+static const char * const blocks[] = {
+	"seninf-csi-rxana-csia", "seninf-csi-rxana-csib", "seninf-csi-dphy",
+	"seninf-csi-mac-top", "seninf-csi-mac-csia", "seninf-top", "seninf-async-top", "base", "base", "inner_base", "base_DMA", "inner_base_DMA",
+};
+struct field_write { u16 bank, offset; u32 mask, value; };
+#define PHY_REGISTERS "turner-phy-mode.h"
+#define ASYNC_INDEX 0
+#define MODE_WIDTH TURNER_WIDTH
+#define MODE_HEIGHT TURNER_HEIGHT
+static const struct field_write rear_mode[] = {
+#include "turner-capture-mode.h"
+};
+#undef MODE_WIDTH
+#undef MODE_HEIGHT
+#define MODE_WIDTH 2104
+#define MODE_HEIGHT 1184
+static const struct field_write rear_video_mode[] = {
+#include "turner-capture-mode.h"
+};
+#undef PHY_REGISTERS
+#undef ASYNC_INDEX
+#undef MODE_WIDTH
+#undef MODE_HEIGHT
+#define PHY_REGISTERS "turner-front-phy.h"
+#define ASYNC_INDEX 4
+#define MODE_WIDTH 3264
+#define MODE_HEIGHT 2448
+static const struct field_write front_mode[] = {
+#include "turner-capture-mode.h"
+};
+#undef PHY_REGISTERS
+#undef ASYNC_INDEX
+#undef MODE_WIDTH
+#undef MODE_HEIGHT
+
+
+struct sv_frame_irq {
+	void __iomem *base;
+	void __iomem *inner;
+	atomic_t frames, errors, done;
+	/* One outstanding FBC entry; queued buffers stay owned until copied. */
+	spinlock_t lock;
+	void __iomem *dma;
+	struct turner_image *slots[2];
+	u64 timestamp[2];
+	unsigned int submitted, finished, released;
+	bool running;
+	wait_queue_head_t wait;
+};
+
+static irqreturn_t sv_frame_start(int irq, void *data)
+{
+	struct sv_frame_irq *sv = data;
+
+	/* Status is read-to-clear, as in the MT6991 CAMSV SOF handler. */
+	if (!(readl(sv->base + 0x360) & BIT(2)))
+		return IRQ_NONE;
+	atomic_inc(&sv->frames);
+	return IRQ_HANDLED;
+}
+
+/* Called under lock, both from DONE and when a stalled consumer returns space. */
+static void enqueue_available(struct sv_frame_irq *sv)
+{
+	struct turner_image *image;
+
+	if (!sv->running || sv->submitted != sv->finished ||
+	    sv->submitted - sv->released >= ARRAY_SIZE(sv->slots))
+		return;
+	image = sv->slots[sv->submitted % ARRAY_SIZE(sv->slots)];
+	writel(lower_32_bits(image->addr), sv->dma + 0x200);
+	writel(upper_32_bits(image->addr), sv->dma + 0x204);
+	sv->submitted++;
+	writel(0x8080, sv->base + 0x540);
+}
+
+static irqreturn_t sv_result(int irq, void *data)
+{
+	struct sv_frame_irq *sv = data;
+	u32 errors = readl(sv->inner + 0x350);
+	u32 done = readl(sv->base + 0x348);
+
+	atomic_or(errors, &sv->errors);
+	if (done & BIT(16)) {
+		spin_lock(&sv->lock);
+		if (sv->running && sv->finished != sv->submitted) {
+			sv->timestamp[sv->finished % ARRAY_SIZE(sv->slots)] = ktime_get_ns();
+			sv->finished++;
+			if (!errors)
+				enqueue_available(sv);
+		}
+		spin_unlock(&sv->lock);
+	}
+	atomic_or(done, &sv->done);
+	if (errors || done)
+		wake_up(&sv->wait);
+	return (errors || done) ? IRQ_HANDLED : IRQ_NONE;
+}
+
+static bool report_larb(struct device *dev, struct device_node *sv)
+{
+	struct device_node *larb = of_parse_phandle(sv, "mediatek,larbs", 0);
+	void __iomem *base;
+	u32 port;
+
+	if (!larb)
+		return false;
+	base = of_iomap(larb, 0);
+	of_node_put(larb);
+	if (!base)
+		return false;
+	dev_info(dev, "CAMSV LARB14 port control: CQ %#x IMGO0 %#x IMGO1 %#x\n",
+		 readl(base + 0x380), readl(base + 0x384), readl(base + 0x388));
+	port = readl(base + 0x384);
+	iounmap(base);
+	return port == 1;
+}
+
+int turner_sample_packets(struct device *dev, struct v4l2_subdev *sensor, struct turner_stream *stream, bool front)
+{
+	void __iomem *regs[ARRAY_SIZE(blocks)] = {};
+	struct device_node *node, *outmux, *sv;
+	bool binned = !front && stream && stream->width == 2104;
+	const struct field_write *preview = front ? front_mode : binned ? rear_video_mode : rear_mode;
+	const unsigned int count = front ? ARRAY_SIZE(front_mode) : ARRAY_SIZE(rear_mode);
+	const unsigned int width = stream ? stream->width : front ? 3264 : TURNER_WIDTH;
+	const unsigned int height = stream ? stream->height : front ? 2448 : TURNER_HEIGHT;
+	u32 saved[ARRAY_SIZE(front_mode) > ARRAY_SIZE(rear_mode) ? ARRAY_SIZE(front_mode) : ARRAY_SIZE(rear_mode)], port;
+	u32 packets, size = 0;
+	u8 *packed = NULL;
+	unsigned int i;
+	struct sv_frame_irq frame_irq = {};
+	struct turner_image image = { .stride = ALIGN(width * 10 / 8, 64), .height = height };
+	struct turner_image alternate = { .stride = image.stride, .height = height };
+	int idx, irq, result_irq, ret = 0;
+
+	if (stream) {
+		struct v4l2_subdev_format fmt = { .which = V4L2_SUBDEV_FORMAT_ACTIVE,
+			.format = { .width = width, .height = height } };
+
+		ret = v4l2_subdev_call_state_active(sensor, pad, set_fmt, &fmt);
+		if (ret || fmt.format.width != width || fmt.format.height != height)
+			return ret ?: -EINVAL;
+	}
+	for_each_compatible_node(node, NULL, "mediatek,seninf-csi") {
+		if (!of_property_read_u32(node, "csi-port", &port) && port == (front ? 0 : 2))
+			break;
+	}
+	if (!node)
+		return -ENODEV;
+	outmux = of_find_node_by_path("/soc/seninf-top@3a300000/seninf-outmux-top/seninf-outmux@3a100000");
+	sv = of_find_node_by_path("/soc/camsv1@3a500000");
+	if (!outmux || !sv) {
+		of_node_put(sv);
+		of_node_put(outmux);
+		of_node_put(node);
+		return -ENODEV;
+	}
+	for (i = 0; i < ARRAY_SIZE(blocks); i++) {
+		struct device_node *resource = i >= SV ? sv : i == OUTMUX ? outmux :
+			(i == TOP_CTL || i == ASYNC ? dev->of_node : node);
+
+		idx = of_property_match_string(resource, "reg-names", blocks[i]);
+		if (idx < 0 || !(regs[i] = of_iomap(resource, idx))) {
+			ret = -ENXIO;
+			goto out;
+		}
+	}
+	/* Never take over a running writer. */
+	if (readl(regs[SV] + 0x40) || readl(regs[SV_INNER] + 0x40)) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (!report_larb(dev, sv) && (verify_write || stream)) {
+		ret = -ENODEV;
+		goto out;
+	}
+	spin_lock_init(&frame_irq.lock);
+	init_waitqueue_head(&frame_irq.wait);
+	frame_irq.base = regs[SV];
+	frame_irq.inner = regs[SV_INNER];
+	irq = of_irq_get(sv, 1);
+	if (irq <= 0) {
+		ret = irq ?: -ENXIO;
+		goto out;
+	}
+	ret = request_irq(irq, sv_frame_start, 0, "turner-camsv-sof", &frame_irq);
+	if (ret)
+		goto out;
+	result_irq = of_irq_get(sv, 0);
+	ret = result_irq > 0 ? request_irq(result_irq, sv_result, 0, "turner-camsv-result", &frame_irq) :
+		(result_irq ?: -ENXIO);
+	if (ret) {
+		free_irq(irq, &frame_irq);
+		goto out;
+	}
+	if (stream) {
+		packed = kvmalloc_array(height, image.stride, GFP_KERNEL);
+		if (!packed) {
+			free_irq(result_irq, &frame_irq);
+			free_irq(irq, &frame_irq);
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
+	if (verify_write || stream) {
+		ret = turner_image_alloc(&image);
+		if (ret) {
+			free_irq(result_irq, &frame_irq);
+			free_irq(irq, &frame_irq);
+			goto out;
+		}
+	}
+	if (stream) {
+		ret = turner_image_alloc(&alternate);
+		if (ret) {
+			turner_image_free(&image);
+			free_irq(result_irq, &frame_irq);
+			free_irq(irq, &frame_irq);
+			goto out;
+		}
+	}
+	for (i = 0; i < count; i++) {
+		const struct field_write *w = &preview[i];
+		void __iomem *reg;
+
+		if (w->bank == DELAY) {
+			udelay(w->value);
+			continue;
+		}
+		if (image.data && w->bank == SV && w->offset == 0x140)
+			turner_sv_arm(regs[SV], regs[SV_DMA], &image);
+		reg = regs[w->bank] + w->offset;
+		saved[i] = readl(reg);
+		writel((saved[i] & ~w->mask) | w->value, reg);
+	}
+	writel(0x701, regs[SV] + 0x34c);
+	writel(BIT(16), regs[SV] + 0x344);
+	writel(BIT(2), regs[SV] + 0x35c);
+	if (stream) {
+		spin_lock_irq(&frame_irq.lock);
+		frame_irq.slots[0] = &image;
+		frame_irq.slots[1] = &alternate;
+		frame_irq.dma = regs[SV_DMA];
+		frame_irq.submitted = 1; /* turner_sv_arm queued slot zero */
+		frame_irq.running = true;
+		spin_unlock_irq(&frame_irq.lock);
+	}
+	packets = readl(regs[MAC] + 0xdc);
+	ret = v4l2_subdev_enable_streams(sensor, 0, BIT_ULL(0));
+	if (!ret) {
+		unsigned int sample;
+
+		/* Wait for the sensor's startup frames before admitting data. */
+		msleep(120);
+		writel(1, regs[SV] + 0x148);
+		if (stream) {
+			while (stream->pixels) {
+				struct turner_image *completed;
+				unsigned int slot;
+				u64 timestamp;
+
+				if (!wait_event_timeout(frame_irq.wait,
+						READ_ONCE(frame_irq.finished) != READ_ONCE(frame_irq.released) ||
+						atomic_read(&frame_irq.errors), msecs_to_jiffies(600))) {
+					ret = -ETIMEDOUT;
+					break;
+				}
+				spin_lock_irq(&frame_irq.lock);
+				slot = frame_irq.released % ARRAY_SIZE(frame_irq.slots);
+				completed = frame_irq.slots[slot];
+				timestamp = frame_irq.timestamp[slot];
+				spin_unlock_irq(&frame_irq.lock);
+				size = readl(regs[MAC] + 0x308);
+				if (atomic_read(&frame_irq.errors) || size != ((height << 16) | width)) {
+					ret = -EIO;
+					break;
+				}
+				dma_rmb();
+				memcpy(packed, completed->data, image.stride * height);
+				spin_lock_irq(&frame_irq.lock);
+				frame_irq.released++;
+				enqueue_available(&frame_irq);
+				spin_unlock_irq(&frame_irq.lock);
+				stream->complete(stream, packed, image.stride, timestamp);
+			}
+		} else {
+			for (sample = 0; sample < 4; sample++) {
+				msleep(60);
+				size = readl(regs[MAC] + 0x308);
+				dev_info(dev, "CSI2 sample %u: packets %#x -> %#x, line/frame %#x, VC0 RAW10 size %#x, IRQ %#x\n",
+					 sample, packets, readl(regs[MAC] + 0xdc), readl(regs[MAC] + 0xd0),
+					 size, readl(regs[MAC] + 0xc8));
+				dev_info(dev, "outmux0 IRQ %#x path %#x tag0 %#x, async %#x\n",
+					 readl(regs[OUTMUX] + 0x44), readl(regs[OUTMUX] + 0x24),
+					 readl(regs[OUTMUX] + 0x90), readl(regs[ASYNC]));
+				dev_info(dev, "CAMSV A inner: SEN_MODE %#x VF %#x FRMSIZE %#x record %#x\n",
+					 readl(regs[SV_INNER] + 0x140), readl(regs[SV_INNER] + 0x148),
+					 readl(regs[SV_INNER] + 0x188), readl(regs[SV_INNER] + 0x180));
+				dev_info(dev, "CAMSV A SOF interrupts %u error %#x vf-state %#x grab %#x/%#x\n",
+					 atomic_read(&frame_irq.frames), atomic_read(&frame_irq.errors),
+					 readl(regs[SV_INNER] + 0x550), readl(regs[SV_INNER] + 0x548),
+					 readl(regs[SV_INNER] + 0x54c));
+			}
+		}
+		if (verify_write) {
+			u32 max_x = 0, tg_max_x = 0, n;
+			for (n = 0; n < 4096; n++) {
+				max_x = max(max_x, readl(regs[OUTMUX] + 0x90) >> 16);
+				tg_max_x = max(tg_max_x, readl(regs[SV_INNER] + 0x180) >> 16);
+			}
+			dev_info(dev, "OUTMUX max x %u TG max x %u MAC check %#x error size %#x\n",
+				 max_x, tg_max_x, readl(regs[MAC] + 0x300), readl(regs[MAC] + 0x30c));
+			dev_info(dev, "ASYNC status %#x debug %#x/%#x/%#x; MAC OPT %#x\n",
+				 readl(regs[TOP_CTL] + 0x24), readl(regs[ASYNC] + 0x3c),
+				 readl(regs[ASYNC] + 0x40), readl(regs[ASYNC] + 0x44),
+				 readl(regs[MAC] + 0x04));
+		}
+		{
+			int stop;
+
+			spin_lock_irq(&frame_irq.lock);
+			frame_irq.running = false;
+			spin_unlock_irq(&frame_irq.lock);
+			stop = v4l2_subdev_disable_streams(sensor, 0, BIT_ULL(0));
+
+			ret = ret ?: stop;
+		}
+		if (!ret && size != ((height << 16) | width))
+			ret = -ENODATA;
+	}
+	spin_lock_irq(&frame_irq.lock);
+	frame_irq.running = false;
+	spin_unlock_irq(&frame_irq.lock);
+	if (image.data) {
+		size_t y;
+		unsigned int rows = 0;
+		int err;
+
+		dev_info(dev, "CAMSV active DMA %#x mask %#x address %#x stride %#x FBC %#x/%#x\n",
+			 readl(regs[SV_INNER] + 0x40), readl(regs[SV_INNER] + 0x44),
+			 readl(regs[SV_DMA_INNER] + 0x200), readl(regs[SV_DMA_INNER] + 0x210),
+			 readl(regs[SV_INNER] + 0x540), readl(regs[SV_INNER] + 0x544));
+		err = turner_sv_drain(regs[SV], regs[SV_DMA]);
+
+		if (err) {
+			dev_err(dev, "DMA drain timed out, retaining buffer %pad\n", &image.addr);
+			ret = err;
+		} else {
+			dma_rmb();
+
+			for (y = 0; y < height; y++) {
+				const u8 *src = image.data + image.stride * y;
+				if (memchr_inv(src, 0xa5, width * 10 / 8))
+					rows++;
+			}
+			dev_info(dev, "CAMSV wrote %u of %u image rows\n", rows, height);
+			if (rows != height || (!stream && !(atomic_read(&frame_irq.done) & BIT(16))) ||
+			    atomic_read(&frame_irq.errors))
+				ret = -ENODATA;
+			if (alternate.data)
+				turner_image_free(&alternate);
+			turner_image_free(&image);
+		}
+	}
+	writel(0, regs[SV] + 0x35c);
+	writel(0, regs[SV] + 0x344);
+	writel(0, regs[SV] + 0x34c);
+	free_irq(result_irq, &frame_irq);
+	dev_info(dev, "CAMSV final error %#x done %#x\n",
+		 atomic_read(&frame_irq.errors), atomic_read(&frame_irq.done));
+	free_irq(irq, &frame_irq);
+	while (i) {
+		const struct field_write *w = &preview[--i];
+		void __iomem *reg;
+
+		if (w->bank == DELAY)
+			continue;
+		reg = regs[w->bank] + w->offset;
+		writel((readl(reg) & ~w->mask) | (saved[i] & w->mask), reg);
+	}
+out:
+	kvfree(packed);
+	of_node_put(sv);
+	of_node_put(outmux);
+	of_node_put(node);
+	for (i = 0; i < ARRAY_SIZE(blocks); i++)
+		if (regs[i])
+			iounmap(regs[i]);
+	return ret;
+}
+
+static const struct field_write front_phy[] = {
+#include "turner-front-phy.h"
+	{ MAC, 0x304, U32_MAX, (2448U << 16) | 3264 },
+	{ MAC, 0x020, 0x003f1f31, 0x002b0011 },
+};
+
+int turner_front_packets(struct device *dev, struct v4l2_subdev *sensor)
+{
+	void __iomem *regs[MAC + 1] = {};
+	struct device_node *node;
+	u32 saved[ARRAY_SIZE(front_phy)], port, before, after, size;
+	unsigned int i, applied = 0;
+	int ret = 0;
+
+	for_each_compatible_node(node, NULL, "mediatek,seninf-csi")
+		if (!of_property_read_u32(node, "csi-port", &port) && port == 0)
+			break;
+	if (!node)
+		return -ENODEV;
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		int index = of_property_match_string(node, "reg-names", blocks[i]);
+
+		regs[i] = index < 0 ? NULL : of_iomap(node, index);
+		if (!regs[i]) {
+			ret = -ENXIO;
+			goto out;
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(front_phy); i++) {
+		const struct field_write *w = &front_phy[i];
+
+		if (w->bank == DELAY) {
+			udelay(w->value);
+		} else {
+			saved[i] = readl(regs[w->bank] + w->offset);
+			writel((saved[i] & ~w->mask) | w->value, regs[w->bank] + w->offset);
+		}
+		applied++;
+	}
+	ret = v4l2_subdev_enable_streams(sensor, 0, BIT_ULL(0));
+	if (!ret) {
+		int stop;
+
+		msleep(120);
+		before = readl(regs[MAC] + 0xdc);
+		msleep(180);
+		after = readl(regs[MAC] + 0xdc);
+		size = readl(regs[MAC] + 0x308);
+		dev_info(dev, "front CSI0 packets %#x -> %#x, RAW10 size %ux%u, IRQ %#x\n",
+			 before, after, size & 0xffff, size >> 16, readl(regs[MAC] + 0xc4));
+		stop = v4l2_subdev_disable_streams(sensor, 0, BIT_ULL(0));
+		ret = stop ?: (size == ((2448U << 16) | 3264) && before != after ? 0 : -EIO);
+	}
+out:
+	while (applied) {
+		const struct field_write *w = &front_phy[--applied];
+
+		if (w->bank != DELAY)
+			writel(saved[applied], regs[w->bank] + w->offset);
+	}
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		if (regs[i])
+			iounmap(regs[i]);
+	of_node_put(node);
+	return ret;
+}
