diff --git a/drivers/media/platform/mediatek/turner/rear/drive-fix.c b/drivers/media/platform/mediatek/turner/rear/drive-fix.c
new file mode 100644
index 0000000..1e79b8a
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/rear/drive-fix.c
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/module.h>
+#include <linux/of.h>
+static struct of_changeset pins;
+static int __init setup(void)
+{
+	static const u32 raw[] = { 1, 0, 1, 2, 3, 0, 1 };
+	struct device_node *sensor, *state, *group;
+	struct property *prop;
+	int ret = 0;
+	u32 val;
+	unsigned int i;
+	char key[16];
+
+	sensor = of_find_node_by_path("/soc/i2c@13bb0000/sensor0@10");
+	if (!sensor)
+		return -ENODEV;
+	of_changeset_init(&pins);
+	for (i = 0; i < ARRAY_SIZE(raw); i++) {
+		snprintf(key, sizeof(key), "pinctrl-%u", i);
+		state = of_parse_phandle(sensor, key, 0);
+		group = of_get_child_by_name(state, "pins-cmd-dat");
+		of_node_put(state);
+		if (!group) { ret = -EINVAL; break; }
+		prop = of_find_property(group, "drive-strength", NULL);
+		if (!prop || of_property_read_u32(group, "drive-strength", &val) || val != raw[i])
+			ret = -EINVAL;
+		else
+			ret = of_changeset_remove_property(&pins, group, prop);
+		if (!ret)
+			ret = of_changeset_add_prop_u32(&pins, group, "drive-strength", (val + 1) * 2);
+		of_node_put(group);
+		if (ret)
+			break;
+	}
+	of_node_put(sensor);
+	if (!ret)
+		ret = of_changeset_apply(&pins);
+	if (ret)
+		of_changeset_destroy(&pins);
+	return ret;
+}
+static void __exit cleanup(void)
+{
+	of_changeset_revert(&pins);
+	of_changeset_destroy(&pins);
+}
+module_init(setup);
+module_exit(cleanup);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Apply rear camera pin drive units to running Turner DT");
diff --git a/drivers/media/platform/mediatek/turner/rear/live-camtg3.h b/drivers/media/platform/mediatek/turner/rear/live-camtg3.h
new file mode 100644
index 0000000..cb87ea6
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/rear/live-camtg3.h
@@ -0,0 +1,76 @@
+#include "clk-mtk.h"
+#include "clk-mux.h"
+
+static const char * const tg3_parents[] = {
+	"clk26m", "univpll_192m_d32", "univpll_192m_d16", "clk26m_d2",
+	"osc_d40", "osc_d32", "univpll_192m_d10", "univpll_192m_d8",
+	"univpll_d6_d16", "osc_d20", "tvdpll1_d16", "univpll_d6_d8",
+};
+static const struct mtk_mux tg3[] = {
+	MUX_GATE_HWV_FENC_CLR_SET_UPD(0, "turner_camtg3", tg3_parents,
+		0x50, 0x54, 0x58, 0x2c24, 0x48, 0x4c,
+		24, 4, 31, 0x4, 19, 0x39c, 12),
+};
+static DEFINE_SPINLOCK(tg3_lock);
+
+static void unregister_tg3(void *data)
+{
+	mtk_clk_unregister_muxes(tg3, ARRAY_SIZE(tg3), data);
+}
+
+static struct clk *live_camtg3(struct device *dev)
+{
+	struct of_phandle_args spec;
+	struct of_changeset cs;
+	struct clk_hw_onecell_data *data;
+	struct clk_hw *factor;
+	struct clk *parent, *mclk;
+	u32 voter;
+	int ret;
+
+	ret = of_parse_phandle_with_args(dev->of_node, "clocks", "#clock-cells", 8, &spec);
+	if (ret)
+		return ERR_PTR(ret);
+	if (spec.args_count != 1 || spec.args[0] != 21 ||
+	    !of_device_is_compatible(spec.np, "mediatek,mt6991-vlp_cksys")) {
+		ret = -EINVAL;
+		goto put;
+	}
+	ret = of_property_read_u32(spec.np, "hw-voter-regmap", &voter);
+	if (ret)
+		goto put;
+	data = mtk_devm_alloc_clk_data(dev, 1);
+	if (!data) {
+		ret = -ENOMEM;
+		goto put;
+	}
+	factor = devm_clk_hw_register_fixed_factor(dev, "univpll_192m_d8",
+		"univpll_192m", 0, 1, 8);
+	if (IS_ERR(factor)) {
+		ret = PTR_ERR(factor);
+		goto put;
+	}
+	of_changeset_init(&cs);
+	ret = of_changeset_add_prop_u32(&cs, spec.np, "mediatek,hardware-voter", voter);
+	if (!ret)
+		ret = of_changeset_apply(&cs);
+	if (!ret) {
+		ret = mtk_clk_register_muxes(dev, tg3, ARRAY_SIZE(tg3), spec.np, &tg3_lock, data);
+		of_changeset_revert(&cs);
+	}
+	of_changeset_destroy(&cs);
+	if (ret)
+		goto put;
+	ret = devm_add_action_or_reset(dev, unregister_tg3, data);
+	if (ret)
+		goto put;
+	mclk = devm_clk_hw_get_clk(dev, data->hws[0], NULL);
+	parent = devm_clk_hw_get_clk(dev, factor, NULL);
+	if (IS_ERR(mclk) || IS_ERR(parent))
+		ret = IS_ERR(mclk) ? PTR_ERR(mclk) : PTR_ERR(parent);
+	else
+		ret = clk_set_parent(mclk, parent);
+put:
+	of_node_put(spec.np);
+	return ret ? ERR_PTR(ret) : mclk;
+}
diff --git a/drivers/media/platform/mediatek/turner/rear/mode-header.py b/drivers/media/platform/mediatek/turner/rear/mode-header.py
new file mode 100644
index 0000000..77e909a
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/rear/mode-header.py
@@ -0,0 +1,17 @@
+"""Convert the two ordered vendor register lists into a regmap sequence."""
+import csv
+import sys
+from pathlib import Path
+
+root = Path(sys.argv[1])
+for stage in ("init", "preview", "custom1"):
+    print(f"static const struct reg_sequence {stage}_regs[] = {{")
+    path = root / f"turnerov13b10wide_{stage}_setting.tsv"
+    with path.open() as stream:
+        for row in csv.DictReader(stream, delimiter="\t"):
+            reg, val = (int(row[k], 16) for k in ("register", "value"))
+            if not 0 <= reg <= 0xffff or not 0 <= val <= 255 or reg == 0x0100:
+                raise ValueError(f"unexpected mode entry in {path}: {row}")
+            delay = 5000 if (reg, val) == (0x0103, 1) else 0
+            print(f"	{{ 0x{reg:04x}, 0x{val:02x}, {delay} }},")
+    print("};")
diff --git a/drivers/media/platform/mediatek/turner/rear/turner-ov13b10.c b/drivers/media/platform/mediatek/turner/rear/turner-ov13b10.c
new file mode 100644
index 0000000..1c4fffb
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/rear/turner-ov13b10.c
@@ -0,0 +1,343 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Turner OV13B10 rear sensor, 24 MHz stock preview mode. */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <media/mipi-csi2.h>
+#include <media/v4l2-async.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-subdev.h>
+#include "turner-preview.h"
+
+struct rail_setting {
+	const char *name;
+	int uv;
+	int delay_us;
+};
+static const struct rail_setting rails[] = {
+	{ "avdd1", 3200000, 2000 }, { "dvdd1", 1450000, 1000 },
+	{ "afvdd", 2800000, 1000 }, { "avdd", 2800000, 2000 },
+	{ "dovdd", 1800000, 1000 }, { "dvdd", 1200000, 1000 },
+};
+
+struct turner_sensor {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler controls;
+	struct v4l2_ctrl *pattern;
+	struct device *dev;
+	struct regmap *map;
+	struct clk *clk;
+	struct pinctrl *pins;
+	struct pinctrl_state *low, *high, *drive, *off;
+	struct regulator *supplies[ARRAY_SIZE(rails)];
+	unsigned int nrails;
+	bool clock_on;
+};
+
+static const char * const test_patterns[] = { "Disabled", "Color bars" };
+static bool verify_stream;
+module_param(verify_stream, bool, 0444);
+MODULE_PARM_DESC(verify_stream, "Perform a short start/readback/stop test at probe");
+
+/* #156 has no CAMTG3 clock provider; the trial build supplies the clock. */
+#ifdef TURNER_LIVE_CLOCK
+#include "live-camtg3.h"
+#endif
+
+static void power_down(struct turner_sensor *s)
+{
+	pinctrl_select_state(s->pins, s->low);
+	pinctrl_select_state(s->pins, s->off);
+	if (s->clock_on) {
+		clk_disable_unprepare(s->clk);
+		s->clock_on = false;
+	}
+	while (s->nrails) {
+		unsigned int i = --s->nrails;
+		/* RT6160 enable pin is tied high on Turner. */
+		if (i && regulator_disable(s->supplies[i]))
+			dev_warn(s->dev, "could not disable %s\n", rails[i].name);
+		else
+			regulator_set_voltage(s->supplies[i], 0, INT_MAX);
+	}
+}
+
+static int power_up(struct turner_sensor *s)
+{
+	unsigned int i;
+	int ret;
+
+	ret = pinctrl_select_state(s->pins, s->low);
+	if (ret)
+		return ret;
+	usleep_range(1000, 1200);
+	for (i = 0; i < ARRAY_SIZE(rails); i++) {
+		ret = regulator_set_voltage(s->supplies[i], rails[i].uv, rails[i].uv);
+		if (ret)
+			goto fail;
+		if (i) {
+			ret = regulator_enable(s->supplies[i]);
+			if (ret) {
+				regulator_set_voltage(s->supplies[i], 0, INT_MAX);
+				goto fail;
+			}
+		}
+		s->nrails++;
+		usleep_range(rails[i].delay_us, rails[i].delay_us + 200);
+	}
+	ret = pinctrl_select_state(s->pins, s->high);
+	if (ret)
+		goto fail;
+	usleep_range(6000, 6500);
+	ret = clk_prepare_enable(s->clk);
+	if (ret)
+		goto fail;
+	s->clock_on = true;
+	ret = pinctrl_select_state(s->pins, s->drive);
+	if (ret)
+		goto fail;
+	usleep_range(1000, 1500);
+	return 0;
+fail:
+	power_down(s);
+	return ret;
+}
+
+static int start(struct turner_sensor *s, unsigned int width, unsigned int height)
+{
+	u8 size[4];
+	unsigned int mode;
+	int ret = power_up(s);
+
+	if (ret)
+		return ret;
+	ret = regmap_multi_reg_write(s->map, init_regs, ARRAY_SIZE(init_regs));
+	if (!ret) {
+		if (width == 2104)
+			ret = regmap_multi_reg_write(s->map, custom1_regs, ARRAY_SIZE(custom1_regs));
+		else
+			ret = regmap_multi_reg_write(s->map, preview_regs, ARRAY_SIZE(preview_regs));
+	}
+	if (!ret)
+		ret = regmap_bulk_read(s->map, 0x3808, size, sizeof(size));
+	if (!ret && (((size[0] << 8) | size[1]) != width || ((size[2] << 8) | size[3]) != height))
+		ret = -EIO;
+	if (!ret)
+		ret = regmap_update_bits(s->map, 0x5080, 0x8c,
+					 s->pattern && v4l2_ctrl_g_ctrl(s->pattern) ? BIT(7) : 0);
+	if (!ret)
+		ret = regmap_write(s->map, 0x0100, 1);
+	if (!ret)
+		ret = regmap_read(s->map, 0x0100, &mode);
+	if (!ret && !(mode & 1))
+		ret = -EIO;
+	if (ret)
+		power_down(s);
+	return ret;
+}
+
+static int stop(struct turner_sensor *s)
+{
+	unsigned int mode;
+	int ret = regmap_write(s->map, 0x0100, 0);
+
+	if (!ret)
+		ret = regmap_read(s->map, 0x0100, &mode);
+	if (!ret && (mode & 1))
+		ret = -EIO;
+	usleep_range(35000, 36000);
+	power_down(s);
+	return ret;
+}
+
+static int enable(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+		  u32 pad, u64 streams)
+{
+	const struct v4l2_mbus_framefmt *fmt = v4l2_subdev_state_get_format(state, pad);
+
+	return start(container_of(sd, struct turner_sensor, sd), fmt->width, fmt->height);
+}
+static int disable(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+		   u32 pad, u64 streams)
+{
+	return stop(container_of(sd, struct turner_sensor, sd));
+}
+
+static int format(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+		  struct v4l2_subdev_format *fmt)
+{
+	bool binned = fmt->format.width == 2104;
+
+	if (fmt->pad || fmt->stream)
+		return -EINVAL;
+	fmt->format = (struct v4l2_mbus_framefmt){
+		.width = binned ? 2104 : 4208, .height = binned ? 1184 : 3120, .code = MEDIA_BUS_FMT_SBGGR10_1X10,
+		.field = V4L2_FIELD_NONE, .colorspace = V4L2_COLORSPACE_RAW,
+	};
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	return 0;
+}
+static int init_state(struct v4l2_subdev *sd, struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {};
+	return format(sd, state, &fmt);
+}
+static int code(struct v4l2_subdev *sd, struct v4l2_subdev_state *state,
+		struct v4l2_subdev_mbus_code_enum *item)
+{
+	if (item->index || item->pad || item->stream)
+		return -EINVAL;
+	item->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	return 0;
+}
+static int bus_config(struct v4l2_subdev *sd, unsigned int pad,
+		      struct v4l2_mbus_config *cfg)
+{
+	if (pad)
+		return -EINVAL;
+	/* The Turner preview table specifies 480 Mpixel/s, RAW10, four lanes. */
+	*cfg = (struct v4l2_mbus_config) {
+		.type = V4L2_MBUS_CSI2_DPHY,
+		.link_freq = 600000000,
+		.bus.mipi_csi2 = { .num_data_lanes = 4, .data_lanes = { 1, 2, 3, 4 } },
+	};
+	return 0;
+}
+
+static int frame_desc(struct v4l2_subdev *sd, unsigned int pad,
+		      struct v4l2_mbus_frame_desc *desc)
+{
+	if (pad)
+		return -EINVAL;
+	*desc = (struct v4l2_mbus_frame_desc) {
+		.type = V4L2_MBUS_FRAME_DESC_TYPE_CSI2,
+		.num_entries = 1,
+		.entry = { {
+			.pixelcode = MEDIA_BUS_FMT_SBGGR10_1X10,
+			.bus.csi2 = { .vc = 0, .dt = MIPI_CSI2_DT_RAW10 },
+		} },
+	};
+	return 0;
+}
+static const struct v4l2_subdev_pad_ops pad_ops = {
+	.get_mbus_config = bus_config, .get_frame_desc = frame_desc,
+	.enum_mbus_code = code, .get_fmt = v4l2_subdev_get_fmt, .set_fmt = format,
+	.enable_streams = enable, .disable_streams = disable,
+};
+static const struct v4l2_subdev_video_ops video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+static const struct v4l2_subdev_ops ops = { .pad = &pad_ops, .video = &video_ops };
+static const struct v4l2_subdev_internal_ops internal_ops = { .init_state = init_state };
+static const struct regmap_config regconfig = { .reg_bits = 16, .val_bits = 8 };
+
+static int rear_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct turner_sensor *s;
+	unsigned int i;
+	u8 id[3];
+	int ret;
+
+	if (of_property_match_string(dev->of_node, "sensor-names",
+				     "turnerov13b10wide_mipi_raw") < 0)
+		return -ENODEV;
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return -ENOMEM;
+	s->dev = dev;
+	s->map = devm_regmap_init_i2c(client, &regconfig);
+	if (IS_ERR(s->map))
+		return PTR_ERR(s->map);
+#ifdef TURNER_LIVE_CLOCK
+	s->clk = live_camtg3(dev);
+#else
+	s->clk = devm_clk_get(dev, "mclk");
+#endif
+	if (IS_ERR(s->clk))
+		return dev_err_probe(dev, PTR_ERR(s->clk), "MCLK unavailable\n");
+	if (clk_get_rate(s->clk) != 24000000)
+		return dev_err_probe(dev, -EINVAL, "expected 24 MHz MCLK\n");
+	s->pins = devm_pinctrl_get(dev);
+	if (IS_ERR(s->pins))
+		return PTR_ERR(s->pins);
+	s->low = pinctrl_lookup_state(s->pins, "rst_low");
+	s->high = pinctrl_lookup_state(s->pins, "rst_high");
+	s->drive = pinctrl_lookup_state(s->pins, "mclk_4mA");
+	s->off = pinctrl_lookup_state(s->pins, "mclk_off");
+	if (IS_ERR(s->low) || IS_ERR(s->high) || IS_ERR(s->drive) || IS_ERR(s->off))
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(rails); i++) {
+		s->supplies[i] = devm_regulator_get_optional(dev, rails[i].name);
+		if (IS_ERR(s->supplies[i]))
+			return dev_err_probe(dev, PTR_ERR(s->supplies[i]), "missing %s\n", rails[i].name);
+	}
+	ret = power_up(s);
+	if (ret)
+		return ret;
+	ret = regmap_bulk_read(s->map, 0x300a, id, sizeof(id));
+	power_down(s);
+	if (ret || memcmp(id, (const u8[]){0x56, 0x0d, 0x42}, sizeof(id)))
+		return dev_err_probe(dev, ret ?: -ENODEV, "chip ID check failed\n");
+	if (verify_stream) {
+		ret = start(s, 4208, 3120);
+		if (ret)
+			return dev_err_probe(dev, ret, "preview start failed\n");
+		msleep(150);
+		ret = stop(s);
+		if (ret)
+			return dev_err_probe(dev, ret, "preview stop failed\n");
+		dev_info(dev, "sensor ID %*phN, 4208x3120, stream on/off readback passed\n",
+			 (int)sizeof(id), id);
+	}
+	v4l2_i2c_subdev_init(&s->sd, client, &ops);
+	s->sd.internal_ops = &internal_ops;
+	s->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&s->sd.entity, 1, &s->pad);
+	if (ret)
+		return ret;
+	v4l2_ctrl_handler_init(&s->controls, 1);
+	s->pattern = v4l2_ctrl_new_std_menu_items(&s->controls, NULL, V4L2_CID_TEST_PATTERN,
+						  ARRAY_SIZE(test_patterns) - 1, 0, 0, test_patterns);
+	s->sd.ctrl_handler = &s->controls;
+	ret = s->controls.error ?: v4l2_subdev_init_finalize(&s->sd);
+	if (!ret) {
+		ret = v4l2_async_register_subdev_sensor(&s->sd);
+		if (!ret)
+			return 0;
+		v4l2_subdev_cleanup(&s->sd);
+	}
+	v4l2_ctrl_handler_free(&s->controls);
+	media_entity_cleanup(&s->sd.entity);
+	return ret;
+}
+static void rear_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct turner_sensor *s = container_of(sd, struct turner_sensor, sd);
+
+	v4l2_async_unregister_subdev(sd);
+	if (s->clock_on)
+		stop(s);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+}
+static const struct of_device_id matches[] = {
+	{ .compatible = "mediatek,imgsensor" }, {}
+};
+static struct i2c_driver rear_driver = {
+	.driver = { .name = "turner-ov13b10", .of_match_table = matches },
+	.probe = rear_probe, .remove = rear_remove,
+};
+module_i2c_driver(rear_driver);
+MODULE_DESCRIPTION("Turner OV13B10 rear camera");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/mediatek/turner/regulators/aw37004.c b/drivers/media/platform/mediatek/turner/regulators/aw37004.c
new file mode 100644
index 0000000..31a40a5
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/regulators/aw37004.c
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* AW37004 camera LDOs on Turner. */
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#define AW37004_PRODUCT_ID 0x00
+#define AW37004_VSEL_BASE  0x03
+#define AW37004_DISCHARGE  0x02
+#define AW37004_ENABLE     0x0e
+
+/* Selector zero restores a factory voltage outside the linear sequence. */
+static const struct linear_range digital_ranges[] = {
+	REGULATOR_LINEAR_RANGE(1200000, 0, 0, 0),
+	REGULATOR_LINEAR_RANGE(606000, 1, 255, 6000),
+};
+
+static const struct linear_range analog_ranges[] = {
+	REGULATOR_LINEAR_RANGE(2800000, 0, 0, 0),
+	REGULATOR_LINEAR_RANGE(1212500, 1, 255, 12500),
+};
+
+/* Request an explicit voltage code even when the POR default has that value. */
+static int aw37004_map_voltage(struct regulator_dev *rdev, int min_uv, int max_uv)
+{
+	const struct linear_range *range = &rdev->desc->linear_ranges[1];
+	int sel = range->min_sel;
+
+	if (min_uv > range->min)
+		sel += DIV_ROUND_UP(min_uv - range->min, range->step);
+	if (sel > range->max_sel ||
+	    regulator_list_voltage_linear_range(rdev, sel) > max_uv)
+		return -EINVAL;
+	return sel;
+}
+
+static const struct regulator_ops aw37004_ops = {
+	.list_voltage = regulator_list_voltage_linear_range,
+	.map_voltage = aw37004_map_voltage,
+	.set_voltage_sel = regulator_set_voltage_sel_regmap,
+	.get_voltage_sel = regulator_get_voltage_sel_regmap,
+	.enable = regulator_enable_regmap,
+	.disable = regulator_disable_regmap,
+	.is_enabled = regulator_is_enabled_regmap,
+};
+
+#define AW37004_LDO(_id, _name, _ranges) {			\
+	.id = _id, .name = _name, .type = REGULATOR_VOLTAGE,	\
+	.owner = THIS_MODULE, .ops = &aw37004_ops,		\
+	.n_voltages = 256, .linear_ranges = _ranges,		\
+	.n_linear_ranges = ARRAY_SIZE(_ranges),			\
+	.vsel_reg = AW37004_VSEL_BASE + _id, .vsel_mask = 0xff,	\
+	.enable_reg = AW37004_ENABLE, .enable_mask = BIT(_id),	\
+}
+
+static const struct regulator_desc regulators[] = {
+	AW37004_LDO(0, "dvdd1", digital_ranges),
+	AW37004_LDO(1, "dvdd2", digital_ranges),
+	AW37004_LDO(2, "avdd1", analog_ranges),
+	AW37004_LDO(3, "avdd2", analog_ranges),
+};
+
+static const struct regmap_config aw37004_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0x0f,
+};
+
+static int aw37004_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct regulator_config config = { .dev = dev };
+	unsigned long seen = 0;
+	unsigned int product;
+	int ret;
+
+	config.regmap = devm_regmap_init_i2c(client, &aw37004_regmap);
+	if (IS_ERR(config.regmap))
+		return PTR_ERR(config.regmap);
+	ret = regmap_read(config.regmap, AW37004_PRODUCT_ID, &product);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot read product ID\n");
+	if (product != 0)
+		return dev_err_probe(dev, -ENODEV, "unexpected product ID %#x\n", product);
+
+	/* Stock Turner initialization enables discharge on all four outputs. */
+	ret = regmap_write(config.regmap, AW37004_DISCHARGE, 0xff);
+	if (ret)
+		return ret;
+	for_each_available_child_of_node_scoped(dev->of_node, child) {
+		struct regulator_dev *rdev;
+		u16 id;
+
+		if (of_property_read_u16(child, "offset", &id) ||
+		    id >= ARRAY_SIZE(regulators) || test_and_set_bit(id, &seen))
+			return dev_err_probe(dev, -EINVAL, "invalid LDO offset in %pOF\n", child);
+		config.of_node = child;
+		config.init_data = of_get_regulator_init_data(dev, child, &regulators[id]);
+		if (!config.init_data)
+			return -ENOMEM;
+		rdev = devm_regulator_register(dev, &regulators[id], &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(dev, PTR_ERR(rdev), "cannot register %pOF\n", child);
+	}
+	return seen ? 0 : -ENODEV;
+}
+
+static const struct of_device_id aw37004_match[] = {
+	{ .compatible = "awinic,aw37004" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, aw37004_match);
+
+static struct i2c_driver aw37004_driver = {
+	.driver = {
+		.name = "aw37004-regulator",
+		.of_match_table = aw37004_match,
+	},
+	.probe = aw37004_probe,
+};
+module_i2c_driver(aw37004_driver);
+
+MODULE_DESCRIPTION("AW37004 camera regulators");
+MODULE_LICENSE("GPL");
