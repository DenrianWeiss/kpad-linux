+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/types.h>
+#define TURNER_WIDTH 4208U
+#define TURNER_HEIGHT 3120U
+#define TURNER_IMAGE_STRIDE ALIGN(TURNER_WIDTH * 10 / 8, 64)
+#define TURNER_IMAGE_SIZE (TURNER_IMAGE_STRIDE * TURNER_HEIGHT)
+struct turner_image {
