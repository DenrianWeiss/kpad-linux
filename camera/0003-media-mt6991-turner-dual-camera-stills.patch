Subject: [PATCH] media: mediatek: add Turner OV13B10 and OV08F10 V4L2 capture modules

diff --git a/drivers/media/platform/mediatek/turner/Makefile b/drivers/media/platform/mediatek/turner/Makefile
new file mode 100644
index 0000000..fa38871
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/Makefile
@@ -0,0 +1,28 @@
+# External modules for the #156 Turner camera bring-up.
+obj-m += turner-camera-domains.o
+turner-camera-domains-y := isp8/turner-camera-domains.o
+turner-ov08f10-y := front/turner-ov08f10.o
+obj-m += turner-ov08f10.o turner-ov13b10.o turner-seninf.o
+turner-ov13b10-y := rear/turner-ov13b10.o
+turner-seninf-y := isp8/turner-seninf.o isp8/turner-receiver-clocks.o isp8/turner-csi-packets.o isp8/turner-sv-dma.o isp8/turner-still.o
+
+ccflags-y += -I$(obj)/rear
+ifeq ($(TURNER_LIVE_CLOCK),1)
+ccflags-y += -DTURNER_LIVE_CLOCK -I$(srctree)/drivers/clk/mediatek
+endif
+
+quiet_cmd_turner_mode = GEN     $@
+      cmd_turner_mode = $(PYTHON3) $(src)/rear/mode-header.py $(src)/stock > $@.tmp && mv $@.tmp $@
+
+targets += rear/turner-preview.h
+$(obj)/rear/turner-preview.h: $(src)/rear/mode-header.py $(src)/stock/turnerov13b10wide_init_setting.tsv $(src)/stock/turnerov13b10wide_preview_setting.tsv $(src)/stock/turnerov13b10wide_custom1_setting.tsv FORCE
+	$(call if_changed,turner_mode)
+
+$(obj)/rear/turner-ov13b10.o: $(obj)/rear/turner-preview.h
+
+obj-m += north.o aw37004.o drive-fix.o front-pins.o
+north-y := clocks/north.o
+aw37004-y := regulators/aw37004.o
+drive-fix-y := rear/drive-fix.o
+front-pins-y := front/front-pins.o
+ccflags-y += -I$(srctree)/drivers/clk/mediatek
diff --git a/drivers/media/platform/mediatek/turner/clocks/north.c b/drivers/media/platform/mediatek/turner/clocks/north.c
new file mode 100644
index 0000000..106116b
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/clocks/north.c
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2025 MediaTek Inc.
+ *                    Guangjie Song <guangjie.song@mediatek.com>
+ * Copyright (c) 2025 Collabora Ltd.
+ *                    Laura Nao <laura.nao@collabora.com>
+ */
+#include <dt-bindings/clock/mediatek,mt8196-clock.h>
+
+#include <linux/clk-provider.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+
+#include "clk-gate.h"
+#include "clk-mtk.h"
+
+static const struct mtk_gate_regs imp_cg_regs = {
+	.set_ofs = 0xe08,
+	.clr_ofs = 0xe04,
+	.sta_ofs = 0xe00,
+};
+
+#define GATE_IMP(_id, _name, _parent, _shift) {	\
+		.id = _id,				\
+		.name = _name,				\
+		.parent_name = _parent,			\
+		.regs = &imp_cg_regs,			\
+		.shift = _shift,			\
+		.flags = CLK_OPS_PARENT_ENABLE,		\
+		.ops = &mtk_clk_gate_ops_setclr,	\
+	}
+
+static const struct mtk_gate impc_clks[] = {
+	GATE_IMP(CLK_IMPC_I2C11, "impc_i2c11", "i2c_p", 0),
+	GATE_IMP(CLK_IMPC_I2C12, "impc_i2c12", "i2c_p", 1),
+	GATE_IMP(CLK_IMPC_I2C13, "impc_i2c13", "i2c_p", 2),
+	GATE_IMP(CLK_IMPC_I2C14, "impc_i2c14", "i2c_p", 3),
+};
+
+static const struct mtk_clk_desc impc_mcd = {
+	.clks = impc_clks,
+	.num_clks = ARRAY_SIZE(impc_clks),
+};
+
+static const struct mtk_gate impe_clks[] = {
+	GATE_IMP(CLK_IMPE_I2C5, "impe_i2c5", "i2c_east", 0),
+};
+
+static const struct mtk_clk_desc impe_mcd = {
+	.clks = impe_clks,
+	.num_clks = ARRAY_SIZE(impe_clks),
+};
+
+static const struct mtk_gate_regs impn_hwv_regs = {
+	.set_ofs = 0x0000,
+	.clr_ofs = 0x0004,
+	.sta_ofs = 0x2c00,
+};
+
+#define GATE_HWV_IMPN(_id, _name, _parent, _shift) {	\
+		.id = _id,				\
+		.name = _name,				\
+		.parent_name = _parent,			\
+		.regs = &imp_cg_regs,			\
+		.hwv_regs = &impn_hwv_regs,		\
+		.shift = _shift,			\
+		.ops = &mtk_clk_gate_hwv_ops_setclr,	\
+		.flags = CLK_OPS_PARENT_ENABLE,		\
+	}
+
+static const struct mtk_gate impn_clks[] = {
+	GATE_IMP(CLK_IMPN_I2C1, "impn_i2c1", "i2c_north", 0),
+	GATE_IMP(CLK_IMPN_I2C2, "impn_i2c2", "i2c_north", 1),
+	GATE_IMP(CLK_IMPN_I2C4, "impn_i2c4", "i2c_north", 2),
+	GATE_HWV_IMPN(CLK_IMPN_I2C7, "impn_i2c7", "i2c_north", 3),
+	GATE_IMP(CLK_IMPN_I2C8, "impn_i2c8", "i2c_north", 4),
+	GATE_IMP(CLK_IMPN_I2C9, "impn_i2c9", "i2c_north", 5),
+};
+
+static const struct mtk_clk_desc impn_mcd = {
+	.clks = impn_clks,
+	.num_clks = ARRAY_SIZE(impn_clks),
+};
+
+/* The camera provider owns the three verified direct gates on MT6991.
+ * Other consumers need their respective voter and power-domain support.
+ */
+static const struct mtk_gate mt6991_north_clks[] = {
+	GATE_IMP(0, "impn_i2c2", "i2c_north", 1),
+	GATE_IMP(1, "impn_i2c8", "i2c_north", 4),
+	GATE_IMP(2, "impn_i2c9", "i2c_north", 5),
+};
+
+static const struct mtk_clk_desc mt6991_north_desc = {
+	.clks = mt6991_north_clks,
+	.num_clks = ARRAY_SIZE(mt6991_north_clks),
+};
+
+static struct clk_hw *mt6991_north_get(struct of_phandle_args *spec, void *data)
+{
+	struct clk_hw_onecell_data *clks = data;
+
+	if (spec->args_count != 1)
+		return ERR_PTR(-EINVAL);
+	switch (spec->args[0] / 2) {
+	case 1:
+		return clks->hws[0];
+	case 4:
+		return clks->hws[1];
+	case 5:
+		return clks->hws[2];
+	default:
+		return ERR_PTR(-ENOENT);
+	}
+}
+
+static const struct mtk_gate impw_clks[] = {
+	GATE_IMP(CLK_IMPW_I2C0, "impw_i2c0", "i2c_west", 0),
+	GATE_IMP(CLK_IMPW_I2C3, "impw_i2c3", "i2c_west", 1),
+	GATE_IMP(CLK_IMPW_I2C6, "impw_i2c6", "i2c_west", 2),
+	GATE_IMP(CLK_IMPW_I2C10, "impw_i2c10", "i2c_west", 3),
+};
+
+static const struct mtk_clk_desc impw_mcd = {
+	.clks = impw_clks,
+	.num_clks = ARRAY_SIZE(impw_clks),
+};
+
+static struct clk_hw *mt6991_fw_get(struct of_phandle_args *spec, void *data)
+{
+	struct clk_hw_onecell_data *clks = data;
+
+	if (spec->args_count != 1)
+		return ERR_PTR(-EINVAL);
+	/* Each gate is followed by its I2C client alias. */
+	if (spec->args[0] / 2 >= clks->num)
+		return ERR_PTR(-ENOENT);
+	return clks->hws[spec->args[0] / 2];
+}
+
+static int mt6991_fw_probe(struct platform_device *pdev)
+{
+	if (of_device_is_compatible(pdev->dev.of_node, "mediatek,mt6991-imp_iic_wrap_n"))
+		return mtk_clk_simple_probe_with_get(pdev, mt6991_north_get);
+	if (of_device_is_compatible(pdev->dev.of_node, "mediatek,mt6991-imp_iic_wrap_w") ||
+	    of_device_is_compatible(pdev->dev.of_node, "mediatek,mt6991-imp_iic_wrap_e") ||
+	    of_device_is_compatible(pdev->dev.of_node, "mediatek,mt6991-imp_iic_wrap_c"))
+		return mtk_clk_simple_probe_with_get(pdev, mt6991_fw_get);
+	return mtk_clk_simple_probe(pdev);
+}
+
+static const struct of_device_id of_match_clk_mt8196_imp_iic_wrap[] = {
+	{ .compatible = "mediatek,mt6991-imp_iic_wrap_c", .data = &impc_mcd },
+	{ .compatible = "mediatek,mt6991-imp_iic_wrap_e", .data = &impe_mcd },
+	{ .compatible = "mediatek,mt6991-imp_iic_wrap_n", .data = &mt6991_north_desc },
+	{ .compatible = "mediatek,mt6991-imp_iic_wrap_w", .data = &impw_mcd },
+	{ .compatible = "mediatek,mt8196-imp-iic-wrap-c", .data = &impc_mcd },
+	{ .compatible = "mediatek,mt8196-imp-iic-wrap-e", .data = &impe_mcd },
+	{ .compatible = "mediatek,mt8196-imp-iic-wrap-n", .data = &impn_mcd },
+	{ .compatible = "mediatek,mt8196-imp-iic-wrap-w", .data = &impw_mcd },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, of_match_clk_mt8196_imp_iic_wrap);
+
+static struct platform_driver clk_mt8196_imp_iic_wrap_drv = {
+	.probe = mt6991_fw_probe,
+	.remove = mtk_clk_simple_remove,
+	.driver = {
+		.name = "turner-camera-north",
+		.of_match_table = of_match_clk_mt8196_imp_iic_wrap,
+	},
+};
+module_platform_driver(clk_mt8196_imp_iic_wrap_drv);
+
+MODULE_DESCRIPTION("MediaTek MT8196 I2C Wrapper clocks driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/media/platform/mediatek/turner/front/front-pins.c b/drivers/media/platform/mediatek/turner/front/front-pins.c
new file mode 100644
index 0000000..1ff5963
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/front/front-pins.c
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/module.h>
+#include <linux/of.h>
+static struct of_changeset pins;
+static int __init setup(void)
+{
+	static const u32 raw[] = { 1, 0, 1, 2, 3 };
+	struct device_node *sensor, *state, *group;
+	struct property *prop;
+	int ret = 0;
+	u32 val;
+	unsigned int i;
+	char key[16];
+
+	sensor = of_find_node_by_path("/soc/i2c@139b0000/sensor1@11");
+	if (!sensor)
+		return -ENODEV;
+	of_changeset_init(&pins);
+	for (i = 0; i < ARRAY_SIZE(raw) + 2; i++) {
+		snprintf(key, sizeof(key), "pinctrl-%u", i);
+		state = of_parse_phandle(sensor, key, 0);
+		group = of_get_child_by_name(state, "pins-cmd-dat");
+		of_node_put(state);
+		if (!group) { ret = -EINVAL; break; }
+		if (i >= ARRAY_SIZE(raw)) {
+			/* The Paris pin table has no slew control for GPIO186. */
+			prop = of_find_property(group, "slew-rate", NULL);
+			ret = prop ? of_changeset_remove_property(&pins, group, prop) : -EINVAL;
+		} else {
+			prop = of_find_property(group, "drive-strength", NULL);
+			if (!prop || of_property_read_u32(group, "drive-strength", &val) || val != raw[i])
+				ret = -EINVAL;
+			else
+				ret = of_changeset_remove_property(&pins, group, prop);
+			if (!ret)
+				ret = of_changeset_add_prop_u32(&pins, group, "drive-strength", (val + 1) * 2);
+		}
+		of_node_put(group);
+		if (ret)
+			break;
+	}
+	of_node_put(sensor);
+	if (!ret)
+		ret = of_changeset_apply(&pins);
+	if (ret)
+		of_changeset_destroy(&pins);
+	return ret;
+}
+static void __exit cleanup(void)
+{
+	of_changeset_revert(&pins);
+	of_changeset_destroy(&pins);
+}
+module_init(setup);
+module_exit(cleanup);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Apply front camera pin drive units to running Turner DT");
