index 0000000..e162adb
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/isp8/turner-receiver-clocks.c
@@ -0,0 +1,297 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MT6991 clock sequence for direct CSI2 -> CAMSV A capture. Caller holds
+ * CAM_VCORE, CAM_MAIN and both PHY domains throughout the transaction.
+ */
+#include <linux/device.h>
+#include <media/v4l2-subdev.h>
+#include <linux/spmi.h>
+#include <linux/mfd/syscon.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/regmap.h>
+
+#include "turner-receiver-clocks.h"
+
+enum bank { TOP, VCORE, MAIN, HWV };
+struct gate {
+	const char *name;
+	enum bank control, status;
+	u16 request, release, done, status_reg;
+	u32 mask, status_mask;
+	bool rmw, status_inverted;
+};
+
+#define MUX(_name, _set, _done, _bit, _fence) \
+	{ _name, HWV, TOP, _set, _set + 4, _done, 0x174, BIT(_bit), BIT(_fence) }
+#define CAM_MAIN_MASK (BIT(1) | BIT(4) | BIT(9) | BIT(10) | BIT(11) | GENMASK(19, 16))
+static const struct gate gates[] = {
+	MUX("mminfra", 0x118, 0x2c8c, 15, 10),
+	MUX("cam", 0x100, 0x2c80, 7, 23),
+	MUX("camtm", 0x100, 0x2c80, 15, 22),
+	MUX("seninf2", 0xf0, 0x2c78, 23, 29),
+	{ "vcore", VCORE, VCORE, 0xa8, 0xa4, 0, 0xa0, BIT(0), BIT(0), false, true },
+	{ "subcommon", VCORE, VCORE, 0x2c, 0x2c, 0, 0x2c, 3, 3, true },
+	{ "cam-main", HWV, MAIN, 0, 4, 0x2c00, 0, CAM_MAIN_MASK, CAM_MAIN_MASK, false, true },
+	{ "camsv-a", MAIN, MAIN, 0x54, 0x50, 0, 0x4c, BIT(0), BIT(0), false, true },
+};
+
+static const struct gate seninf0 = MUX("seninf0", 0xf0, 0x2c78, 7, 31);
+
+static int apply_gate(struct regmap **maps, const struct gate *g, u32 *owned)
+{
+	struct regmap *control = maps[g->control];
+	u32 value;
+	int ret;
+
+	if (g->control == HWV)
+		ret = regmap_read(control, g->request, &value);
+	else {
+		ret = regmap_read(control, g->status_reg, &value);
+		if (!ret && g->status_inverted)
+			value = ~value;
+	}
+	if (ret)
+		return ret;
+	value = g->mask & ~value;
+	if (value) {
+		ret = g->rmw ? regmap_set_bits(control, g->request, value) :
+				regmap_write(control, g->request, value);
+		if (ret)
+			return ret;
+		*owned = value;
+	}
+	if (g->control == HWV) {
+		ret = regmap_read_poll_timeout(control, g->request, value,
+					(value & g->mask) == g->mask, 5, 10000);
+		if (!ret)
+			ret = regmap_read_poll_timeout(control, g->done, value,
+					(value & g->mask) == g->mask, 5, 10000);
+		if (ret)
+			return ret;
+	}
+	return regmap_read_poll_timeout(maps[g->status], g->status_reg, value,
+			((g->status_inverted ? ~value : value) & g->status_mask) == g->status_mask,
+			5, 10000);
+}
+
+static int release_gate(struct regmap **maps, const struct gate *g, u32 owned)
+{
+	struct regmap *control = maps[g->control];
+	u32 value;
+	int ret;
+
+	if (!owned)
+		return 0;
+	ret = g->rmw ? regmap_clear_bits(control, g->release, owned) :
+			regmap_write(control, g->release, owned);
+	if (!ret && g->control == HWV) {
+		ret = regmap_read_poll_timeout(control, g->request, value, !(value & owned), 5, 10000);
+		if (!ret)
+			ret = regmap_read_poll_timeout(control, g->done, value,
+						       (value & owned) == owned, 5, 10000);
+	}
+	return ret;
+}
+
+static int check_csi_mac(struct device *dev)
+{
+	struct device_node *node;
+	void __iomem *mac;
+	u32 port, version, ctrl, phy, active;
+	const u32 mode_mask = GENMASK(9, 8) | GENMASK(1, 0);
+	int index, ret = 0;
+
+	for_each_compatible_node(node, NULL, "mediatek,seninf-csi") {
+		if (!of_property_read_u32(node, "csi-port", &port) && port == 2)
+			break;
+	}
+	if (!node)
+		return -ENODEV;
+	index = of_property_match_string(node, "reg-names", "seninf-csi-mac-top");
+	mac = index < 0 ? NULL : of_iomap(node, index);
+	of_node_put(node);
+	if (!mac)
+		return -ENXIO;
+	version = readl(mac + 4);
+	ctrl = readl(mac);
+	phy = readl(mac + 0x40);
+	/* Full port mode joins the A and B halves into one four-lane D-PHY. */
+	writel(ctrl & ~BIT(16), mac);
+	writel((phy & ~mode_mask) | BIT(0), mac + 0x40);
+	active = readl(mac + 0x40);
+	if ((active & mode_mask) != BIT(0) || (readl(mac) & BIT(16)))
+		ret = -EIO;
+	dev_info(dev, "CSI2 MAC revision %#x, PHY control %#x -> %#x\n", version, phy, active);
+	writel(phy, mac + 0x40);
+	writel(ctrl, mac);
+	if (readl(mac) != ctrl || readl(mac + 0x40) != phy)
+		ret = -EIO;
+	iounmap(mac);
+	return ret;
+}
+
+static int read_camsv(struct device *dev)
+{
+	struct device_node *node;
+	void __iomem *base;
+	u32 id;
+	int index;
+
+	for_each_compatible_node(node, NULL, "mediatek,camsv") {
+		if (!of_property_read_u32(node, "mediatek,camsv-id", &id) && id == 0)
+			break;
+	}
+	if (!node)
+		return -ENODEV;
+	index = of_property_match_string(node, "reg-names", "base");
+	base = index < 0 ? NULL : of_iomap(node, index);
+	of_node_put(node);
+	if (!base)
+		return -ENXIO;
+	dev_info(dev, "CAMSV A SEN_MODE=%#x VF_CON=%#x PATH_CFG=%#x FRMSIZE=%#x\n",
+		 readl(base + 0x140), readl(base + 0x148),
+		 readl(base + 0x14c), readl(base + 0x188));
+	iounmap(base);
+	return 0;
+}
+
+static int read_vmm_uv(void)
+{
+	struct device_node *np = of_find_compatible_node(NULL, NULL, "mediatek,mt6363");
+	struct spmi_device *pmic;
+	u8 sel;
+	int ret;
+
+	if (!np)
+		return -ENODEV;
+	pmic = spmi_find_device_by_of_node(np);
+	of_node_put(np);
+	if (!pmic)
+		return -ENODEV;
+	/* Turner VMM is MT6363 VBUCK2 on the vendor PMIC register map. */
+	ret = spmi_ext_register_readl(pmic, 0x24e, &sel, 1);
+	put_device(&pmic->dev);
+	return ret ?: sel * 6250;
+}
+
+static int set_cam_parent(struct regmap *map, u32 sel)
+{
+	int ret = regmap_write(map, 0x38, 15);
+
+	if (!ret)
+		ret = regmap_write(map, 0x34, sel);
+	if (!ret)
+		ret = regmap_write(map, 4, BIT(8));
+	return ret;
+}
+
+/* CKGEN_CK2 source IDs from this board's clk-fmeter nodes. */
+static void measure_camera_clock(struct device *dev, struct regmap *map, u32 id)
+{
+	u32 misc, dbg, ctl, count, state;
+
+	if (regmap_read(map, 0xf0, &ctl) || (ctl & BIT(4)) ||
+	    regmap_read(map, 0x104, &misc) || regmap_read(map, 0x124, &dbg))
+		return;
+	regmap_write(map, 0xf0, ctl & ~BIT(15));
+	regmap_write(map, 0xf0, ctl | BIT(15));
+	regmap_write(map, 0x124, (dbg & 0xffff80fc) | (id << 8) | 1);
+	regmap_write(map, 0x104, (misc & 0x00ffffff) | (3 << 24));
+	regmap_write(map, 0xf0, 0x9000);
+	regmap_write(map, 0xf0, 0x9010);
+	if (!regmap_read_poll_timeout(map, 0xf0, state, !(state & BIT(4)), 10, 10000) &&
+	    !regmap_read(map, 0xf4, &count))
+		dev_info(dev, "clock meter %u: %u kHz\n", id, (count & 65535) * 26000 / 1024 * 4);
+	regmap_write(map, 0xf0, ctl);
+	regmap_write(map, 0x104, misc);
+	regmap_write(map, 0x124, dbg);
+}
+
+int turner_check_receiver_clocks(struct device *dev, struct v4l2_subdev *sensor, struct turner_stream *stream)
+{
+	struct device_node *node;
+	struct regmap *maps[4];
+	u32 owned[ARRAY_SIZE(gates)] = {}, cfg;
+	unsigned int i;
+	int ret;
+
+	const struct gate *sequence[ARRAY_SIZE(gates)];
+	bool front = sensor && of_property_match_string(sensor->dev->of_node,
+				"sensor-names", "turnerov08f10front_mipi_raw") >= 0;
+
+	for (i = 0; i < ARRAY_SIZE(gates); i++)
+		sequence[i] = front && !strcmp(gates[i].name, "seninf2") ? &seninf0 : &gates[i];
+	node = of_find_compatible_node(NULL, NULL, "mediatek,mt6991-cksys_gp2");
+	if (!node)
+		return -ENODEV;
+	maps[TOP] = syscon_node_to_regmap(node);
+	maps[HWV] = syscon_regmap_lookup_by_phandle(node, "mm-hw-ccf-regmap");
+	of_node_put(node);
+	maps[VCORE] = syscon_regmap_lookup_by_compatible("mediatek,mt6991-cam_vcore_r1a");
+	maps[MAIN] = syscon_regmap_lookup_by_compatible("mediatek,mt6991-cam_main_r1a");
+	for (i = 0; i < ARRAY_SIZE(maps); i++)
+		if (IS_ERR(maps[i]))
+			return PTR_ERR(maps[i]);
+	ret = regmap_read(maps[TOP], 0x30, &cfg);
+	if (ret || !(cfg & BIT(7)))
+		return ret ?: -EBUSY;
+	ret = read_vmm_uv();
+	dev_info(dev, "CAM VMM selector %d uV (312 MHz OPP requires 575000 uV)\n", ret);
+	if (ret < 575000 || ret > 1193750)
+		return ret < 0 ? ret : -ERANGE;
+	ret = set_cam_parent(maps[TOP], 6);
+	if (ret) {
+		set_cam_parent(maps[TOP], cfg & 15);
+		return ret;
+	}
+	for (i = 0; i < ARRAY_SIZE(gates); i++) {
+		ret = apply_gate(maps, sequence[i], &owned[i]);
+		if (ret) {
+			dev_err(dev, "%s clock enable: %d\n", gates[i].name, ret);
+			i++;
+			goto unwind;
+		}
+	}
+	ret = read_camsv(dev);
+	if (!ret && !front)
+		ret = check_csi_mac(dev);
+	if (!ret && sensor) {
+		u32 vc;
+		measure_camera_clock(dev, maps[TOP], 3);
+		measure_camera_clock(dev, maps[TOP], 9);
+		if (front && !stream) {
+			ret = turner_front_packets(dev, sensor);
+			goto unwind;
+		}
+		ret = regmap_read(maps[MAIN], 0x594, &vc);
+		if (!ret) {
+			ret = regmap_write(maps[MAIN], 0x594, 0x37);
+			if (!ret)
+				ret = turner_sample_packets(dev, sensor, stream, front);
+			{
+				int err = regmap_write(maps[MAIN], 0x594, vc);
+
+				if (!ret)
+					ret = err;
+			}
+		}
+	}
+unwind:
+	while (i) {
+		int err;
+
+		i--;
+		err = release_gate(maps, sequence[i], owned[i]);
+		if (err) {
+			dev_err(dev, "%s clock release: %d\n", gates[i].name, err);
+			if (!ret)
+				ret = err;
+		}
+	}
+	{
+		int err = set_cam_parent(maps[TOP], cfg & 15);
+		if (!ret)
+			ret = err;
+	}
+	return ret;
+}
