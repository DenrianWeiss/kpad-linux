diff --git a/drivers/media/platform/mediatek/turner/front/live-camtg0.h b/drivers/media/platform/mediatek/turner/front/live-camtg0.h
new file mode 100644
index 0000000..7b26257
--- /dev/null
+++ b/drivers/media/platform/mediatek/turner/front/live-camtg0.h
@@ -0,0 +1,76 @@
+#include "clk-mtk.h"
+#include "clk-mux.h"
+
+static const char * const tg0_parents[] = {
+	"clk26m", "univpll_192m_d32", "univpll_192m_d16", "clk26m_d2",
+	"osc_d40", "osc_d32", "univpll_192m_d10", "turner_front_24m",
+	"univpll_d6_d16", "osc_d20", "tvdpll1_d16", "univpll_d6_d8",
+};
+static const struct mtk_mux tg0[] = {
+	MUX_GATE_HWV_FENC_CLR_SET_UPD(0, "turner_camtg0", tg0_parents,
+		0x50, 0x54, 0x58, 0x2c24, 0x48, 0x4c,
+		0, 4, 7, 0x4, 16, 0x39c, 15),
+};
+static DEFINE_SPINLOCK(tg0_lock);
+
+static void unregister_tg0(void *data)
+{
+	mtk_clk_unregister_muxes(tg0, ARRAY_SIZE(tg0), data);
+}
+
+static struct clk *live_camtg0(struct device *dev)
+{
+	struct of_phandle_args spec;
+	struct of_changeset cs;
+	struct clk_hw_onecell_data *data;
+	struct clk_hw *factor;
+	struct clk *parent, *mclk;
+	u32 voter;
+	int ret;
+
+	ret = of_parse_phandle_with_args(dev->of_node, "clocks", "#clock-cells", 8, &spec);
+	if (ret)
+		return ERR_PTR(ret);
+	if (spec.args_count != 1 || spec.args[0] != 18 ||
+	    !of_device_is_compatible(spec.np, "mediatek,mt6991-vlp_cksys")) {
+		ret = -EINVAL;
+		goto put;
+	}
+	ret = of_property_read_u32(spec.np, "hw-voter-regmap", &voter);
+	if (ret)
+		goto put;
+	data = mtk_devm_alloc_clk_data(dev, 1);
+	if (!data) {
+		ret = -ENOMEM;
+		goto put;
+	}
+	factor = devm_clk_hw_register_fixed_factor(dev, "turner_front_24m",
+		"univpll_192m", 0, 1, 8);
+	if (IS_ERR(factor)) {
+		ret = PTR_ERR(factor);
+		goto put;
+	}
+	of_changeset_init(&cs);
+	ret = of_changeset_add_prop_u32(&cs, spec.np, "mediatek,hardware-voter", voter);
+	if (!ret)
+		ret = of_changeset_apply(&cs);
+	if (!ret) {
+		ret = mtk_clk_register_muxes(dev, tg0, ARRAY_SIZE(tg0), spec.np, &tg0_lock, data);
+		of_changeset_revert(&cs);
+	}
+	of_changeset_destroy(&cs);
+	if (ret)
+		goto put;
+	ret = devm_add_action_or_reset(dev, unregister_tg0, data);
+	if (ret)
+		goto put;
+	mclk = devm_clk_hw_get_clk(dev, data->hws[0], NULL);
+	parent = devm_clk_hw_get_clk(dev, factor, NULL);
+	if (IS_ERR(mclk) || IS_ERR(parent))
+		ret = IS_ERR(mclk) ? PTR_ERR(mclk) : PTR_ERR(parent);
+	else
+		ret = clk_set_parent(mclk, parent);
+put:
+	of_node_put(spec.np);
+	return ret ? ERR_PTR(ret) : mclk;
+}
diff --git a/drivers/media/platform/mediatek/turner/front/turner-ov08f10.c b/drivers/media/platform/mediatek/turner/front/turner-ov08f10.c
