Subject: [PATCH] regulator: mt6373: expose Turner camera rails

--- a/drivers/regulator/mt6373-regulator.c
+++ b/drivers/regulator/mt6373-regulator.c
@@ -68,6 +68,36 @@
 	.enable_mask = BIT(0),
 };
 
+static const struct regulator_ops mt6373_camera_ops = {
+	.enable = regulator_enable_regmap,
+	.disable = regulator_disable_regmap,
+	.is_enabled = regulator_is_enabled_regmap,
+	.list_voltage = regulator_list_voltage_linear,
+	.map_voltage = regulator_map_voltage_linear,
+	.get_voltage_sel = regulator_get_voltage_sel_regmap,
+	.set_voltage_sel = regulator_set_voltage_sel_regmap,
+};
+
+static const struct regulator_desc mt6373_camera_rails[] = {
+	{
+		.name = "VBUCK8", .of_match = "VBUCK8",
+		.regulators_node = "regulators",
+		.type = REGULATOR_VOLTAGE, .owner = THIS_MODULE,
+		.ops = &mt6373_camera_ops,
+		.min_uV = 0, .uV_step = 12500, .n_voltages = 129,
+		.enable_reg = 0x243, .enable_mask = BIT(0),
+		.vsel_reg = 0x254, .vsel_mask = 0xff,
+	}, {
+		.name = "VRFIO18_AIF", .of_match = "VRFIO18_AIF",
+		.regulators_node = "regulators",
+		.type = REGULATOR_VOLTAGE, .owner = THIS_MODULE,
+		.ops = &mt6373_camera_ops,
+		.min_uV = 600000, .uV_step = 100000, .n_voltages = 16,
+		.enable_reg = 0x1bcd, .enable_mask = BIT(0),
+		.vsel_reg = 0x1e95, .vsel_mask = 0x0f,
+	},
+};
+
 static int mt6373_regulator_probe(struct platform_device *pdev)
 {
 	struct regulator_config config = { .dev = pdev->dev.parent };
@@ -77,7 +107,14 @@
 	if (!config.regmap)
 		return -ENODEV;
 	rdev = devm_regulator_register(&pdev->dev, &mt6373_vcn18io, &config);
-	return PTR_ERR_OR_ZERO(rdev);
+	if (IS_ERR(rdev))
+		return PTR_ERR(rdev);
+	for (unsigned int i = 0; i < ARRAY_SIZE(mt6373_camera_rails); i++) {
+		rdev = devm_regulator_register(&pdev->dev, &mt6373_camera_rails[i], &config);
+		if (IS_ERR(rdev))
+			return PTR_ERR(rdev);
+	}
+	return 0;
 }
 
 static struct platform_driver mt6373_regulator_driver = {
