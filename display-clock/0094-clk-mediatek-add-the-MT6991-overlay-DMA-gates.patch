+	GATE_HWV_OVL0(MT6991_CLK_OVL0_EXDMA5, "ovl_exdma5", "disp", 9),
+	GATE_HWV_OVL0(MT6991_CLK_OVL0_EXDMA6, "ovl_exdma6", "disp", 10),
+	GATE_HWV_OVL0(MT6991_CLK_OVL0_EXDMA7, "ovl_exdma7", "disp", 11),
+	GATE_HWV_OVL0(MT6991_CLK_OVL0_EXDMA8, "ovl_exdma8", "disp", 12),
+	GATE_HWV_OVL0(MT6991_CLK_OVL0_EXDMA9, "ovl_exdma9", "disp", 13),
 };
 
 static const struct mtk_clk_desc mt6991_ovl0_desc = {
diff --git a/drivers/clk/mediatek/clk-mt8196-ovl1.c b/drivers/clk/mediatek/clk-mt8196-ovl1.c
