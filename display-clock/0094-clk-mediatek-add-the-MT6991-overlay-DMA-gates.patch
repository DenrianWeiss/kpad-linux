+++ b/drivers/clk/mediatek/clk-mt8196-ovl0.c
@@ -137,6 +137,16 @@ static const struct mtk_clk_desc ovl_mcd = {
 
 static const struct mtk_gate mt6991_ovl0_clks[] = {
 	GATE_HWV_OVL0(MT6991_CLK_OVL0_MUTEX, "ovl_mutex0", "disp", 3),
+	GATE_HWV_OVL0(MT6991_CLK_OVL0_EXDMA0, "ovl_exdma0", "disp", 4),
+	GATE_HWV_OVL0(MT6991_CLK_OVL0_EXDMA1, "ovl_exdma1", "disp", 5),
