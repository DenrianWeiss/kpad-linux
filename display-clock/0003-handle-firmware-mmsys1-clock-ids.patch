--- a/drivers/clk/mediatek/clk-mt8196-disp1.c
+++ b/drivers/clk/mediatek/clk-mt8196-disp1.c
@@ -9,6 +9,7 @@
 #include <dt-bindings/clock/mediatek,mt8196-clock.h>
 
 #include <linux/clk-provider.h>
+#include <linux/of.h>
 #include <linux/module.h>
 #include <linux/of_device.h>
 #include <linux/platform_device.h>
@@ -158,7 +159,37 @@
 	GATE_HWV_MM11(MT6991_CLK_MM1_DSI1_DIGITAL, "mm1_dsi1_digital", "clk26m", 14),
 };
 
+/* Firmware assigns adjacent IDs to each gate and its display-client alias. */
+static struct clk_hw *mt6991_mm1_get(struct of_phandle_args *spec, void *data)
+{
+	struct clk_hw_onecell_data *clks = data;
+	unsigned int id;
+
+	if (of_property_present(spec->np, "mediatek,hardware-voter"))
+		return of_clk_hw_onecell_get(spec, data);
+	if (spec->args_count != 1)
+		return ERR_PTR(-EINVAL);
+	switch (spec->args[0] & ~1U) {
+	case 4:
+		id = MT6991_CLK_MM1_MUTEX;
+		break;
+	case 36: case 38: case 40: case 42:
+		id = MT6991_CLK_MM1_DSC_WRAP0 + (spec->args[0] - 36) / 2;
+		break;
+	case 44: case 46:
+		id = MT6991_CLK_MM1_DSI0_ENGINE + (spec->args[0] - 44) / 2;
+		break;
+	case 90: case 92:
+		id = MT6991_CLK_MM1_DSI0_DIGITAL + (spec->args[0] - 90) / 2;
+		break;
+	default:
+		return ERR_PTR(-ENOENT);
+	}
+	return clks->hws[id];
+}
+
 static const struct mtk_clk_desc mt6991_mm1_desc = {
+	.need_runtime_pm = true,
 	.clks = mt6991_mm1_clks,
 	.num_clks = ARRAY_SIZE(mt6991_mm1_clks),
 };
@@ -175,8 +206,25 @@
 };
 MODULE_DEVICE_TABLE(platform, clk_mt8196_disp1_id_table);
 
+static int clk_disp1_probe(struct platform_device *pdev)
+{
+	struct device *parent = pdev->dev.parent;
+
+	if (!of_device_is_compatible(parent->of_node, "mediatek,mt6991-mmsys1"))
+		return mtk_clk_pdev_probe(pdev);
+
+	/* Local gate status registers live in DIS1. Firmware DTs may
+	 * describe the voter alone, without attaching the power domain.
+	 */
+	if (of_property_present(parent->of_node, "mm-hw-ccf-regmap") &&
+	    !parent->pm_domain)
+		return dev_err_probe(&pdev->dev, -EPROBE_DEFER,
+				     "waiting for DIS1 power domain\n");
+	return mtk_clk_pdev_probe_with_get(pdev, mt6991_mm1_get);
+}
+
 static struct platform_driver clk_mt8196_disp1_drv = {
-	.probe = mtk_clk_pdev_probe,
+	.probe = clk_disp1_probe,
 	.remove = mtk_clk_pdev_remove,
 	.driver = {
 		.name = "clk-mt8196-disp1",
