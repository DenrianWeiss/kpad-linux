Subject: [RFC PATCH] wifi: mt76: download and start MT6653 WM RAM firmware

Check the v2 trailer and region bounds before the first ROM command.
Reuse the Connac RAM loader with the 2048-byte MT6653 FWDL payload limit.

diff --git a/drivers/net/wireless/mediatek/mt76/Kconfig b/drivers/net/wireless/mediatek/mt76/Kconfig
index 2ca96e0..1df1c69 100644
--- a/drivers/net/wireless/mediatek/mt76/Kconfig
+++ b/drivers/net/wireless/mediatek/mt76/Kconfig
@@ -27,6 +27,7 @@ config MT76x02_USB
 
 config MT76_CONNAC_LIB
 	tristate
+	select CRC32
 	select MT76_CORE
 
 config MT792x_LIB
diff --git a/drivers/net/wireless/mediatek/mt76/mt6653_rom.c b/drivers/net/wireless/mediatek/mt76/mt6653_rom.c
index 66196cc..7a5ef8a 100644
--- a/drivers/net/wireless/mediatek/mt76/mt6653_rom.c
+++ b/drivers/net/wireless/mediatek/mt76/mt6653_rom.c
@@ -79,7 +79,9 @@ static int mt6653_rom_send(struct mt76_dev *dev, struct sk_buff *skb,
 
 	if (cmd == MCU_CMD(FW_SCATTER)) {
 		q = MT_MCUQ_FWDL;
-	} else if (cmd == MCU_CMD(PATCH_START_REQ) ||
+	} else if (cmd == MCU_CMD(TARGET_ADDRESS_LEN_REQ) ||
+		   cmd == MCU_CMD(FW_START_REQ) ||
+		   cmd == MCU_CMD(PATCH_START_REQ) ||
 		   cmd == MCU_CMD(PATCH_FINISH_REQ)) {
 		u8 id = ++dev->mcu.msg_seq;
 
diff --git a/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.c b/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.c
index b5d3a95..61be3c0 100644
--- a/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.c
+++ b/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: BSD-3-Clause-Clear
 /* Copyright (C) 2020 MediaTek Inc. */
 
+#include <linux/crc32.h>
 #include <linux/firmware.h>
 #include "mt76_connac2_mac.h"
 #include "mt76_connac_mcu.h"
@@ -72,7 +73,9 @@ int mt76_connac_mcu_init_download(struct mt76_dev *dev, u32 addr, u32 len,
 {
 	int cmd;
 
-	if ((!is_connac_v1(dev) && addr == MCU_PATCH_ADDRESS) ||
+	if (mt76_chip(dev) == 0x6653)
+		cmd = MCU_CMD(TARGET_ADDRESS_LEN_REQ);
+	else if ((!is_connac_v1(dev) && addr == MCU_PATCH_ADDRESS) ||
 	    (is_connac2(dev) && addr == 0x900000) ||
 	    ((is_mt7925(dev) || is_mt7927(dev)) && (addr == 0x900000 || addr == 0xe0002800)) ||
 	    (is_mt7928(dev) && (addr == 0x900000 || addr == 0xe0002000)) ||
@@ -3060,9 +3063,9 @@ EXPORT_SYMBOL_GPL(mt76_connac_get_rate_power_limit);
 static int
 mt76_connac_mcu_send_ram_firmware(struct mt76_dev *dev,
 				  const struct mt76_connac2_fw_trailer *hdr,
-				  const u8 *data, bool is_wa)
+				  const u8 *data, bool is_wa, int max_len)
 {
-	int i, offset = 0, max_len = mt76_is_sdio(dev) ? 2048 : 4096;
+	int i, offset = 0;
 	u32 override = 0, option = 0;
 
 	for (i = 0; i < hdr->n_region; i++) {
@@ -3108,6 +3111,44 @@ next:
 	return mt76_connac_mcu_start_firmware(dev, override, option);
 }
 
+/* The MT6653 WM loader accepts the uncompressed Connac v2 image. */
+int mt6653_rom_load_wm(struct mt76_dev *dev, const struct firmware *fw)
+{
+	const struct mt76_connac2_fw_trailer *hdr;
+	const struct mt76_connac2_fw_region *regions;
+	size_t payload;
+	int i;
+
+	if (!fw || !fw->data || fw->size < sizeof(*hdr) || fw->size > INT_MAX)
+		return -EINVAL;
+
+	payload = fw->size - sizeof(*hdr);
+	hdr = (const void *)(fw->data + payload);
+	if (hdr->format_ver != 2 || hdr->chip_id != 0x19 || !hdr->n_region ||
+	    hdr->n_region > payload / sizeof(*regions))
+		return -EINVAL;
+	if ((crc32_le(~0U, fw->data, fw->size - sizeof(hdr->crc)) ^ ~0U) !=
+	    le32_to_cpu(hdr->crc))
+		return -EBADMSG;
+
+	payload -= hdr->n_region * sizeof(*regions);
+	regions = (const void *)(fw->data + payload);
+	for (i = 0; i < hdr->n_region; i++) {
+		const struct mt76_connac2_fw_region *r = &regions[i];
+		u32 len = le32_to_cpu(r->len), addr = le32_to_cpu(r->addr);
+
+		if (!len || len > payload || len - 1 > U32_MAX - addr)
+			return -EINVAL;
+		if (r->decomp_blk_sz || r->decomp_len || r->type ||
+		    r->feature_set & ~(FW_FEATURE_SET_ENCRYPT | FW_FEATURE_OVERRIDE_ADDR))
+			return -EOPNOTSUPP;
+		payload -= len;
+	}
+
+	return mt76_connac_mcu_send_ram_firmware(dev, hdr, fw->data, false, 2048);
+}
+EXPORT_SYMBOL_GPL(mt6653_rom_load_wm);
+
 static int
 mt76_connac_mcu_send_phy_ram_firmware(struct mt76_dev *dev,
 				      const struct mt76_connac2_fw_trailer *hdr,
@@ -3180,7 +3221,8 @@ int mt76_connac2_load_ram(struct mt76_dev *dev, const char *fw_wm,
 	dev_info(dev->dev, "WM Firmware Version: %.10s, Build Time: %.15s",
 		 hdr->fw_ver, hdr->build_date);
 
-	ret = mt76_connac_mcu_send_ram_firmware(dev, hdr, fw->data, false);
+	ret = mt76_connac_mcu_send_ram_firmware(dev, hdr, fw->data, false,
+					      mt76_is_sdio(dev) ? 2048 : 4096);
 	if (ret) {
 		dev_err(dev->dev, "Failed to start WM firmware\n");
 		goto out;
@@ -3209,7 +3251,8 @@ int mt76_connac2_load_ram(struct mt76_dev *dev, const char *fw_wm,
 	dev_info(dev->dev, "WA Firmware Version: %.10s, Build Time: %.15s",
 		 hdr->fw_ver, hdr->build_date);
 
-	ret = mt76_connac_mcu_send_ram_firmware(dev, hdr, fw->data, true);
+	ret = mt76_connac_mcu_send_ram_firmware(dev, hdr, fw->data, true,
+					      mt76_is_sdio(dev) ? 2048 : 4096);
 	if (ret) {
 		dev_err(dev->dev, "Failed to start WA firmware\n");
 		goto out;
diff --git a/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.h b/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.h
index 161e55a..5817cee 100644
--- a/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.h
+++ b/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.h
@@ -2154,6 +2154,7 @@ int mt6653_rom_alloc_tx_queue(struct mt76_dev *dev, enum mt76_mcuq_id qid);
 int mt6653_rom_alloc_rx_queue(struct mt76_dev *dev);
 void mt6653_rom_rx_skb(struct mt76_dev *dev, enum mt76_rxq_id qid,
 		       struct sk_buff *skb, u32 *info);
+int mt6653_rom_load_wm(struct mt76_dev *dev, const struct firmware *fw);
 extern const struct mt76_mcu_ops mt6653_rom_ops;
 int mt76_connac_mcu_send_mt6653_patch(struct mt76_dev *dev,
 				      const struct firmware *fw);
