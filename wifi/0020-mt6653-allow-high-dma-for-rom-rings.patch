Subject: [PATCH] wifi: mt76: allow 36-bit DMA for MT6653 ROM ring allocations

--- a/drivers/net/wireless/mediatek/mt76/mt6653_pci.c
+++ b/drivers/net/wireless/mediatek/mt76/mt6653_pci.c
@@ -111,5 +111,11 @@
 		return ret;
 	pci_set_master(pdev);
-	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	/* ROM ring base registers carry 36 address bits. The current packet
+	 * descriptors still use 32-bit streaming addresses.
+	 */
+	ret = dma_set_mask(&pdev->dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	ret = dma_set_coherent_mask(&pdev->dev, DMA_BIT_MASK(36));
 	if (ret)
 		return ret;
