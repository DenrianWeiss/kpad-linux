From 4e9411bc16d9653f00ef01ab303f98f47070d44e Mon Sep 17 00:00:00 2001
From: Turner Linux Port <turner@localhost>
Date: Sun, 22 Nov 2026 04:55:24 +0800
Subject: [PATCH] dt-bindings: power: describe MediaTek MT6376 connectivity
 supply

---
 .../bindings/power/mediatek,mt6376.yaml       | 52 +++++++++++++++++++
 1 file changed, 52 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/mediatek,mt6376.yaml

diff --git a/Documentation/devicetree/bindings/power/mediatek,mt6376.yaml b/Documentation/devicetree/bindings/power/mediatek,mt6376.yaml
new file mode 100644
index 0000000..c8ed203
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/mediatek,mt6376.yaml
@@ -0,0 +1,52 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/mediatek,mt6376.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6376 connectivity power controller
+
+maintainers:
+  - Turner Linux Port <turner@localhost>
+
+description:
+  The MT6376 provides shared power for the connectivity subsystem.
+  An enable input controls power and an active-low fault output signals
+  a failure while the subsystem is powered.
+
+properties:
+  compatible:
+    const: mediatek,mt6376
+
+  '#power-domain-cells':
+    const: 0
+
+  enable-gpios:
+    maxItems: 1
+    description: Active-high PMIC enable.
+
+  fault-gpios:
+    maxItems: 1
+    description: Active-low FAULTB signal, capable of generating an interrupt.
+
+  pinctrl-names:
+    items:
+      - const: fault-idle
+      - const: fault-active
+
+  pinctrl-0:
+    description: FAULTB input with pull-down while powered off.
+
+  pinctrl-1:
+    description: FAULTB input with pull-up while powered on.
+
+required:
+  - compatible
+  - '#power-domain-cells'
+  - enable-gpios
+  - fault-gpios
+  - pinctrl-names
+  - pinctrl-0
+  - pinctrl-1
+
+additionalProperties: false
-- 
