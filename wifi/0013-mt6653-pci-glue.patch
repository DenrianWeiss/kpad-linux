Subject: [RFC PATCH] wifi: mt76: bind the MT6653 PCIe device and boot its ROM firmware

The ROM transport, RAM boot and NVRAM submission exist but nothing binds the
device: the vendor module advertises pci 14c3:6653. Add the device id table,
a minimal PCI probe that maps BAR0, attaches the mt76 MMIO/DMA layer,
allocates the ROM queues and runs mt6653_pci_boot_ram(), and the shared
declarations for the ROM helpers. mac80211 registration is the next step.

--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt6653.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+#ifndef __MT6653_H
+#define __MT6653_H
+
+#include "mt76.h"
+
+#define MT6653_PCI_DEVICE_ID	0x6653
+
+struct mt6653_dev {
+	struct mt76_dev mt76;
+};
+
+extern const struct mt76_mcu_ops mt6653_rom_ops;
+
+int mt6653_rom_alloc_tx_queue(struct mt76_dev *dev, enum mt76_mcuq_id qid);
+int mt6653_rom_alloc_rx_queue(struct mt76_dev *dev);
+int mt6653_rom_boot_ram(struct mt76_dev *dev);
+int mt6653_pci_boot_ram(struct mt76_dev *dev);
+
+#endif
--- /dev/null
+++ b/drivers/net/wireless/mediatek/mt76/mt6653_pci.c
@@ -0,0 +1,95 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/* MT6653 PCIe glue: bind the device and bring up the ROM MCU transport. */
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/dma-mapping.h>
+
+#include "mt76.h"
+#include "dma.h"
+#include "mt6653.h"
+
+static const struct pci_device_id mt6653_pci_device_table[] = {
+	{ PCI_DEVICE(PCI_VENDOR_ID_MEDIATEK, MT6653_PCI_DEVICE_ID) },
+	{ },
+};
+MODULE_DEVICE_TABLE(pci, mt6653_pci_device_table);
+
+static void mt6653_pci_remove(struct pci_dev *pdev)
+{
+	struct mt6653_dev *dev = pci_get_drvdata(pdev);
+
+	mt76_free_device(&dev->mt76);
+}
+
+static int mt6653_pci_probe(struct pci_dev *pdev,
+			    const struct pci_device_id *id)
+{
+	/* Empty ops until the mac80211 registration milestone. */
+	static struct ieee80211_ops mt6653_ops;
+	static const struct mt76_driver_ops drv_ops;
+	struct mt6653_dev *dev;
+	struct mt76_dev *mdev;
+	void __iomem *regs;
+	int ret;
+
+	ret = pcim_enable_device(pdev);
+	if (ret)
+		return ret;
+	pci_set_master(pdev);
+	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	mdev = mt76_alloc_device(&pdev->dev, sizeof(*dev), &mt6653_ops,
+				 &drv_ops);
+	if (!mdev)
+		return -ENOMEM;
+	dev = container_of(mdev, struct mt6653_dev, mt76);
+	pci_set_drvdata(pdev, dev);
+
+	regs = pcim_iomap_region(pdev, 0, pci_name(pdev));
+	if (IS_ERR(regs))
+		return PTR_ERR(regs);
+
+	mt76_mmio_init(mdev, regs);
+	mt76_dma_attach(mdev);
+	mdev->mcu_ops = &mt6653_rom_ops;
+
+	ret = mt6653_rom_alloc_tx_queue(mdev, MT_MCUQ_FWDL);
+	if (!ret)
+		ret = mt6653_rom_alloc_tx_queue(mdev, MT_MCUQ_WM);
+	if (!ret)
+		ret = mt6653_rom_alloc_rx_queue(mdev);
+	if (ret) {
+		dev_err(&pdev->dev, "ROM ring setup failed: %d\n", ret);
+		goto out_free;
+	}
+
+	/* The ROM transport is the only MCU path available before the WM
+	 * firmware signals readiness through the PCIe config space.
+	 */
+	ret = mt6653_pci_boot_ram(mdev);
+	dev_info(&pdev->dev, "ROM boot ret=%d mcu_running=%d\n", ret,
+		 test_bit(MT76_STATE_MCU_RUNNING, &mdev->phy.state));
+	if (ret)
+		goto out_free;
+
+	return 0;
+
+out_free:
+	mt76_free_device(mdev);
+	return ret;
+}
+
+static struct pci_driver mt6653_pci_driver = {
+	.name		= "mt6653",
+	.id_table	= mt6653_pci_device_table,
+	.probe		= mt6653_pci_probe,
+	.remove		= mt6653_pci_remove,
+};
+module_pci_driver(mt6653_pci_driver);
+
+MODULE_FIRMWARE("mediatek/mt6653/WIFI_MT6653_PHY_RAM_CODE_1_1.bin");
+MODULE_FIRMWARE("mediatek/mt6653/WIFI_RAM_CODE_MT6653_1_1.bin");
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("MediaTek MT6653 PCIe ROM bring-up");
--- a/drivers/net/wireless/mediatek/mt76/Makefile
+++ b/drivers/net/wireless/mediatek/mt76/Makefile
@@ -37,6 +37,8 @@
 
 mt76-connac-lib-y := mt76_connac_mcu.o mt76_connac_mac.o mt76_connac3_mac.o
 mt76-connac-lib-$(CONFIG_PCI) += mt6653_rom.o mt6653_mcu.o
+obj-$(CONFIG_MT6653) += mt6653.o
+mt6653-y := mt6653_pci.o
 
 mt792x-lib-y := mt792x_core.o mt792x_mac.o mt792x_trace.o \
 		mt792x_debugfs.o mt792x_dma.o
--- a/drivers/net/wireless/mediatek/mt76/Kconfig
+++ b/drivers/net/wireless/mediatek/mt76/Kconfig
@@ -25,6 +25,13 @@
 	tristate
 	select MT76_USB
 
+config MT6653
+	tristate "MediaTek MT6653 PCIe (ROM bring-up)"
+	depends on PCI
+	help
+	  This binds the MT6653 PCIe device and boots its ROM firmware.
+	  The mac80211 interface is not registered yet.
+
 config MT76_CONNAC_LIB
 	tristate
 	select CRC32
