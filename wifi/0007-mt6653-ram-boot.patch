Subject: [RFC PATCH] wifi: mt76: sequence MT6653 PHY and WM firmware startup

Request both Turner firmware images before touching either processor.
Use the post-patch ROM queues to boot PHY before WM and propagate errors.

diff --git a/drivers/net/wireless/mediatek/mt76/mt6653_rom.c b/drivers/net/wireless/mediatek/mt76/mt6653_rom.c
index 7a5ef8a..acac286 100644
--- a/drivers/net/wireless/mediatek/mt76/mt6653_rom.c
+++ b/drivers/net/wireless/mediatek/mt76/mt6653_rom.c
@@ -1,4 +1,6 @@
 // SPDX-License-Identifier: BSD-3-Clause-Clear
+#include <linux/firmware.h>
+#include <linux/module.h>
 #include "mt76_connac_mcu.h"
 #include "mt76_connac3_mac.h"
 
@@ -143,3 +145,35 @@ const struct mt76_mcu_ops mt6653_rom_ops = {
 	.mcu_parse_response = mt6653_rom_response,
 };
 EXPORT_SYMBOL_GPL(mt6653_rom_ops);
+
+#define MT6653_PHY_FIRMWARE "mediatek/mt6653/WIFI_MT6653_PHY_RAM_CODE_1_1.bin"
+#define MT6653_WM_FIRMWARE  "mediatek/mt6653/WIFI_RAM_CODE_MT6653_1_1.bin"
+
+/* Called with the ROM queues running after the PCIe post-patch transition. */
+int mt6653_rom_boot_ram(struct mt76_dev *dev)
+{
+	const struct firmware *phy, *wm;
+	int ret;
+
+	ret = request_firmware(&phy, MT6653_PHY_FIRMWARE, dev->dev);
+	if (ret)
+		return ret;
+
+	ret = request_firmware(&wm, MT6653_WM_FIRMWARE, dev->dev);
+	if (ret)
+		goto release_phy;
+
+	ret = mt6653_rom_load_phy(dev, phy);
+	if (!ret)
+		ret = mt6653_rom_load_wm(dev, wm);
+
+	release_firmware(wm);
+release_phy:
+	release_firmware(phy);
+
+	return ret;
+}
+EXPORT_SYMBOL_GPL(mt6653_rom_boot_ram);
+
+MODULE_FIRMWARE(MT6653_PHY_FIRMWARE);
+MODULE_FIRMWARE(MT6653_WM_FIRMWARE);
diff --git a/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.h b/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.h
index 1c844a7..d3b2cff 100644
--- a/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.h
+++ b/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.h
@@ -2155,6 +2155,7 @@ int mt6653_rom_alloc_rx_queue(struct mt76_dev *dev);
 void mt6653_rom_rx_skb(struct mt76_dev *dev, enum mt76_rxq_id qid,
 		       struct sk_buff *skb, u32 *info);
 int mt6653_rom_load_wm(struct mt76_dev *dev, const struct firmware *fw);
+int mt6653_rom_boot_ram(struct mt76_dev *dev);
 int mt6653_rom_load_phy(struct mt76_dev *dev, const struct firmware *fw);
 extern const struct mt76_mcu_ops mt6653_rom_ops;
 int mt76_connac_mcu_send_mt6653_patch(struct mt76_dev *dev,
