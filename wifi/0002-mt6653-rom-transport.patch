+++ b/drivers/net/wireless/mediatek/mt76/mt76_connac_mcu.h
@@ -2150,6 +2150,7 @@ int mt76_connac_mcu_sta_wed_update(struct mt76_dev *dev, struct sk_buff *skb);
 int mt76_connac2_load_ram(struct mt76_dev *dev, const char *fw_wm,
 			  const char *fw_wa);
 int mt76_connac3_load_phy_ram(struct mt76_dev *dev, const char *fw_name);
+extern const struct mt76_mcu_ops mt6653_rom_ops;
 int mt76_connac_mcu_send_mt6653_patch(struct mt76_dev *dev,
 				      const struct firmware *fw);
 int mt76_connac2_load_patch(struct mt76_dev *dev, const char *fw_name);
