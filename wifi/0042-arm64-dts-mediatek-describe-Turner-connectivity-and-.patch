From 5e6107897fd4578659e680fae2d79fb0af447d90 Mon Sep 17 00:00:00 2001
From: Turner Linux Port <turner@localhost>
Date: Sun, 22 Nov 2026 04:50:54 +0800
Subject: [PATCH] arm64: dts: mediatek: describe Turner connectivity and PTA
 pins

Describe the three shared connectivity states and the active and inactive WLAN coexistence states. Disconnect the output drivers in GPIO input states, including the PTA TX pin that was driven low while active. These groups are selected by the radio power sequence and are not pinctrl hogs.
---
 .../dts/mediatek/mt6991-xiaomi-turner.dts     | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6991-xiaomi-turner.dts b/arch/arm64/boot/dts/mediatek/mt6991-xiaomi-turner.dts
index 50325f2..49668a6 100644
--- a/arch/arm64/boot/dts/mediatek/mt6991-xiaomi-turner.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6991-xiaomi-turner.dts
@@ -49,6 +49,31 @@ &pciephy0 {
 };
 
 &pio {
+	conn_sleep_pins: connectivity-sleep-pins {
+		pins {
+			pinmux = <PINMUX_GPIO239__FUNC_GPIO239>,
+				 <PINMUX_GPIO240__FUNC_GPIO240>;
+			output-disable;
+			bias-pull-down;
+		};
+	};
+
+	conn_pre_on_pins: connectivity-pre-on-pins {
+		pins {
+			pinmux = <PINMUX_GPIO239__FUNC_GPIO239>,
+				 <PINMUX_GPIO240__FUNC_GPIO240>;
+			output-disable;
+			bias-pull-up;
+		};
+	};
+
+	conn_uart_pins: connectivity-uart-pins {
+		pins {
+			pinmux = <PINMUX_GPIO239__FUNC_TP_UTXD_CONSYS_VLP>,
+				 <PINMUX_GPIO240__FUNC_TP_URXD_CONSYS_VLP>;
+		};
+	};
+
 	pcie0_reset_pins: pcie0-reset-pins {
 		pins-perst {
 			pinmux = <PINMUX_GPIO241__FUNC_GPIO241>;
@@ -93,6 +118,29 @@ pins {
 		};
 	};
 
+	wlan_pta_sleep_pins: wlan-pta-sleep-pins {
+		pins {
+			pinmux = <PINMUX_GPIO246__FUNC_GPIO246>,
+				 <PINMUX_GPIO247__FUNC_GPIO247>;
+			output-disable;
+			input-enable;
+			bias-pull-down;
+		};
+	};
+
+	wlan_pta_uart_pins: wlan-pta-uart-pins {
+		pins-tx {
+			pinmux = <PINMUX_GPIO246__FUNC_CONN_PTA_TXD0>;
+			output-low;
+		};
+
+		pins-rx {
+			pinmux = <PINMUX_GPIO247__FUNC_CONN_PTA_RXD0>;
+			input-enable;
+			bias-pull-down;
+		};
+	};
+
 	volume_key_pins: volume-key-pins {
 		pins {
 			pinmux = <PINMUX_GPIO60__FUNC_GPIO60>;
-- 
