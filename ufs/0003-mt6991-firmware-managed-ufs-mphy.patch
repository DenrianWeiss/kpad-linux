--- a/drivers/phy/mediatek/phy-mtk-ufs.c
+++ b/drivers/phy/mediatek/phy-mtk-ufs.c
@@ -8,6 +8,7 @@
 #include <linux/delay.h>
 #include <linux/io.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/phy/phy.h>
 #include <linux/platform_device.h>
 
@@ -146,10 +147,19 @@
 	.owner          = THIS_MODULE,
 };
 
+/* MT6991 firmware owns MPHY v1 power sequencing. The downstream driver
+ * omits the legacy PLL and CDR writes for this hardware revision.
+ */
+static const struct phy_ops ufs_mtk_fw_phy_ops = {
+	.owner = THIS_MODULE,
+};
+
 static int ufs_mtk_phy_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
 	struct phy *generic_phy;
+	const struct phy_ops *ops = &ufs_mtk_phy_ops;
+	u32 version;
 	struct phy_provider *phy_provider;
 	struct ufs_mtk_phy *phy;
 	int ret;
@@ -164,11 +174,16 @@
 
 	phy->dev = dev;
 
-	ret = ufs_mtk_phy_clk_init(phy);
-	if (ret)
-		return ret;
-
-	generic_phy = devm_phy_create(dev, NULL, &ufs_mtk_phy_ops);
+	if (!of_property_read_u32(dev->of_node, "mphy-ver", &version) &&
+	    version == 1) {
+		ops = &ufs_mtk_fw_phy_ops;
+	} else {
+		ret = ufs_mtk_phy_clk_init(phy);
+		if (ret)
+			return ret;
+	}
+
+	generic_phy = devm_phy_create(dev, NULL, ops);
 	if (IS_ERR(generic_phy))
 		return PTR_ERR(generic_phy);
 
