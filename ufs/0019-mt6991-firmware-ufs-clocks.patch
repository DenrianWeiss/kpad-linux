+/* The firmware has a gate ID followed by a consumer alias for each clock.
+ * The reset controller is a separate child of this syscon on MT6991.
+ */
+static const struct mtk_clk_desc mt6991_ufsao_mcd = {
+	.clks = ufsao_clks,
+	.num_clks = ARRAY_SIZE(ufsao_clks),
+};
+
+static struct clk_hw *mt6991_ufsao_get(struct of_phandle_args *spec, void *data)
+{
+	struct clk_hw_onecell_data *clks = data;
+	unsigned int id = spec->args[0] / 2;
+
+	if (spec->args_count != 1 || id >= clks->num)
+		return ERR_PTR(-EINVAL);
+	return clks->hws[id];
+}
+
+static int ufsao_probe(struct platform_device *pdev)
+{
+	if (of_device_is_compatible(pdev->dev.of_node, "mediatek,mt6991-ufscfg_ao"))
+		return mtk_clk_simple_probe_with_get(pdev, mt6991_ufsao_get);
+	return mtk_clk_simple_probe(pdev);
+}
+
 static const struct of_device_id of_match_clk_mt8196_ufs_ao[] = {
+	{ .compatible = "mediatek,mt6991-ufscfg_ao", .data = &mt6991_ufsao_mcd },
