+struct ufs_mtk_phy_pm {
+	struct device *dev;
+	bool enabled_here;
+};
+
+/* The runtime reference follows the HBA through suspend/resume. Its PHY
+ * device reference and any PM enable done by this consumer last until
+ * generic probe unwinds or the HBA has finished removal.
+ */
+static void ufs_mtk_put_phy_pm(void *data)
+{
+	struct ufs_mtk_phy_pm *pm = data;
+
+	pm_runtime_put_sync(pm->dev);
+	if (pm->enabled_here)
+		pm_runtime_disable(pm->dev);
+	put_device(pm->dev);
+}
