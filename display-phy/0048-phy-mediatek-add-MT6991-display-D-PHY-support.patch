--- a/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi.c
@@ -157,6 +157,15 @@ static int mtk_mipi_tx_probe(struct platform_device *pdev)
 
 	clk_init.ops = mipi_tx->driver_data->mipi_tx_clk_ops;
 
+	mipi_tx->dev = dev;
+	if (mipi_tx->driver_data->init) {
+		ret = mipi_tx->driver_data->init(mipi_tx);
+		if (ret)
+			return ret;
+	} else {
+		mtk_mipi_tx_get_calibration_datal(mipi_tx);
+	}
+
 	mipi_tx->pll_hw.init = &clk_init;
 	ret = devm_clk_hw_register(dev, &mipi_tx->pll_hw);
 	if (ret)
@@ -172,15 +181,12 @@ static int mtk_mipi_tx_probe(struct platform_device *pdev)
 	if (IS_ERR(phy_provider))
 		return PTR_ERR(phy_provider);
 
-	mipi_tx->dev = dev;
-
-	mtk_mipi_tx_get_calibration_datal(mipi_tx);
-
 	return devm_of_clk_add_hw_provider(dev, of_clk_hw_simple_get, &mipi_tx->pll_hw);
 }
 
 static const struct of_device_id mtk_mipi_tx_match[] = {
 	{ .compatible = "mediatek,mt2701-mipi-tx", .data = &mt2701_mipitx_data },
+	{ .compatible = "mediatek,mt6991-mipi-tx", .data = &mt6991_mipitx_data },
 	{ .compatible = "mediatek,mt8173-mipi-tx", .data = &mt8173_mipitx_data },
 	{ .compatible = "mediatek,mt8183-mipi-tx", .data = &mt8183_mipitx_data },
 	{ .compatible = "mediatek,mt8196-mipi-tx", .data = &mt8196_mipitx_data },
