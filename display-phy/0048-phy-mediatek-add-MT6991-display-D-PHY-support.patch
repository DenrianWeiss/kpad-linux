@@ -16,7 +16,10 @@
 #include <linux/phy/phy.h>
 #include <linux/slab.h>
 
+struct mtk_mipi_tx;
+
 struct mtk_mipitx_data {
+	int (*init)(struct mtk_mipi_tx *tx);
 	const u32 mppll_preserve;
 	const struct clk_ops *mipi_tx_clk_ops;
