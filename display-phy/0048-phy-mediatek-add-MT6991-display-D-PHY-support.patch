 .../phy/mediatek/phy-mtk-mipi-dsi-mt6991.c    | 176 ++++++++++++++++++
 drivers/phy/mediatek/phy-mtk-mipi-dsi.c       |  14 +-
 drivers/phy/mediatek/phy-mtk-mipi-dsi.h       |   5 +
 4 files changed, 192 insertions(+), 4 deletions(-)
 create mode 100644 drivers/phy/mediatek/phy-mtk-mipi-dsi-mt6991.c

