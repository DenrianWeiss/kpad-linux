From 7432677591017683375781afcdc0b6ba83ea592c Mon Sep 17 00:00:00 2001
From: Turner Linux Port <turner@localhost>
Date: Sun, 22 Nov 2026 09:04:09 +0800
Subject: [PATCH] arm64: dts: mediatek: describe the Turner display I2C bus

---
 .../boot/dts/mediatek/mt6991-xiaomi-turner.dts     | 12 ++++++++++++
 arch/arm64/boot/dts/mediatek/mt6991.dtsi           | 14 ++++++++++++++
 2 files changed, 26 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6991-xiaomi-turner.dts b/arch/arm64/boot/dts/mediatek/mt6991-xiaomi-turner.dts
index 1f138ce..c55b217 100644
--- a/arch/arm64/boot/dts/mediatek/mt6991-xiaomi-turner.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6991-xiaomi-turner.dts
@@ -71,7 +71,19 @@ &i2c3 {
 	pinctrl-0 = <&i2c3_pins>;
 };
 
+&i2c10 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c10_pins>;
+};
+
 &pio {
+	i2c10_pins: i2c10-pins {
+		pins {
+			pinmux = <PINMUX_GPIO101__FUNC_SCL10>,
+				 <PINMUX_GPIO102__FUNC_SDA10>;
+		};
+	};
+
 	i2c3_pins: i2c3-pins {
 		pins {
 			pinmux = <PINMUX_GPIO123__FUNC_SCL3>,
diff --git a/arch/arm64/boot/dts/mediatek/mt6991.dtsi b/arch/arm64/boot/dts/mediatek/mt6991.dtsi
index 1c04445..8eae2a2 100644
--- a/arch/arm64/boot/dts/mediatek/mt6991.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6991.dtsi
@@ -176,6 +176,20 @@ i2c3: i2c@13150000 {
 			status = "disabled";
 		};
 
+		i2c10: i2c@13190000 {
+			compatible = "mediatek,mt6991-i2c", "mediatek,mt8188-i2c";
+			reg = <0 0x13190000 0 0x20000>,
+			      <0 0x164b0000 0 0x10000>;
+			interrupts = <GIC_SPI 344 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&impw CLK_IMPW_I2C10>,
+				 <&pericfg MT6991_CLK_PERI_AP_DMA_X32W_BCLK>;
+			clock-names = "main", "dma";
+			clock-div = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "disabled";
+		};
+
 		impw: clock-controller@131b0000 {
 			compatible = "mediatek,mt6991-imp-iic-wrap-w",
 				     "mediatek,mt8196-imp-iic-wrap-w", "syscon";
-- 
2.50.1 (Apple Git-155)

