+static bool read_power_mode;
+module_param(read_power_mode, bool, 0444);
+MODULE_PARM_DESC(read_power_mode, "Read and log the DCS power mode after panel initialization");
+
+struct turner_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct gpio_desc *reset;
+	struct regulator *vddi, *bias;
+	struct backlight_device *backlight;
+	bool vddi_on, bias_on;
+};
+
+static struct turner_panel *to_turner(struct drm_panel *panel)
+{
+	return container_of(panel, struct turner_panel, panel);
+}
+
+static int turner_power_down(struct turner_panel *ctx)
+{
+	int ret;
+
+	if (ctx->bias_on) {
+		ret = regulator_disable(ctx->bias);
+		if (ret)
+			return ret;
+		ctx->bias_on = false;
+		msleep(60);
+	}
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	if (ctx->vddi_on) {
+		ret = regulator_disable(ctx->vddi);
+		if (ret)
+			return ret;
+		ctx->vddi_on = false;
+	}
+	return 0;
+}
+
+static void turner_enter_sleep(struct turner_panel *ctx)
+{
+	int ret = turner_panel_suspend(ctx->dsi);
+
+	if (ret)
+		dev_warn(ctx->panel.dev, "sleep command failed: %d\n", ret);
+	msleep(100);
+}
+
+static int turner_prepare(struct drm_panel *panel)
+{
+	struct turner_panel *ctx = to_turner(panel);
+	int ret;
+
+	/* Retry any incomplete shutdown before starting a new power cycle. */
+	if (ctx->vddi_on || ctx->bias_on) {
+		ret = turner_power_down(ctx);
+		if (ret)
+			return ret;
+	}
+	ret = gpiod_direction_output(ctx->reset, 1);
+	if (ret)
+		return ret;
+	ret = regulator_set_voltage(ctx->vddi, 1900000, 1900000);
+	if (ret)
+		return ret;
+	ret = regulator_enable(ctx->vddi);
+	if (ret)
+		return ret;
+	ctx->vddi_on = true;
+	usleep_range(11000, 11020);
+	usleep_range(1200, 1220);
+	ret = regulator_enable(ctx->bias);
+	if (ret)
+		goto power_down;
+	ctx->bias_on = true;
+
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(5000, 5020);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	usleep_range(1000, 1020);
+	gpiod_set_value_cansleep(ctx->reset, 1);
+	usleep_range(1000, 1020);
+	gpiod_set_value_cansleep(ctx->reset, 0);
+	usleep_range(10000, 10020);
+	ret = turner_panel_init(ctx->dsi);
+	if (!ret && read_power_mode) {
+		u8 mode;
+
+		ret = mipi_dsi_dcs_get_power_mode(ctx->dsi, &mode);
+		if (ret) {
+			dev_err(panel->dev, "DCS power-mode read failed: %d\n", ret);
+			turner_enter_sleep(ctx);
+		} else {
+			dev_info(panel->dev, "DCS power mode 0x%02x\n", mode);
+		}
+	}
+	if (!ret)
+		return 0;
+power_down:
+	if (turner_power_down(ctx))
+		dev_err(panel->dev, "failed to unwind panel supplies\n");
+	return ret;
+}
+
+static int turner_unprepare(struct drm_panel *panel)
+{
+	struct turner_panel *ctx = to_turner(panel);
+
+	if (ctx->bias_on)
+		turner_enter_sleep(ctx);
+	return turner_power_down(ctx);
+}
+
+static int turner_enable(struct drm_panel *panel)
+{
+	return backlight_enable(to_turner(panel)->backlight);
+}
+
+static int turner_disable(struct drm_panel *panel)
+{
+	return backlight_disable(to_turner(panel)->backlight);
+}
+
+static int turner_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	/* The other rates require host link changes and panel peak-mode commands. */
+	mode = drm_mode_duplicate(connector->dev, &turner_modes[0]);
+	if (!mode)
+		return -ENOMEM;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
+
+static const struct drm_panel_funcs turner_panel_funcs = {
+	.prepare = turner_prepare,
+	.enable = turner_enable,
+	.disable = turner_disable,
+	.unprepare = turner_unprepare,
+	.get_modes = turner_get_modes,
+};
+
+static int turner_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct turner_panel *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct turner_panel, panel, &turner_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+	ctx->dsi = dsi;
+	ctx->reset = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(ctx->reset))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset), "reset GPIO\n");
+	/* Require real providers. Bias enable/disable must sequence both KTZ outputs. */
+	ctx->bias = devm_regulator_get_optional(dev, "bias");
+	if (IS_ERR(ctx->bias))
+		return dev_err_probe(dev, PTR_ERR(ctx->bias), "panel bias supply\n");
+	ctx->vddi = devm_regulator_get_optional(dev, "vddi");
+	if (IS_ERR(ctx->vddi))
+		return dev_err_probe(dev, PTR_ERR(ctx->vddi), "VCN18IO supply\n");
+	ctx->backlight = devm_of_find_backlight(dev);
+	if (IS_ERR(ctx->backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->backlight), "panel backlight\n");
+
+	if (dev->of_node && !ctx->backlight)
+		return dev_err_probe(dev, -ENODEV, "missing backlight\n");
+
+	ctx->dsc = turner_dsc;
+	dsi->dsc = &ctx->dsc;
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE;
+	ctx->panel.prepare_prev_first = true;
+	mipi_dsi_set_drvdata(dsi, &ctx->panel);
+	drm_panel_add(&ctx->panel);
+	ret = mipi_dsi_attach(dsi);
+	if (ret) {
+		drm_panel_remove(&ctx->panel);
+		dsi->dsc = NULL;
+	}
+	return ret;
+}
+
+static void turner_shutdown(struct mipi_dsi_device *dsi)
+{
+	struct turner_panel *ctx = to_turner(mipi_dsi_get_drvdata(dsi));
+
+	if (ctx->panel.enabled)
+		drm_panel_disable(&ctx->panel);
+	if (ctx->panel.prepared)
+		drm_panel_unprepare(&ctx->panel);
+	if (ctx->bias_on || ctx->vddi_on)
+		turner_power_down(ctx);
+}
+
+static void turner_remove(struct mipi_dsi_device *dsi)
+{
+	struct turner_panel *ctx = to_turner(mipi_dsi_get_drvdata(dsi));
+
+	drm_panel_remove(&ctx->panel);
+	turner_shutdown(dsi);
+	mipi_dsi_detach(dsi);
+	dsi->dsc = NULL;
+}
+
+static const struct of_device_id turner_match[] = {
+	{ .compatible = "xiaomi,turner-csot-o88" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, turner_match);
+
+static struct mipi_dsi_driver turner_driver = {
+	.probe = turner_probe,
+	.remove = turner_remove,
+	.shutdown = turner_shutdown,
+	.driver = { .name = "turner-csot-panel", .of_match_table = turner_match },
+};
+module_mipi_dsi_driver(turner_driver);
+MODULE_DESCRIPTION("Redmi K Pad CSOT O88 DSI panel");
+MODULE_LICENSE("GPL");
