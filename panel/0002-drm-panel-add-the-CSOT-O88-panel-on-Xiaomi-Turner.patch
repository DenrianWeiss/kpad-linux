Subject: [RFC PATCH 2/2] drm/panel: add the CSOT O88 panel on Xiaomi Turner

---
 drivers/gpu/drm/panel/Kconfig             |   8 +
 drivers/gpu/drm/panel/Makefile            |   1 +
 drivers/gpu/drm/panel/panel-turner-csot.c | 544 ++++++++++++++++++++++
 3 files changed, 553 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-turner-csot.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index cbdf7b8..a70272a 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1406,6 +1406,14 @@ config DRM_PANEL_WIDECHIPS_WS2401
 	  480x800 display controller used in panels such as Samsung LMS380KF01.
 	  This display is used in the Samsung Galaxy Ace 2 GT-I8160 (Codina).
 
+config DRM_PANEL_XIAOMI_TURNER_CSOT
+	tristate "Xiaomi Redmi K Pad CSOT O88 DSI panel"
+	depends on OF && DRM_MIPI_DSI && GPIOLIB && REGULATOR
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Drive the CSOT O88 display on the Xiaomi Redmi K Pad using its
+	  preferred 60 Hz mode and normal cold-power sequence.
+
 config DRM_PANEL_XINPENG_XPP055C272
 	tristate "Xinpeng XPP055C272 panel driver"
 	depends on OF
