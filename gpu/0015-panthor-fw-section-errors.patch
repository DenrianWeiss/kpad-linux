From: Turner Linux Port <turner@localhost>
Subject: [RFC PATCH] drm/panthor: propagate firmware section mapping errors

A non-shared section needs a temporary CPU mapping to initialise its
contents. If that mapping fails, the loader currently proceeds to start
the MCU, which can turn the original error into a firmware boot timeout.
Propagate the mapping error on initial load and on full reload.

---
diff --git a/drivers/gpu/drm/panthor/panthor_fw.c b/drivers/gpu/drm/panthor/panthor_fw.c
--- a/drivers/gpu/drm/panthor/panthor_fw.c
+++ b/drivers/gpu/drm/panthor/panthor_fw.c
@@ -445,19 +445,18 @@
 	return 0;
 }
 
-static void panthor_fw_init_section_mem(struct panthor_device *ptdev,
-					struct panthor_fw_section *section)
+static int panthor_fw_init_section_mem(struct panthor_fw_section *section)
 {
 	bool was_mapped = !!section->mem->kmap;
 	int ret;
 
 	if (!section->data.size &&
 	    !(section->flags & CSF_FW_BINARY_IFACE_ENTRY_ZERO))
-		return;
+		return 0;
 
 	ret = panthor_kernel_bo_vmap(section->mem);
-	if (drm_WARN_ON(&ptdev->base, ret))
-		return;
+	if (ret)
+		return ret;
 
 	memcpy(section->mem->kmap, section->data.buf, section->data.size);
 	if (section->flags & CSF_FW_BINARY_IFACE_ENTRY_ZERO) {
@@ -467,6 +466,8 @@
 
 	if (!was_mapped)
 		panthor_kernel_bo_vunmap(section->mem);
+
+	return 0;
 }
 
 /**
@@ -675,7 +676,9 @@
 				return ret;
 		}
 
-		panthor_fw_init_section_mem(ptdev, section);
+		ret = panthor_fw_init_section_mem(section);
+		if (ret)
+			return ret;
 
 		bo = to_panthor_bo(section->mem->obj);
 
@@ -732,24 +735,29 @@
 	return 0;
 }
 
-static void
+static int
 panthor_reload_fw_sections(struct panthor_device *ptdev, bool full_reload)
 {
 	struct panthor_fw_section *section;
 
 	list_for_each_entry(section, &ptdev->fw->sections, node) {
 		struct sg_table *sgt;
+		int ret;
 
 		if (!full_reload && !(section->flags & CSF_FW_BINARY_IFACE_ENTRY_WR))
 			continue;
 
-		panthor_fw_init_section_mem(ptdev, section);
+		ret = panthor_fw_init_section_mem(section);
+		if (ret)
+			return ret;
 
 		/* An sgt should have been requested when the kernel BO was GPU-mapped. */
 		sgt = to_panthor_bo(section->mem->obj)->dmap.sgt;
 		if (!drm_WARN_ON_ONCE(&ptdev->base, !sgt))
 			dma_sync_sgtable_for_device(ptdev->base.dev, sgt, DMA_TO_DEVICE);
 	}
+
+	return 0;
 }
 
 static int panthor_fw_load_entry(struct panthor_device *ptdev,
@@ -1266,7 +1274,9 @@
 		 * We're not supposed to end up here anyway, let's just assume
 		 * the overhead of reloading everything is acceptable.
 		 */
-		panthor_reload_fw_sections(ptdev, true);
+		ret = panthor_reload_fw_sections(ptdev, true);
+		if (ret)
+			return ret;
 	} else {
 		/*
 		 * If the FW was previously successfully halted in the pre-reset
