+/* MT6985-compatible ports expose separate divisor registers in feature mode. */
+#define MTK_UART_DIVISOR_LOW    0x24
+#define MTK_UART_DIVISOR_HIGH   0x25
+#define MTK_UART_FEATURE_SEL    0x27
+
+static u32 mtk8250_hub_dl_read(struct uart_8250_port *up)
+{
+	u32 value;
+
+	serial_out(up, MTK_UART_FEATURE_SEL, 1);
+	value = serial_in(up, MTK_UART_DIVISOR_LOW) & 0xff;
+	value |= (serial_in(up, MTK_UART_DIVISOR_HIGH) & 0xff) << 8;
+	serial_out(up, MTK_UART_FEATURE_SEL, 0);
+
+	return value;
+}
+
+static void mtk8250_hub_dl_write(struct uart_8250_port *up, u32 value)
+{
+	serial_out(up, MTK_UART_FEATURE_SEL, 1);
+	serial_out(up, MTK_UART_DIVISOR_LOW, value & 0xff);
+	serial_out(up, MTK_UART_DIVISOR_HIGH, (value >> 8) & 0xff);
+	serial_out(up, MTK_UART_FEATURE_SEL, 0);
+}
+
