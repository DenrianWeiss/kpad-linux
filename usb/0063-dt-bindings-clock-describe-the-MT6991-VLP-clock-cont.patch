@@ -29,6 +29,7 @@ properties:
       - enum:
           - mediatek,mt6991-apmixedsys
           - mediatek,mt6991-topckgen
+          - mediatek,mt6991-vlpckgen
           - mediatek,mt8196-apmixedsys
           - mediatek,mt8196-armpll-b-pll-ctrl
           - mediatek,mt8196-armpll-bl-pll-ctrl
diff --git a/include/dt-bindings/clock/mediatek,mt6991-clock.h b/include/dt-bindings/clock/mediatek,mt6991-clock.h
index 1ae79c7..a511871 100644
--- a/include/dt-bindings/clock/mediatek,mt6991-clock.h
+++ b/include/dt-bindings/clock/mediatek,mt6991-clock.h
@@ -42,6 +42,11 @@
 #define MT6991_CLK_TOP_USB_XHCI_1P            32
 #define MT6991_CLK_TOP_USB_FMCNT_P1           33
 
+#define MT6991_CLK_TOP_MAINPLL_D9            34
+
+#define MT6991_CLK_VLP_USB_TOP                0
+#define MT6991_CLK_VLP_USB_XHCI               1
+
 #define MT6991_CLK_PERI_UART0_BCLK         0
 #define MT6991_CLK_PERI_SPI6_BCLK          1
 
