From 4a6798f16c94a85baa7b41dc8caee0ece13e8447 Mon Sep 17 00:00:00 2001
From: Turner Linux Port <turner@localhost>
Date: Sun, 22 Nov 2026 07:18:23 +0800
Subject: [PATCH 67/68] usb: mtu3: program both MT6991 port 0 IP sleep enable
 bits

---
 drivers/usb/mtu3/mtu3_host.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/usb/mtu3/mtu3_host.c b/drivers/usb/mtu3/mtu3_host.c
index 8138b3f..be33175 100644
--- a/drivers/usb/mtu3/mtu3_host.c
+++ b/drivers/usb/mtu3/mtu3_host.c
@@ -54,6 +54,9 @@
 #define PERI_WK_CTRL1_8196	0x10
 #define WC1_IS_EN_P2_96		BIT(0)
 
+/* mt6991 */
+#define WC0_IS_EN_P0_91		(BIT(2) | BIT(0))
+
 /* mt2712 etc */
 #define PERI_SSUSB_SPM_CTRL	0x0
 #define SSC_IP_SLEEP_EN	BIT(4)
@@ -70,6 +73,7 @@ enum ssusb_uwk_vers {
 	SSUSB_UWK_V1_7, 	/* mt8196 IP0 */
 	SSUSB_UWK_V1_8, 	/* mt8196 IP1 */
 	SSUSB_UWK_V1_9, 	/* mt8196 IP2 */
+	SSUSB_UWK_V1_10,	/* mt6991 IP0 */
 };
 
 /*
@@ -126,6 +130,11 @@ static void ssusb_wakeup_ip_sleep_set(struct ssusb_mtk *ssusb, bool enable)
 		msk = WC1_IS_EN_P2_96;
 		val = enable ? msk : 0;
 		break;
+	case SSUSB_UWK_V1_10:
+		reg = ssusb->uwk_reg_base + PERI_WK_CTRL0_8196;
+		msk = WC0_IS_EN_P0_91;
+		val = enable ? msk : 0;
+		break;
 	case SSUSB_UWK_V2:
 		reg = ssusb->uwk_reg_base + PERI_SSUSB_SPM_CTRL;
 		msk = SSC_IP_SLEEP_EN | SSC_SPM_INT_EN;
-- 
