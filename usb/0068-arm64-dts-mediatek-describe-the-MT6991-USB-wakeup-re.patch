From 1e6cd306a675c1e1d2a2af2322c50a19b5719351 Mon Sep 17 00:00:00 2001
From: Turner Linux Port <turner@localhost>
Date: Sun, 22 Nov 2026 07:18:24 +0800
Subject: [PATCH 68/68] arm64: dts: mediatek: describe the MT6991 USB wakeup
 registers

---
 arch/arm64/boot/dts/mediatek/mt6991.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6991.dtsi b/arch/arm64/boot/dts/mediatek/mt6991.dtsi
index 7f62809..76fbc59 100644
--- a/arch/arm64/boot/dts/mediatek/mt6991.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6991.dtsi
@@ -368,6 +368,11 @@ power-domain@a {
 			};
 		};
 
+		usb_wakeup: syscon@167a0000 {
+			compatible = "mediatek,mt6991-usb-wakeup", "syscon";
+			reg = <0 0x167a0000 0 0x1000>;
+		};
+
 		spm_bus_prot: syscon@1c00d000 {
 			compatible = "mediatek,mt6991-spm-bus-protection", "syscon";
 			reg = <0 0x1c00d000 0 0x1000>;
-- 
