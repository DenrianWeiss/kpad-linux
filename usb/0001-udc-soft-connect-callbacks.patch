From: Turner Linux Port <turner@localhost>
Subject: [RFC PATCH] usb: gadget: udc: resume callbacks on soft reconnect

A UDC may quiesce setup callbacks in its stop operation. For example,
dummy_udc_stop() clears ints_enabled. Starting the controller again via
soft_connect leaves it unable to answer GET_DESCRIPTOR, although a full
gadget unbind and rebind works.

Enable asynchronous callbacks after a successful restart and before the
pullup, as during initial bind. Keep an already started controller
running and propagate start and pullup errors to the sysfs writer.

---
diff --git a/drivers/usb/gadget/udc/core.c b/drivers/usb/gadget/udc/core.c
--- a/drivers/usb/gadget/udc/core.c
+++ b/drivers/usb/gadget/udc/core.c
@@ -1804,7 +1804,7 @@
 		struct device_attribute *attr, const char *buf, size_t n)
 {
 	struct usb_udc		*udc = container_of(dev, struct usb_udc, dev);
-	ssize_t			ret;
+	ssize_t			ret = 0;
 
 	device_lock(&udc->gadget->dev);
 	if (!udc->driver) {
@@ -1815,8 +1815,13 @@
 
 	if (sysfs_streq(buf, "connect")) {
 		mutex_lock(&udc->connect_lock);
-		usb_gadget_udc_start_locked(udc);
-		usb_gadget_connect_locked(udc->gadget);
+		if (!udc->started) {
+			ret = usb_gadget_udc_start_locked(udc);
+			if (!ret)
+				usb_gadget_enable_async_callbacks(udc);
+		}
+		if (!ret)
+			ret = usb_gadget_connect_locked(udc->gadget);
 		mutex_unlock(&udc->connect_lock);
 	} else if (sysfs_streq(buf, "disconnect")) {
 		mutex_lock(&udc->connect_lock);
@@ -1829,7 +1834,8 @@
 		goto out;
 	}
 
-	ret = n;
+	if (!ret)
+		ret = n;
 out:
 	device_unlock(&udc->gadget->dev);
 	return ret;
