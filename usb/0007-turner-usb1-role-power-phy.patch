+static const struct regmap_config i2c_map = {
+	.reg_bits = 8,
+	.val_bits = 8,
+};
+
+static int sc2150_init(struct regmap *m)
+{
+	static const struct reg_sequence setup[] = {
+		{ 0x9e, 0x80 }, { TCPC_ROLE_CTRL, 0x0a }, { TCPC_COMMAND, 0x33 },
+		{ 0xa2, 0x04 }, { 0xa3, 0x34 }, { 0xa4, 0x01 },
+	};
+	static const u8 key[] = { 0x4c, 0x49, 0x54, 0x54, 0x4c, 0x45 };
+	unsigned int val, i;
+	int ret, lock;
+
+	ret = regmap_multi_reg_write(m, setup, ARRAY_SIZE(setup));
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(key); i++) {
+		ret = regmap_write(m, 0xff, key[i]);
+		if (ret)
+			break;
+	}
+	if (!ret)
+		ret = regmap_write(m, 0xe7, 0x4e);
+	if (!ret)
+		ret = regmap_read(m, 0xe7, &val);
+	if (!ret && val != 0x4e)
+		ret = -EIO;
+	lock = regmap_write(m, 0xff, 0);
+	if (ret || lock)
+		return ret ?: lock;
+	return regmap_write(m, 0x9b, 0x20);
+}
+
+static int turner_chip_probe(struct i2c_client *client)
+{
+	struct regmap *m;
+	__le16 ids[2];
+	unsigned int id;
+	int ret;
+
+	m = devm_regmap_init_i2c(client, &i2c_map);
+	if (IS_ERR(m))
+		return PTR_ERR(m);
+	if (of_device_is_compatible(client->dev.of_node, "southchip,sc2150")) {
+		ret = regmap_bulk_read(m, 0, ids, sizeof(ids));
+		if (ret)
+			return ret;
+		if (le16_to_cpu(ids[0]) != 0x311c || le16_to_cpu(ids[1]) != 0x2150)
+			return -ENODEV;
+		return sc2150_init(m);
+	}
+	ret = regmap_read(m, 0x22, &id);
+	return ret ?: (id == 0x41 ? 0 : -ENODEV);
+}
+
+static const struct of_device_id chip_match[] = {
+	{ .compatible = "xiaomi,turner-sc2150" }, { .compatible = "xiaomi,turner-sc8541" }, {}
+};
+MODULE_DEVICE_TABLE(of, chip_match);
+static struct i2c_driver turner_chips = {
+	.driver = { .name = "turner-usb-power", .of_match_table = chip_match },
+	.probe = turner_chip_probe,
+};
+
+static struct regmap *chip_map(struct device *dev, const char *prop, const char *compat)
+{
+	struct device_node *node = of_parse_phandle(dev->of_node, prop, 0);
+	struct device_node *child;
+	struct i2c_client *chip;
+	struct regmap *map = ERR_PTR(-EPROBE_DEFER);
+
+	if (!node)
+		return ERR_PTR(-EINVAL);
+	child = of_get_compatible_child(node, compat);
+	of_node_put(node);
+	if (!child)
+		return ERR_PTR(-EINVAL);
+	chip = of_find_i2c_device_by_node(child);
+	of_node_put(child);
+	if (!chip)
+		return map;
+	device_lock(&chip->dev);
+	if (chip->dev.driver == &turner_chips.driver &&
+	    device_link_add(dev, &chip->dev, DL_FLAG_AUTOREMOVE_CONSUMER))
+		map = dev_get_regmap(&chip->dev, NULL);
+	device_unlock(&chip->dev);
+	put_device(&chip->dev);
+	return map;
+}
+
+static void put_role(void *role)
+{
+	usb_role_switch_put(role);
+}
