From 5455affd99d5cf6735875b13a77f3d2a14e4ce70 Mon Sep 17 00:00:00 2001
From: Turner Linux Port <turner@localhost>
Date: Sun, 22 Nov 2026 07:22:31 +0800
Subject: [PATCH 71/71] arm64: dts: mediatek: add the MT6991 USB reset provider

---
 arch/arm64/boot/dts/mediatek/mt6991.dtsi | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt6991.dtsi b/arch/arm64/boot/dts/mediatek/mt6991.dtsi
index 76fbc59..8f1a617 100644
--- a/arch/arm64/boot/dts/mediatek/mt6991.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6991.dtsi
@@ -264,6 +264,12 @@ pericfg: clock-controller@16640000 {
 			#clock-cells = <1>;
 		};
 
+		usb_cfg: syscon@16790000 {
+			compatible = "mediatek,mt6991-usbcfg", "syscon";
+			reg = <0 0x16790000 0 0x100>;
+			#reset-cells = <1>;
+		};
+
 		pciephy0: phy@16900000 {
 			compatible = "mediatek,mt6991-pcie-phy";
 			reg = <0 0x16900000 0 0x10000>, <0 0x16920000 0 0x10000>;
-- 
