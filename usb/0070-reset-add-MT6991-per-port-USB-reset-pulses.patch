From 4eaf0782542f125eb0c24713164159ebb5ad15c7 Mon Sep 17 00:00:00 2001
From: Turner Linux Port <turner@localhost>
Date: Sun, 22 Nov 2026 07:22:31 +0800
Subject: [PATCH 70/71] reset: add MT6991 per-port USB reset pulses

---
 drivers/reset/Kconfig            |  7 +++
 drivers/reset/Makefile           |  1 +
 drivers/reset/reset-mt6991-usb.c | 78 ++++++++++++++++++++++++++++++++
 3 files changed, 86 insertions(+)
 create mode 100644 drivers/reset/reset-mt6991-usb.c

diff --git a/drivers/reset/Kconfig b/drivers/reset/Kconfig
index 3168ab1..6f7fe9c 100644
--- a/drivers/reset/Kconfig
+++ b/drivers/reset/Kconfig
@@ -198,6 +198,13 @@ config RESET_MCHP_SPARX5
 	help
 	  This driver supports switch core reset for the Microchip Sparx5 SoC.
 
+config RESET_MT6991_USB
+	tristate "MediaTek MT6991 USB reset controller"
+	depends on (ARCH_MEDIATEK || COMPILE_TEST) && OF
+	select MFD_SYSCON
+	help
+	  Enable reset support for the USB controllers on MediaTek MT6991.
+
 config RESET_NPCM
 	bool "NPCM BMC Reset Driver" if COMPILE_TEST
 	default ARCH_NPCM
diff --git a/drivers/reset/Makefile b/drivers/reset/Makefile
index 45ad170..60167e2 100644
--- a/drivers/reset/Makefile
+++ b/drivers/reset/Makefile
@@ -28,6 +28,7 @@ obj-$(CONFIG_RESET_K230) += reset-k230.o
 obj-$(CONFIG_RESET_LANTIQ) += reset-lantiq.o
 obj-$(CONFIG_RESET_LPC18XX) += reset-lpc18xx.o
 obj-$(CONFIG_RESET_MCHP_SPARX5) += reset-microchip-sparx5.o
+obj-$(CONFIG_RESET_MT6991_USB) += reset-mt6991-usb.o
 obj-$(CONFIG_RESET_NPCM) += reset-npcm.o
 obj-$(CONFIG_RESET_NUVOTON_MA35D1) += reset-ma35d1.o
 obj-$(CONFIG_RESET_PISTACHIO) += reset-pistachio.o
diff --git a/drivers/reset/reset-mt6991-usb.c b/drivers/reset/reset-mt6991-usb.c
new file mode 100644
index 0000000..234082c
--- /dev/null
+++ b/drivers/reset/reset-mt6991-usb.c
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/delay.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/reset-controller.h>
+#include <linux/slab.h>
+
+struct mt6991_usb_reset {
+	struct reset_controller_dev rcdev;
+	struct regmap *map;
+};
+
+static const unsigned int port_masks[] = {
+	BIT(0) | BIT(1) | BIT(4),
+	BIT(8) | BIT(9),
+	BIT(16) | BIT(20) | BIT(21),
+};
+
+static int mt6991_usb_reset_pulse(struct reset_controller_dev *rcdev,
+				  unsigned long id)
+{
+	struct mt6991_usb_reset *rst = container_of(rcdev, struct mt6991_usb_reset, rcdev);
+	unsigned int mask = port_masks[id];
+	int ret;
+
+	ret = regmap_set_bits(rst->map, 0, mask);
+	if (ret)
+		return ret;
+
+	usleep_range(1000, 1100);
+	return regmap_clear_bits(rst->map, 0, mask);
+}
+
+static const struct reset_control_ops mt6991_usb_reset_ops = {
+	.reset = mt6991_usb_reset_pulse,
+};
+
+static int mt6991_usb_reset_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mt6991_usb_reset *rst;
+
+	rst = devm_kzalloc(dev, sizeof(*rst), GFP_KERNEL);
+	if (!rst)
+		return -ENOMEM;
+
+	rst->map = syscon_node_to_regmap(dev->of_node);
+	if (IS_ERR(rst->map))
+		return dev_err_probe(dev, PTR_ERR(rst->map), "cannot map USB configuration registers\n");
+
+	rst->rcdev.owner = THIS_MODULE;
+	rst->rcdev.ops = &mt6991_usb_reset_ops;
+	rst->rcdev.of_node = dev->of_node;
+	rst->rcdev.nr_resets = ARRAY_SIZE(port_masks);
+	rst->rcdev.dev = dev;
+	return devm_reset_controller_register(dev, &rst->rcdev);
+}
+
+static const struct of_device_id mt6991_usb_reset_ids[] = {
+	{ .compatible = "mediatek,mt6991-usbcfg" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mt6991_usb_reset_ids);
+
+static struct platform_driver mt6991_usb_reset_driver = {
+	.probe = mt6991_usb_reset_probe,
+	.driver = {
+		.name = "mt6991-usb-reset",
+		.of_match_table = mt6991_usb_reset_ids,
+	},
+};
+module_platform_driver(mt6991_usb_reset_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6991 USB reset controller");
+MODULE_LICENSE("GPL");
