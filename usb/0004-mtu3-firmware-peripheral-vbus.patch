Subject: usb: mtu3: honor firmware-requested VBUS in peripheral mode

--- a/drivers/usb/mtu3/mtu3_core.c
+++ b/drivers/usb/mtu3/mtu3_core.c
@@ -350,6 +350,24 @@
 		usb_speed_string(mtu->speed), is_on ? "+" : "-");
 }
 
+/* MT6991 reports connector VBUS outside the MAC. In fixed peripheral
+ * mode the firmware requests a software session while the gadget runs.
+ * This controls the MAC input only, not the connector's VBUS supply.
+ */
+static void mtu3_set_peripheral_session(struct mtu3 *mtu, bool active)
+{
+	if (mtu->ssusb->dr_mode != USB_DR_MODE_PERIPHERAL ||
+	    !of_property_read_bool(mtu->dev->of_node, "mediatek,force-vbus"))
+		return;
+
+	if (active) {
+		mtu3_clrbits(mtu->ippc_base, SSUSB_U2_CTRL(0), SSUSB_U2_PORT_OTG_SEL);
+		mtu3_setbits(mtu->mac_base, U3D_MISC_CTRL, VBUS_FRC_EN | VBUS_ON);
+	} else {
+		mtu3_clrbits(mtu->mac_base, U3D_MISC_CTRL, VBUS_FRC_EN | VBUS_ON);
+	}
+}
+
 void mtu3_start(struct mtu3 *mtu)
 {
 	void __iomem *mbase = mtu->mac_base;
@@ -360,6 +378,7 @@
 	mtu3_dev_power_on(mtu);
 	mtu3_csr_init(mtu);
 	mtu3_set_speed(mtu, mtu->speed);
+	mtu3_set_peripheral_session(mtu, true);
 
 	/* Initialize the default interrupts */
 	mtu3_intr_enable(mtu);
@@ -378,6 +397,7 @@
 	if (mtu->softconnect)
 		mtu3_dev_on_off(mtu, 0);
 
+	mtu3_set_peripheral_session(mtu, false);
 	mtu->is_active = 0;
 	mtu3_dev_power_down(mtu);
 }
