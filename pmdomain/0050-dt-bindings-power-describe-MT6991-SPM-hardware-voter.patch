From adf714501499ac2acab7e10052f2ecf18c96a09b Mon Sep 17 00:00:00 2001
From: Turner Linux Port <turner@localhost>
Date: Sun, 22 Nov 2026 05:59:42 +0800
Subject: [PATCH] dt-bindings: power: describe MT6991 SPM hardware voter

---
 .../bindings/mfd/mediatek,mt6991-hwv.yaml     | 44 +++++++++++++++++++
 .../devicetree/bindings/mfd/syscon.yaml       |  1 -
 .../power/mediatek,power-controller.yaml      |  1 +
 .../dt-bindings/power/mediatek,mt6991-power.h |  4 ++
 4 files changed, 49 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/mfd/mediatek,mt6991-hwv.yaml

diff --git a/Documentation/devicetree/bindings/mfd/mediatek,mt6991-hwv.yaml b/Documentation/devicetree/bindings/mfd/mediatek,mt6991-hwv.yaml
new file mode 100644
index 0000000..7d1cc3c
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/mediatek,mt6991-hwv.yaml
@@ -0,0 +1,44 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/mediatek,mt6991-hwv.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6991 hardware voter
+
+maintainers:
+  - Turner Linux Port <turner@localhost>
+
+description:
+  The hardware voter provides shared registers for clock and power votes.
+
+properties:
+  compatible:
+    minItems: 2
+    items:
+      - const: mediatek,mt6991-hwv
+      - const: syscon
+      - const: simple-mfd
+
+  reg:
+    maxItems: 1
+
+  power-controller:
+    $ref: /schemas/power/mediatek,power-controller.yaml#
+    properties:
+      compatible:
+        const: mediatek,mt6991-hwv-scp-power-controller
+
+required:
+  - compatible
+  - reg
+
+if:
+  required:
+    - power-controller
+then:
+  properties:
+    compatible:
+      minItems: 3
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/mfd/syscon.yaml b/Documentation/devicetree/bindings/mfd/syscon.yaml
index b5ae8e2..606b287 100644
--- a/Documentation/devicetree/bindings/mfd/syscon.yaml
+++ b/Documentation/devicetree/bindings/mfd/syscon.yaml
@@ -85,7 +85,6 @@ properties:
               - mediatek,mt2701-pctl-a-syscfg
               - mediatek,mt2712-pctl-a-syscfg
               - mediatek,mt6397-pctl-pmic-syscfg
-              - mediatek,mt6991-hwv
               - mediatek,mt6991-spm-bus-protection
               - mediatek,mt7981-topmisc
               - mediatek,mt7988-topmisc
diff --git a/Documentation/devicetree/bindings/power/mediatek,power-controller.yaml b/Documentation/devicetree/bindings/power/mediatek,power-controller.yaml
index 6483c3f..275ca8e 100644
--- a/Documentation/devicetree/bindings/power/mediatek,power-controller.yaml
+++ b/Documentation/devicetree/bindings/power/mediatek,power-controller.yaml
@@ -27,6 +27,7 @@ properties:
       - mediatek,mt6795-power-controller
       - mediatek,mt6858-power-controller
       - mediatek,mt6893-power-controller
+      - mediatek,mt6991-hwv-scp-power-controller
       - mediatek,mt6991-power-controller
       - mediatek,mt8167-power-controller
       - mediatek,mt8173-power-controller
diff --git a/include/dt-bindings/power/mediatek,mt6991-power.h b/include/dt-bindings/power/mediatek,mt6991-power.h
index ce91a15..f41d445 100644
--- a/include/dt-bindings/power/mediatek,mt6991-power.h
+++ b/include/dt-bindings/power/mediatek,mt6991-power.h
@@ -8,4 +8,8 @@
 #define MT6991_POWER_DOMAIN_PEXTP_MAC0		7
 #define MT6991_POWER_DOMAIN_PEXTP_PHY0		10
 
+/* Secure Power Manager hardware voter */
+#define MT6991_POWER_DOMAIN_MM_PROC_DORMANT	0
+#define MT6991_POWER_DOMAIN_SSR			1
+
 #endif
-- 
