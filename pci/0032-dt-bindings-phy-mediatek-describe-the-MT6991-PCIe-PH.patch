From 89b7bb107782862bb323193c1648e6a883836dad Mon Sep 17 00:00:00 2001
From: Turner Linux Port <turner@localhost>
Date: Sun, 22 Nov 2026 04:11:51 +0800
Subject: [PATCH] dt-bindings: phy: mediatek: describe the MT6991 PCIe PHY

---
 .../phy/mediatek,mt6991-pcie-phy.yaml         | 70 +++++++++++++++++++
 1 file changed, 70 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/mediatek,mt6991-pcie-phy.yaml

diff --git a/Documentation/devicetree/bindings/phy/mediatek,mt6991-pcie-phy.yaml b/Documentation/devicetree/bindings/phy/mediatek,mt6991-pcie-phy.yaml
new file mode 100644
index 0000000..4021207
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/mediatek,mt6991-pcie-phy.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/mediatek,mt6991-pcie-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6991 PCIe PHY
+
+maintainers:
+  - Turner Linux Port <turner@localhost>
+
+properties:
+  compatible:
+    const: mediatek,mt6991-pcie-phy
+
+  reg:
+    items:
+      - description: PHY system interface and lane registers
+      - description: PHY clock manager
+
+  reg-names:
+    items:
+      - const: sif
+      - const: ckm
+
+  clocks:
+    items:
+      - description: PCIe PHY reference clock
+      - description: PHY MCU bus clock
+
+  clock-names:
+    items:
+      - const: ref
+      - const: mcu
+
+  power-domains:
+    maxItems: 1
+
+  "#phy-cells":
+    const: 0
+
+  num-lanes:
+    enum: [1, 2]
+
+  nvmem-cells:
+    maxItems: 1
+
+  nvmem-cell-names:
+    items:
+      - const: calibration
+
+  mediatek,short-reach:
+    description: Use the PHY equalization settings for a short board trace.
+    type: boolean
+
+dependencies:
+  nvmem-cells: [nvmem-cell-names]
+  nvmem-cell-names: [nvmem-cells]
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - clocks
+  - clock-names
+  - num-lanes
+  - power-domains
+  - "#phy-cells"
+
+additionalProperties: false
-- 
2.50.1 (Apple Git-155)

